<%- include('../partials/head') %>
  </head>
  <body class="bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">
    <%- include('../partials/nav') %>

    <main class="mx-auto max-w-3xl px-6 py-10">
      <div class="rounded-3xl bg-white p-8 shadow-lg">
        <div class="border-b border-gray-200 pb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-red-500">Account Profile</p>
          <h1 class="mt-2 text-3xl font-black text-slate-900">Edit Profile</h1>
          <p class="mt-2 text-sm text-slate-500">Update your personal details here.</p>
        </div>

        <form action="/profile/edit" method="POST" class="mt-8">
          <% if (success) { %>
            <div class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
              <%= success %>
            </div>
          <% } %>
          <% if (error) { %>
            <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
              <%= error %>
            </div>
          <% } %>
          <%- include('../partials/errors') %>

          <div class="grid gap-5 md:grid-cols-2">
            <div>
              <label for="firstName" class="mb-1 block text-sm font-medium text-gray-700">First Name</label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                value="<%= oldInput.firstName %>"
                class="w-full rounded-md border px-4 py-3 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
                required
              />
            </div>

            <div>
              <label for="lastName" class="mb-1 block text-sm font-medium text-gray-700">Last Name</label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                value="<%= oldInput.lastName %>"
                class="w-full rounded-md border px-4 py-3 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
              />
            </div>

            <div class="md:col-span-2">
              <label for="email" class="mb-1 block text-sm font-medium text-gray-700">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= oldInput.email %>"
                class="w-full rounded-md border px-4 py-3 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
                required
              />
            </div>

            <div class="md:col-span-2">
              <label for="phoneNumber" class="mb-1 block text-sm font-medium text-gray-700">Phone Number</label>
              <input
                type="tel"
                id="phoneNumber"
                name="phoneNumber"
                value="<%= oldInput.phoneNumber %>"
                maxlength="10"
                class="w-full rounded-md border px-4 py-3 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
                required
              />
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700">
              Save Changes
            </button>
            <a href="/profile" class="inline-flex items-center justify-center rounded-2xl bg-slate-200 px-5 py-3 text-sm font-semibold text-slate-800 transition hover:bg-slate-300">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </main>
  </body>
</html>
