<header class="bg-gradient-to-r from-red-500 to-red-600 text-white p-4 shadow-lg sticky top-0 z-20">
  <nav class="container mx-auto flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center font-bold text-xl hover:scale-105 transition-transform">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-8 h-8 mr-2">
        <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z" />
        <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z" />
      </svg>
      Prajamart
    </a>

    <!-- Desktop Menu -->
    <ul class="hidden md:flex items-center gap-3 font-medium">
      <% if (isLoggedIn && user.userType === 'guest') { %>
        <li><a href="/products" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'Products' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Products</a></li>
        <li><a href="/cart" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'cart' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Cart</a></li>
        <li><a href="/bookings" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'bookings' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Bookings</a></li>
        <li><a href="/orders" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'orders' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Orders</a></li>
      <% } else if (isLoggedIn && user.userType === 'host') { %>
        <li><a href="/host/host-product-list" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'host-products' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Host Products</a></li>
        <li><a href="/host/add-product" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'addProduct' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Add Product</a></li>
        <li><a href="/host/orders" class="px-4 py-2 rounded-lg hover:bg-red-400 transition duration-300 <%= currentPage === 'host-orders' ? 'bg-white text-red-600 font-bold shadow-md' : '' %>">Orders Received</a></li>
      <% } %>
    </ul>

    <!-- Auth Buttons -->
    <div class="hidden md:flex items-center gap-2">
      <% if (!isLoggedIn) { %>
        <a href="/signup" class="px-4 py-2 rounded-lg border border-white hover:bg-white hover:text-red-600 transition duration-300">Sign Up</a>
        <a href="/login" class="px-4 py-2 rounded-lg bg-white text-red-600 font-semibold hover:bg-gray-100 transition duration-300">Login</a>
      <% } else { %>
        <form action="/logout" method="POST">
          <button type="submit" class="px-4 py-2 rounded-lg border border-white hover:bg-white hover:text-red-600 transition duration-300 font-medium">Logout</button>
        </form>
      <% } %>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-button" class="md:hidden p-2 rounded-lg hover:bg-red-400">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-2 bg-red-600 rounded-lg p-3 shadow-lg">
    <ul class="flex flex-col gap-2">
      <% if (isLoggedIn && user.userType === 'guest') { %>
        <li><a href="/products" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'Products' ? 'bg-white text-red-600 font-bold' : '' %>">Products</a></li>
        <li><a href="/cart" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'cart' ? 'bg-white text-red-600 font-bold' : '' %>">Cart</a></li>
        <li><a href="/bookings" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'bookings' ? 'bg-white text-red-600 font-bold' : '' %>">Bookings</a></li>
        <li><a href="/orders" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'orders' ? 'bg-white text-red-600 font-bold' : '' %>">Orders</a></li>
      <% } else if (isLoggedIn && user.userType === 'host') { %>
        <li><a href="/host/host-product-list" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'host-products' ? 'bg-white text-red-600 font-bold' : '' %>">Host Products</a></li>
        <li><a href="/host/add-product" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'addProduct' ? 'bg-white text-red-600 font-bold' : '' %>">Add Product</a></li>
        <li><a href="/host/orders" class="block px-4 py-2 rounded-lg hover:bg-red-500 <%= currentPage === 'host-orders' ? 'bg-white text-red-600 font-bold' : '' %>">Orders Received</a></li>
      <% } %>
      <% if (!isLoggedIn) { %>
        <li><a href="/signup" class="block px-4 py-2 rounded-lg border border-white hover:bg-white hover:text-red-600 transition">Sign Up</a></li>
        <li><a href="/login" class="block px-4 py-2 rounded-lg bg-white text-red-600 hover:bg-gray-100 transition">Login</a></li>
      <% } else { %>
        <li>
          <form action="/logout" method="POST">
            <button type="submit" class="w-full text-left px-4 py-2 rounded-lg border border-white hover:bg-white hover:text-red-600 transition">Logout</button>
          </form>
        </li>
      <% } %>
    </ul>
  </div>
</header>

<script>
  document.getElementById("mobile-menu-button")?.addEventListener("click", () => {
    document.getElementById("mobile-menu").classList.toggle("hidden");
  });
</script>
