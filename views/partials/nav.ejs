<%
  // 1. DATA SAFETY & LOGIC
  const current = typeof currentPage !== 'undefined' ? currentPage : '';
  const navSearchQuery = typeof searchQuery !== 'undefined' ? searchQuery : '';
  const isLoggedInSafe = typeof isLoggedIn !== 'undefined' ? isLoggedIn : false;
  const userSafe = typeof user !== 'undefined' ? user : null;

  const isGuest = isLoggedInSafe && userSafe && userSafe.userType === 'guest';
  const isHost = isLoggedInSafe && userSafe && userSafe.userType === 'host';
  const isDeliveryboy = isLoggedInSafe && userSafe && userSafe.userType === 'deliveryboy';

  const showSearch = !isLoggedInSafe || isGuest;
  const userCartCount = userSafe && Array.isArray(userSafe.cart) ? userSafe.cart.filter(Boolean).length : 0;

  const homeHref = !isLoggedInSafe ? '/' : isHost ? '/host/host-product-list' : isDeliveryboy ? '/delivery/orders' : '/';

  // Active Link Helper
  const activeLink = (name) => current === name ? 'text-indigo-600 border-b-2 border-indigo-600' : 'text-slate-600 hover:text-indigo-600';
%>

<style>
  /* Premium Glassmorphism */
  .nav-glass {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  /* Magnetic Logo Animation */
  @keyframes logo-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-4px) rotate(1deg); }
  }
  .logo-animate { animation: logo-float 4s ease-in-out infinite; }

  /* Search Bar Expansion */
  .search-input:focus {
    width: 300px !important;
    background: white !important;
    box-shadow: 0 10px 30px -10px rgba(79, 70, 229, 0.2);
  }

  /* Mobile Slide Down */
  #mobile-menu {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: top;
  }
</style>

<header class="sticky top-0 z-[100] nav-glass transition-all duration-300">
  <nav class="mx-auto flex max-w-[1440px] items-center gap-8 px-6 py-4 lg:px-12">

    <a href="<%= homeHref %>" class="flex shrink-0 items-center gap-4 group">
      <div class="logo-animate flex h-14 w-14 items-center justify-center rounded-[1.25rem] bg-slate-950 p-2.5 shadow-xl transition-all duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)] 
                  group-hover:bg-indigo-600 group-hover:scale-110 group-hover:rotate-6 group-hover:shadow-indigo-200">
        
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-full h-full fill-white transition-transform duration-500 group-hover:scale-110">
          <path d="M25,20 H60 a25,25 0 0,1 0,50 H45 V85 a5,5 0 0,1 -10,0 V25 A5,5 0 0,1 25,20 Z" />
          <rect x="35" y="38" width="30" height="7" rx="3.5" class="fill-white/80 group-hover:fill-white group-hover:animate-pulse transition-all duration-300" />
          <rect x="35" y="52" width="22" height="7" rx="3.5" class="fill-white/80 group-hover:fill-white transition-all duration-300" />
        </svg>
      </div>

      <div class="hidden sm:block">
        <h1 class="text-2xl font-[800] tracking-tighter text-slate-950 leading-none group-hover:text-indigo-600 transition-colors">
          PrajaMart<span class="text-indigo-600 group-hover:text-slate-950">.</span>
        </h1>
        <p class="mt-1 text-[10px] uppercase tracking-[0.4em] text-slate-400 font-bold">Premium Essentials</p>
      </div>
    </a>

    <div class="hidden items-center gap-8 lg:flex ml-4">
      <% if (!isLoggedInSafe || isGuest) { %>
        <a href="/" class="text-sm font-bold transition-all <%= activeLink('index') %>">Home</a>
        <a href="/products" class="text-sm font-bold transition-all <%= activeLink('Products') %>">Catalog</a>
        <% if (isGuest) { %>
          <a href="/orders" class="text-sm font-bold transition-all <%= activeLink('orders') %> flex items-center gap-1.5">
            Orders <span class="h-1.5 w-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
          </a>
        <% } %>
      <% } else if (isHost) { %>
        <a href="/host/host-product-list" class="text-sm font-bold text-slate-600 hover:text-indigo-600">Inventory</a>
        <a href="/host/add-product" class="text-sm font-bold text-slate-600 hover:text-indigo-600">Add New</a>
        <a href="/host/orders" class="text-sm font-bold text-slate-600 hover:text-indigo-600">Sales History</a>
      <% } %>
    </div>

    <% if (showSearch) { %>
      <div class="hidden flex-1 justify-center md:flex">
        <form action="/products" method="GET" class="relative group">
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" name="query" value="<%= navSearchQuery %>" placeholder="Search curated goods..." 
                 class="search-input w-[180px] rounded-full bg-slate-100 px-10 py-2.5 text-sm outline-none transition-all duration-500 border border-transparent focus:border-indigo-200">
        </form>
      </div>
    <% } %>

    <div class="ml-auto flex items-center gap-3">
      <% if (isGuest) { %>
        <a href="/cart" class="relative flex h-11 w-11 items-center justify-center rounded-2xl bg-white border border-slate-100 shadow-sm transition-all hover:bg-slate-950 hover:text-white hover:-translate-y-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <% if (userCartCount > 0) { %>
            <span class="absolute -right-1.5 -top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[10px] font-bold text-white ring-2 ring-white shadow-lg animate-bounce">
              <%= userCartCount %>
            </span>
          <% } %>
        </a>
      <% } %>

      <% if (!isLoggedInSafe) { %>
        <div class="flex items-center gap-2">
          <a href="/login" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-indigo-600">Login</a>
          <a href="/signup" class="rounded-xl bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-indigo-600 hover:shadow-indigo-100 hover:-translate-y-0.5">Join</a>
        </div>
      <% } else { %>
        <div class="flex items-center gap-3 pl-3 border-l border-slate-200">
          <a href="/profile" class="h-10 w-10 overflow-hidden rounded-full ring-2 ring-white shadow-md hover:scale-110 transition-transform">
            <img src="<%= userSafe.profileImage || 'https://ui-avatars.com/api/?name=' + userSafe.name %>" class="h-full w-full object-cover" alt="Profile">
          </a>
          <form action="/logout" method="POST">
            <button class="h-10 w-10 flex items-center justify-center rounded-xl bg-red-50 text-red-500 hover:bg-red-600 hover:text-white transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M17 16l4-4m0 0l-4-4m4 4H7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        </div>
      <% } %>

      <button id="mobile-menu-button" class="flex h-11 w-11 flex-col items-center justify-center gap-1 rounded-2xl bg-slate-100 md:hidden active:scale-90 transition-transform">
        <span class="h-0.5 w-5 bg-slate-900 rounded-full"></span>
        <span class="h-0.5 w-5 bg-slate-900 rounded-full"></span>
        <span class="h-0.5 w-3 bg-slate-900 rounded-full self-end mr-3"></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden scale-y-0 opacity-0 bg-white border-t border-slate-100 md:hidden">
    <div class="p-6 space-y-3">
      <% if (isGuest) { %>
        <a href="/" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Home</a>
        <a href="/products" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Catalog</a>
        <a href="/orders" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900 flex justify-between items-center">Orders <span class="bg-indigo-600 h-2 w-2 rounded-full animate-pulse"></span></a>
        <a href="/cart" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900 flex justify-between items-center">Cart <span><%= userCartCount %></span></a>
        <a href="/profile" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">My Account</a>
      <% } else if (isHost) { %>
        <a href="/host/host-product-list" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Dashboard</a>
        <a href="/host/add-product" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Add New Item</a>
        <a href="/host/orders" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Orders</a>
      <% } else if (isDeliveryboy) { %>
        <a href="/delivery/orders" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Deliveries</a>
      <% } else { %>
        <a href="/" class="block p-4 rounded-2xl bg-slate-50 font-bold text-slate-900">Home</a>
        <a href="/login" class="block p-4 rounded-2xl bg-indigo-50 text-indigo-600 font-bold">Login to PrajaMart</a>
      <% } %>

      <% if (isLoggedInSafe) { %>
        <form action="/logout" method="POST" class="pt-2">
          <button class="w-full p-4 rounded-2xl bg-red-50 text-red-600 font-bold text-left">Logout</button>
        </form>
      <% } %>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isHidden = menu.classList.contains("hidden");
    if (isHidden) {
      menu.classList.remove("hidden");
      setTimeout(() => {
        menu.style.transform = "scaleY(1)";
        menu.style.opacity = "1";
      }, 10);
    } else {
      menu.style.transform = "scaleY(0)";
      menu.style.opacity = "0";
      setTimeout(() => menu.classList.add("hidden"), 400);
    }
  });

  window.addEventListener('scroll', () => {
    const header = document.querySelector('header');
    if (window.scrollY > 20) {
      header.classList.add('shadow-2xl');
      header.style.padding = "2px 0";
    } else {
      header.classList.remove('shadow-2xl');
      header.style.padding = "0";
    }
  });
</script>