<%
  const current = typeof currentPage !== 'undefined' ? currentPage : '';
  const navSearchQuery = typeof searchQuery !== 'undefined' ? searchQuery : '';

  const isLoggedInSafe = typeof isLoggedIn !== 'undefined' ? isLoggedIn : false;
  const userSafe = typeof user !== 'undefined' ? user : null;

  const isGuest = isLoggedInSafe && userSafe && userSafe.userType === 'guest';
  const isHost = isLoggedInSafe && userSafe && userSafe.userType === 'host';
  const isDeliveryboy = isLoggedInSafe && userSafe && userSafe.userType === 'deliveryboy';

  const showSearch = !isLoggedInSafe || isGuest;

  const userCartCount =
    userSafe && Array.isArray(userSafe.cart)
      ? userSafe.cart.filter(Boolean).length
      : 0;

  const homeHref = !isLoggedInSafe
    ? '/'
    : isHost
      ? '/host/host-product-list'
      : isDeliveryboy
        ? '/delivery/orders'
        : '/';

  const navLinkClass = (isActive) =>
    isActive
      ? 'bg-white/20 text-white shadow-lg scale-105'
      : 'text-white/90 hover:bg-white/10 hover:text-white hover:scale-105';
%>

<header class="sticky top-0 z-[100] bg-red-700 shadow-2xl">
  <nav class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 sm:px-6 lg:px-8">

    <!-- LOGO -->
    <a href="<%= homeHref %>" class="flex shrink-0 items-center gap-3 group">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-red-700 shadow-xl transition-all duration-500 group-hover:scale-110 group-hover:rotate-3 animate-pulse">
        <span class="text-xl font-black tracking-tight">
          PM
        </span>
      </div>

      <div class="transition-all duration-300 group-hover:translate-x-1">
        <h1 class="text-2xl font-black tracking-tight text-white leading-none">
          PrajaMart
        </h1>
        <p class="mt-1 text-[11px] uppercase tracking-[0.3em] text-white/80 font-semibold">
          Premium Store
        </p>
      </div>
    </a>

    <!-- SEARCH -->
    <% if (showSearch) { %>
      <form action="/products" method="GET" class="hidden min-w-0 flex-1 md:block">
        <div class="flex items-center gap-3 rounded-2xl bg-white/10 backdrop-blur-md p-1.5 shadow-lg transition-all duration-300 hover:bg-white/15">
          <input
            type="text"
            name="query"
            value="<%= navSearchQuery %>"
            placeholder="Search products..."
            class="w-full bg-transparent px-4 py-2 text-sm text-white outline-none placeholder:text-white/60"
          />
          <button
            type="submit"
            class="rounded-xl bg-white px-5 py-2 text-sm font-semibold text-red-700 shadow-md transition-all duration-300 hover:scale-105 hover:shadow-xl"
          >
            Search
          </button>
        </div>
      </form>
    <% } %>

    <!-- DESKTOP LINKS -->
    <div class="ml-auto hidden items-center gap-2 lg:flex">
      <% if (isGuest) { %>
        <a href="/" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'index') %>">Home</a>
        <a href="/products" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'Products' || current === 'search') %>">Products</a>
        <a href="/cart" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'cart') %>">Cart</a>
        <a href="/orders" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'orders') %>">Orders</a>
        <a href="/profile" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'profile') %>">Profile</a>

      <% } else if (isHost) { %>
        <a href="/host/host-product-list" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'host-products') %>">Host Products</a>
        <a href="/host/add-product" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'addProduct') %>">Add Product</a>
        <a href="/host/orders" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'host-orders') %>">Orders</a>
        <a href="/profile" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'profile') %>">Profile</a>

      <% } else if (isDeliveryboy) { %>
        <a href="/delivery/orders" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'delivery-orders') %>">Deliveries</a>
        <a href="/profile" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'profile') %>">Profile</a>

      <% } else { %>
        <a href="/" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'index') %>">Home</a>
        <a href="/products" class="rounded-full px-4 py-2 text-sm font-semibold transition-all duration-300 <%= navLinkClass(current === 'Products' || current === 'search') %>">Products</a>
      <% } %>
    </div>

    <!-- RIGHT SIDE -->
    <div class="hidden items-center gap-3 md:flex">
      <% if (isGuest) { %>
        <a href="/cart" class="relative inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-red-700 shadow-md transition-all duration-300 hover:scale-110 hover:shadow-xl">
          <span class="text-xl">🛒</span>

          <% if (userCartCount > 0) { %>
            <span class="absolute -right-2 -top-2 min-w-[1.35rem] rounded-full bg-white px-1.5 py-0.5 text-[11px] font-bold text-red-700 shadow">
              <%= userCartCount %>
            </span>
          <% } %>
        </a>
      <% } %>

      <% if (!isLoggedInSafe) { %>
        <a href="/signup" class="rounded-xl border border-white/30 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
          Sign Up
        </a>

        <a href="/login" class="rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-red-700 shadow-md transition-all duration-300 hover:scale-105 hover:shadow-xl">
          Login
        </a>
      <% } else { %>
        <a href="/profile" class="rounded-xl border border-white/30 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10">
          Profile
        </a>
        <form action="/logout" method="POST">
          <button class="rounded-xl bg-white px-4 py-2.5 text-sm font-semibold text-red-700 transition-all duration-300 hover:scale-105 hover:shadow-xl">
            Logout
          </button>
        </form>
      <% } %>
    </div>

    <!-- MOBILE BUTTON -->
    <button id="mobile-menu-button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-white text-red-700 shadow-md transition-all duration-300 hover:scale-110 md:hidden">
      ☰
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div id="mobile-menu" class="hidden bg-red-800 shadow-xl md:hidden transition-all duration-500">
    <div class="space-y-3 px-4 py-4 text-white">

      <% if (showSearch) { %>
        <form action="/products" method="GET" class="space-y-3">
          <input
            type="text"
            name="query"
            value="<%= navSearchQuery %>"
            placeholder="Search products..."
            class="w-full rounded-2xl bg-white/10 px-4 py-3 text-white placeholder:text-white/60"
          />
          <button class="w-full rounded-2xl bg-white px-4 py-3 font-semibold text-red-700">
            Search
          </button>
        </form>
      <% } %>

      <% if (isGuest) { %>
        <a href="/" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Home</a>
        <a href="/products" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Products</a>
        <a href="/cart" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Cart</a>
        <a href="/orders" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Orders</a>
        <a href="/profile" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Profile</a>
      <% } else if (isHost) { %>
        <a href="/host/host-product-list" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Host Products</a>
        <a href="/host/add-product" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Add Product</a>
        <a href="/host/orders" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Orders</a>
        <a href="/profile" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Profile</a>
      <% } else if (isDeliveryboy) { %>
        <a href="/delivery/orders" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Deliveries</a>
        <a href="/profile" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Profile</a>
      <% } else { %>
        <a href="/" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Home</a>
        <a href="/products" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Products</a>
      <% } %>

      <% if (isLoggedInSafe) { %>
        <form action="/logout" method="POST">
          <button class="block w-full rounded-xl px-4 py-3 text-left hover:bg-white/10 transition">Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Login</a>
        <a href="/signup" class="block rounded-xl px-4 py-3 hover:bg-white/10 transition">Sign Up</a>
      <% } %>
    </div>
  </div>
</header>

<script>
  document.getElementById("mobile-menu-button")?.addEventListener("click", () => {
    const menu = document.getElementById("mobile-menu");
    menu?.classList.toggle("hidden");
  });
</script>
