<div class="js-order-location-picker space-y-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-2">Delivery Location *</label>
    <p class="text-xs text-slate-500">
      Choose Home or Other, then search, use your current location, or click on the map to save the place name with exact coordinates.
    </p>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div>
      <label class="block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 mb-2">Address Type</label>
      <select
        name="addressLabel"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100"
      >
        <option value="home">Home</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div>
      <label class="block text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 mb-2">House / Landmark</label>
      <input
        type="text"
        name="addressDetails"
        maxlength="160"
        placeholder="Flat, building, floor, landmark"
        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100"
      >
    </div>
  </div>

  <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto_auto]">
    <input
      type="text"
      data-location-search
      placeholder="Search area, street, or landmark"
      class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-red-400 focus:ring-2 focus:ring-red-100"
    >
    <button
      type="button"
      data-location-search-button
      class="rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
    >
      Search
    </button>
    <button
      type="button"
      data-current-location-button
      class="rounded-xl bg-red-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-red-700"
    >
      Use Current Location
    </button>
  </div>

  <p data-location-search-status class="text-xs font-medium text-slate-500">
    Search a place or click directly on the map to pin the delivery point.
  </p>

  <div
    data-location-search-results
    class="hidden max-h-48 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-sm"
  ></div>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-inner">
    <div data-location-map class="h-72 w-full"></div>
  </div>

  <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-4">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Selected Place</p>
    <p data-selected-location-name class="mt-2 text-base font-semibold text-slate-900">No delivery point selected yet</p>
    <p data-selected-location-address class="mt-1 text-sm text-slate-600">
      Pick a point on the map so delivery boys can track the exact destination.
    </p>
    <p data-selected-location-coordinates class="mt-2 text-xs font-semibold tracking-[0.08em] text-slate-500"></p>
  </div>

  <input type="hidden" name="deliveryLatitude" value="">
  <input type="hidden" name="deliveryLongitude" value="">
  <input type="hidden" name="deliveryPlaceName" value="">
  <input type="hidden" name="deliveryFormattedAddress" value="">
  <input type="hidden" name="deliveryCity" value="">
</div>
