<% if (isLoggedIn && user && user.userType === 'guest') { %>
  <form action="/cart" method="POST" class="w-full">
    <input type="hidden" name="id" value="<%= product._id %>" />

    <button 
      type="submit"
      class="w-full bg-white text-red-700 font-semibold py-2.5 rounded-xl
             shadow-md hover:bg-red-700 hover:text-white
             hover:shadow-xl hover:scale-105 transition duration-300">
      Add to Cart
    </button>
  </form>
<% } else { %>
  <a
    href="/login"
    class="block w-full rounded-xl bg-white py-2.5 text-center font-semibold text-red-700 shadow-md transition duration-300 hover:bg-red-700 hover:text-white hover:shadow-xl hover:scale-105"
  >
    Add to Cart
  </a>
<% } %>
