<%- include('../partials/head') %>
</head>
<body class="bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="min-h-screen bg-gradient-to-br from-slate-100 via-white to-red-50 px-4 py-8 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl space-y-8">

      <!-- HEADER -->
      <div class="rounded-[2rem] border border-red-100 bg-white/95 p-6 shadow-xl">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-red-600">
              Delivery Dashboard
            </p>
            <h1 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">
              Nearby Ready Orders
            </h1>
          </div>

          <div
            id="deliveryLocationStatus"
            class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-600"
          >
            Checking your current location...
          </div>
        </div>
      </div>

      <!-- AVAILABLE ORDERS -->
      <section class="space-y-5">
        <h2 class="text-2xl font-black text-slate-900">Available To Accept</h2>

        <% if (availableOrders.length > 0) { %>
          <div class="grid gap-5 xl:grid-cols-2">
            <% availableOrders.forEach((order) => { 
              const item = order.items?.[0];
            %>
              <article
                class="delivery-order-card rounded-[1.6rem] border border-slate-200 bg-white p-6 shadow-lg"
                data-latitude="<%= order.deliveryLocation?.latitude ?? '' %>"
                data-longitude="<%= order.deliveryLocation?.longitude ?? '' %>"
              >
                <h3 class="text-2xl font-bold text-slate-900">
                  <%= item?.productId?.productName || 'Product Not Found' %>
                </h3>

                <p class="mt-2 text-sm text-slate-500">
                  Order ID: <%= order._id %>
                </p>

                <p class="mt-3 font-semibold">
                  ₹ <%= order.totalPrice %>
                </p>

                <p class="mt-2 text-sm text-slate-500" data-distance-output>
                  Checking distance...
                </p>

                <form
                  action="/delivery/orders/<%= order._id %>/accept"
                  method="POST"
                  class="mt-4"
                >
                  <input type="hidden" name="latitude">
                  <input type="hidden" name="longitude">

                  <button
                    type="submit"
                    data-accept-button
                    class="rounded-xl bg-red-600 px-5 py-3 text-white font-semibold disabled:bg-gray-300"
                    disabled
                  >
                    Accept Delivery
                  </button>
                </form>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl bg-white p-8 text-center">
            No nearby orders
          </div>
        <% } %>
      </section>

      <!-- ACTIVE ORDERS -->
      <section class="space-y-5">
        <h2 class="text-2xl font-black text-slate-900">Active Deliveries</h2>

        <% if (activeOrders.length > 0) { %>
          <div class="grid gap-5 xl:grid-cols-2">
            <% activeOrders.forEach((order) => { 
              const item = order.items?.[0];
            %>
              <article class="rounded-[1.6rem] border border-emerald-200 bg-white p-6 shadow-lg">

                <h3 class="text-2xl font-bold text-slate-900">
                  <%= item?.productId?.productName || 'Product Not Found' %>
                </h3>

                <p class="mt-2 text-sm text-slate-500">
                  Order ID: <%= order._id %>
                </p>

                <p class="mt-2 text-sm font-semibold text-emerald-600">
                  Status: <%= order.status %>
                </p>

                <!-- LIVE TRACK BUTTON -->
            <a href="/orders/<%= order._id.toString() %>/tracking"
              class="mt-3 inline-block rounded-lg bg-emerald-500 px-6 py-2 text-white hover:bg-emerald-600 transition font-medium">
              Open Tracking
            </a>



                <% if (order.status === 'shipped') { %>
                  <form
                    action="/delivery/orders/<%= order._id %>/start"
                    method="POST"
                    class="mt-4"
                  >
                    <button
                      type="submit"
                      class="rounded-xl bg-slate-900 px-5 py-3 text-white"
                    >
                      Mark Out For Delivery
                    </button>
                  </form>
                <% } %>

                <% if (order.status === 'out_for_delivery') { %>
                  <form
                    action="/delivery/orders/<%= order._id %>/complete"
                    method="POST"
                    class="mt-4"
                  >
                    <input
                      type="text"
                      name="otp"
                      maxlength="6"
                      placeholder="Enter OTP"
                      class="w-full rounded-xl border p-3"
                      required
                    >

                    <button
                      type="submit"
                      class="mt-3 rounded-xl bg-slate-900 px-5 py-3 text-white"
                    >
                      Complete Delivery
                    </button>
                  </form>
                <% } %>

              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl bg-white p-8 text-center">
            No active deliveries
          </div>
        <% } %>
      </section>

      <!-- COMPLETED -->
      <section class="space-y-5">
        <h2 class="text-2xl font-black text-slate-900">Recently Completed</h2>

        <% if (completedOrders.length > 0) { %>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <% completedOrders.forEach((order) => { 
              const item = order.items?.[0];
            %>
              <article class="rounded-xl bg-white p-5 shadow-md">
                <h3 class="text-lg font-bold">
                  <%= item?.productId?.productName || 'Product Not Found' %>
                </h3>

                <p class="mt-2 text-sm text-slate-500">
                  <%= order.userId.firstName %> <%= order.userId.lastName %>
                </p>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl bg-white p-8 text-center">
            No completed deliveries
          </div>
        <% } %>
      </section>

    </section>
  </main>

  <script src="/js/delivery-dashboard.js"></script>
</body>
</html>
