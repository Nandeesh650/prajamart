<%- include('../partials/head') %>
</head>
<body class="bg-slate-100">
  <%- include('../partials/nav') %>

  <main class="min-h-screen bg-gradient-to-br from-slate-100 via-white to-red-50 px-4 py-8 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-7xl space-y-8">
      <div class="rounded-[2rem] border border-red-100 bg-white/95 p-6 shadow-xl shadow-slate-200 sm:p-8">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.28em] text-red-600">Delivery Dashboard</p>
            <h1 class="mt-3 text-3xl font-black text-slate-900 sm:text-4xl">Nearby Ready Orders</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-500 sm:text-base">
              Share your current location to see orders you can accept within a 20 km radius, then complete delivery using the customer OTP.
            </p>
          </div>
          <div id="deliveryLocationStatus" class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-slate-600">
            Checking your current location...
          </div>
        </div>
      </div>

      <% if (success) { %>
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-medium text-emerald-700 shadow-sm">
          <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-medium text-red-700 shadow-sm">
          <%= error %>
        </div>
      <% } %>

      <section class="space-y-5">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-2xl font-black text-slate-900">Available To Accept</h2>
            <p class="text-sm text-slate-500">Only orders within 20 km of your live location can be accepted.</p>
          </div>
        </div>

        <% if (availableOrders.length > 0) { %>
          <div class="grid gap-5 xl:grid-cols-2">
            <% availableOrders.forEach((order) => { %>
              <article
                class="delivery-order-card rounded-[1.6rem] border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/60"
                data-latitude="<%= order.deliveryLocation?.latitude ?? '' %>"
                data-longitude="<%= order.deliveryLocation?.longitude ?? '' %>"
              >
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Ready To Deliver</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-900"><%= order.productId.productName %></h3>
                    <p class="mt-2 text-sm text-slate-500">Order ID: <%= order._id %></p>
                  </div>
                  <span class="inline-flex rounded-full bg-red-100 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-red-700">
                    <%= order.deliveryLocation?.placeName || order.deliveryLocation?.city || 'Location not set' %>
                  </span>
                </div>

                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Customer</p>
                    <p class="mt-2 text-base font-bold text-slate-900"><%= order.userId.firstName %> <%= order.userId.lastName %></p>
                    <p class="mt-1 text-sm text-slate-600"><%= order.userId.phoneNumber || 'Phone not available' %></p>
                  </div>
                  <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Host</p>
                    <p class="mt-2 text-base font-bold text-slate-900"><%= order.hostId.firstName %> <%= order.hostId.lastName %></p>
                    <p class="mt-1 text-sm text-slate-600"><%= order.hostId.phoneNumber || 'Phone not available' %></p>
                  </div>
                  <div class="rounded-2xl bg-red-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-red-400">Delivery Address</p>
                    <p class="mt-2 text-sm font-semibold text-slate-800"><%= order.shippingAddress %></p>
                    <% if (order.deliveryLocation?.latitude && order.deliveryLocation?.longitude) { %>
                      <p class="mt-2 text-xs text-slate-500">
                        Lat <%= Number(order.deliveryLocation.latitude).toFixed(6) %>, Lng <%= Number(order.deliveryLocation.longitude).toFixed(6) %>
                      </p>
                    <% } %>
                  </div>
                  <div class="rounded-2xl bg-emerald-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-500">Distance</p>
                    <p class="mt-2 text-sm font-semibold text-slate-800" data-distance-output>Enable location to measure distance</p>
                  </div>
                </div>

                <div class="mt-5 flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Order Value</p>
                    <p class="mt-1 text-xl font-black text-slate-900">Rs. <%= order.totalPrice %></p>
                  </div>
                  <form action="/delivery/orders/<%= order._id %>/accept" method="POST" class="flex items-center gap-3">
                    <input type="hidden" name="latitude" value="">
                    <input type="hidden" name="longitude" value="">
                    <button
                      type="submit"
                      data-accept-button
                      class="rounded-2xl bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-red-200 transition hover:bg-red-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none"
                      disabled
                    >
                      Accept Delivery
                    </button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-[1.6rem] border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
            No ready-to-deliver orders are available right now.
          </div>
        <% } %>
      </section>

      <section class="space-y-5">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Active Deliveries</h2>
          <p class="text-sm text-slate-500">Use the customer OTP to complete delivery once the order reaches them.</p>
        </div>

        <% if (activeOrders.length > 0) { %>
          <div class="grid gap-5 xl:grid-cols-2">
            <% activeOrders.forEach((order) => { %>
              <article class="rounded-[1.6rem] border border-emerald-200 bg-white p-6 shadow-lg shadow-slate-200/60">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-emerald-500">
                      <%= order.status === 'shipped' ? 'Shipped' : 'Out For Delivery' %>
                    </p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-900"><%= order.productId.productName %></h3>
                    <p class="mt-2 text-sm text-slate-500">Order ID: <%= order._id %></p>
                  </div>
                  <a href="/orders/<%= order._id %>/tracking" class="inline-flex rounded-2xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-md transition hover:bg-emerald-700">
                    Open Tracking
                  </a>
                </div>

                <div class="mt-5 grid gap-3 sm:grid-cols-2">
                  <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Customer Contact</p>
                    <p class="mt-2 text-base font-bold text-slate-900"><%= order.userId.firstName %> <%= order.userId.lastName %></p>
                    <p class="mt-1 text-sm text-slate-600"><%= order.userId.phoneNumber || 'Phone not available' %></p>
                  </div>
                  <div class="rounded-2xl bg-slate-50 p-4">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Host Contact</p>
                    <p class="mt-2 text-base font-bold text-slate-900"><%= order.hostId.firstName %> <%= order.hostId.lastName %></p>
                    <p class="mt-1 text-sm text-slate-600"><%= order.hostId.phoneNumber || 'Phone not available' %></p>
                  </div>
                  <div class="rounded-2xl bg-red-50 p-4 sm:col-span-2">
                    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-red-400">Delivery Address</p>
                    <p class="mt-2 text-sm font-semibold text-slate-800"><%= order.shippingAddress %></p>
                    <p class="mt-2 text-xs text-slate-500"><%= order.deliveryLocation?.placeName || order.deliveryLocation?.city || 'Mapped place not available' %></p>
                  </div>
                </div>

                <% if (order.status === 'shipped') { %>
                  <form action="/delivery/orders/<%= order._id %>/start" method="POST" class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    <p class="text-sm text-slate-600">This order has been picked up. Start the final trip when you are heading to the customer.</p>
                    <button type="submit" class="mt-4 rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                      Mark Out For Delivery
                    </button>
                  </form>
                <% } else { %>
                  <form action="/delivery/orders/<%= order._id %>/complete" method="POST" class="mt-5 flex flex-col gap-3 rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:flex-row sm:items-end">
                    <div class="flex-1">
                      <label class="block text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Customer OTP</label>
                      <input
                        type="text"
                        name="otp"
                        maxlength="6"
                        placeholder="Enter 6 digit OTP"
                        class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm font-semibold tracking-[0.2em] text-slate-900 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100"
                        required
                      >
                    </div>
                    <button type="submit" class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
                      Complete Delivery
                    </button>
                  </form>
                <% } %>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-[1.6rem] border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
            You do not have any active deliveries yet.
          </div>
        <% } %>
      </section>

      <section class="space-y-5">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Recently Completed</h2>
          <p class="text-sm text-slate-500">Your last delivered orders appear here.</p>
        </div>

        <% if (completedOrders.length > 0) { %>
          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <% completedOrders.forEach((order) => { %>
              <article class="rounded-[1.4rem] border border-slate-200 bg-white p-5 shadow-md shadow-slate-200/60">
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-400">Delivered</p>
                <h3 class="mt-2 text-lg font-bold text-slate-900"><%= order.productId.productName %></h3>
                <p class="mt-2 text-sm text-slate-500"><%= order.userId.firstName %> <%= order.userId.lastName %></p>
                <p class="mt-1 text-sm text-slate-500"><%= order.deliveryDate ? new Date(order.deliveryDate).toLocaleString() : 'Completed' %></p>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-[1.6rem] border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-500">
            Completed deliveries will appear here after OTP confirmation.
          </div>
        <% } %>
      </section>
    </section>
  </main>

  <script src="/js/delivery-dashboard.js"></script>
</body>
</html>
