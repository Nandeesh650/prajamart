<%- include('../partials/head') %>

<body class="bg-slate-100 font-sans antialiased">
  <div class="min-h-screen flex">
    <aside class="w-64 bg-slate-900 text-white hidden md:flex flex-col">
      <div class="p-6">
        <h1 class="text-2xl font-black tracking-tighter text-indigo-400">ADMIN PANEL</h1>
        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Full System Access</p>
      </div>
      <nav class="mt-6 flex-1 px-4 space-y-2">
        <a href="/admin/dashboard" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
          Dashboard
        </a>
        <a href="/admin/products" class="flex items-center gap-3 bg-indigo-600 px-4 py-3 rounded-xl text-sm font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v-2m0 2v2" /></svg>
          Products
        </a>
        <a href="/admin/posts" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Posts
        </a>
        <a href="/admin/users" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          Users
        </a>
      </nav>
      <div class="p-6 border-t border-slate-800">
        <form action="/admin/logout" method="POST" style="display: inline;">
          <button type="submit" class="text-xs font-bold text-slate-400 hover:text-white transition-colors cursor-pointer border-0 bg-transparent w-full text-left">Sign Out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8">
        <div class="flex items-center gap-4">
          <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Product Management</span>
        </div>
        <div class="flex items-center gap-4">
          <% if (success) { %><span class="text-xs font-bold text-green-600 bg-green-50 px-3 py-1 rounded-full"><%= success %></span><% } %>
          <% if (error) { %><span class="text-xs font-bold text-red-600 bg-red-50 px-3 py-1 rounded-full"><%= error %></span><% } %>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-8">
        <div class="mb-8 flex items-center justify-between gap-4">
          <div>
            <h2 class="text-3xl font-black text-slate-900 uppercase">Manage Products</h2>
            <p class="text-slate-500 text-sm">Add, edit, or delete products with all product fields.</p>
          </div>
          <a href="/admin/products/add" class="flex items-center gap-2 px-6 py-3 bg-green-600 text-white hover:bg-green-700 transition-all rounded-xl font-black text-xs uppercase tracking-widest">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Add Product
          </a>
        </div>

        <section class="max-w-7xl mb-6">
          <form action="/admin/products" method="GET" class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm">
            <div class="flex flex-col gap-3 md:flex-row md:items-center">
              <div class="flex-1">
                <input
                  type="text"
                  name="query"
                  value="<%= searchQuery || '' %>"
                  placeholder="Search product name, tag, location, description, or seller name"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-medium text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white"
                >
              </div>
              <div class="flex gap-2">
                <button type="submit" class="px-5 py-3 bg-slate-900 text-white rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-indigo-600 transition-colors">
                  Search
                </button>
                <% if (searchQuery) { %>
                  <a href="/admin/products" class="px-5 py-3 bg-slate-100 text-slate-700 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-slate-200 transition-colors">
                    Clear
                  </a>
                <% } %>
              </div>
            </div>
          </form>
        </section>

        <section class="max-w-7xl">
          <% if (products && products.length > 0) { %>
            <% if (searchQuery) { %>
              <div class="mb-4">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-500">
                  Search results for "<%= searchQuery %>"
                </p>
              </div>
            <% } %>
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
              <% products.forEach(product => { %>
                <div class="bg-white rounded-3xl shadow-md border border-slate-100 overflow-hidden">
                  <div class="grid grid-cols-1 md:grid-cols-[220px_1fr]">
                    <div class="bg-slate-50 p-4 border-b md:border-b-0 md:border-r border-slate-100">
                      <img
                        src="/<%= (product.photos && product.photos.length > 0) ? product.photos[0] : (product.photo || 'images/placeholder.jpg') %>"
                        alt="<%= product.productName %>"
                        class="h-52 w-full rounded-2xl object-cover"
                      >
                      <div class="mt-4 grid grid-cols-2 gap-2 text-[10px] font-black uppercase tracking-widest">
                        <div class="rounded-xl bg-white border border-slate-200 px-3 py-2 text-slate-700">Images: <%= Array.isArray(product.photos) ? product.photos.length : 0 %></div>
                        <div class="rounded-xl bg-white border border-slate-200 px-3 py-2 text-slate-700">Stock: <%= Number(product.stock || 0) %></div>
                      </div>
                    </div>

                    <div class="p-6">
                      <div class="flex items-start justify-between gap-4">
                        <div>
                          <h3 class="text-2xl font-black text-slate-900 leading-tight"><%= product.productName %></h3>
                          <p class="mt-1 text-sm font-semibold text-indigo-600">Rs <%= Number(product.price || 0).toLocaleString('en-IN') %></p>
                        </div>
                        <span class="rounded-full bg-slate-100 px-3 py-2 text-[10px] font-black uppercase tracking-widest text-slate-600">
                          <%= product.location || 'No location' %>
                        </span>
                      </div>

                      <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Host Owner</p>
                          <p class="mt-1 font-semibold text-slate-800">
                            <%= product.hostId ? `${product.hostId.firstName || ''} ${product.hostId.lastName || ''}`.trim() || product.hostId.email : 'Not assigned' %>
                          </p>
                          <% if (product.hostId && product.hostId.email) { %>
                            <p class="mt-1 text-xs text-slate-500"><%= product.hostId.email %></p>
                          <% } %>
                        </div>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                          <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Tags</p>
                          <div class="mt-2 flex flex-wrap gap-2">
                            <% if (product.key && product.key.length > 0) { %>
                              <% product.key.forEach(tag => { %>
                                <span class="rounded-xl bg-amber-50 px-2.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-amber-700"><%= tag %></span>
                              <% }) %>
                            <% } else { %>
                              <span class="text-xs text-slate-500">No tags</span>
                            <% } %>
                          </div>
                        </div>
                      </div>

                      <div class="mt-4 rounded-2xl bg-slate-50 px-4 py-3">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Available Sizes</p>
                        <div class="mt-2 flex flex-wrap gap-2">
                          <% if (product.availableSizes && product.availableSizes.length > 0) { %>
                            <% product.availableSizes.forEach(size => { %>
                              <span class="rounded-xl bg-white border border-slate-200 px-2.5 py-1.5 text-[10px] font-black uppercase tracking-widest text-slate-700"><%= size %></span>
                            <% }) %>
                          <% } else { %>
                            <span class="text-xs text-slate-500">No sizes selected</span>
                          <% } %>
                        </div>
                      </div>

                      <div class="mt-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Description</p>
                        <p class="mt-2 text-sm leading-6 text-slate-600">
                          <%= product.description && product.description.trim().length > 0 ? product.description : 'No description added for this product yet.' %>
                        </p>
                      </div>

                      <div class="mt-6 flex gap-3">
                        <a href="/admin/products/<%= product._id %>/edit" class="flex-1 py-3 bg-blue-600 text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-blue-700 text-center transition-colors">
                          Edit Product
                        </a>
                        <form action="/admin/products/<%= product._id %>/delete" method="POST" class="flex-1">
                          <button type="submit" class="w-full py-3 bg-red-600 text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-red-700 transition-colors" onclick="return confirm('Delete this product?')">
                            Delete Product
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="bg-white rounded-3xl p-20 text-center border-4 border-dashed border-slate-200">
              <p class="text-slate-400 font-black uppercase tracking-widest">
                <%= searchQuery ? 'No matching products found' : 'No products found' %>
              </p>
            </div>
          <% } %>
        </section>
      </div>
    </main>
  </div>
</body>
</html>
