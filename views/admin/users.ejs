<%- include('../partials/head') %>

<body class="bg-slate-100 font-sans antialiased">
  <div class="min-h-screen flex">
    
    <aside class="w-64 bg-slate-900 text-white hidden md:flex flex-col">
      <div class="p-6">
        <h1 class="text-2xl font-black tracking-tighter text-indigo-400">ADMIN PANEL</h1>
        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Full System Access</p>
      </div>
      <nav class="mt-6 flex-1 px-4 space-y-2">
        <a href="/admin/dashboard" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
          Dashboard
        </a>
        <a href="/admin/products" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v-2m0 2v2" /></svg>
          Products
        </a>
        <a href="/admin/posts" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Posts
        </a>
        <a href="/admin/users" class="flex items-center gap-3 bg-indigo-600 px-4 py-3 rounded-xl text-sm font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          Users
        </a>
      </nav>
      <div class="p-6 border-t border-slate-800">
        <form action="/admin/logout" method="POST" style="display: inline;">
          <button type="submit" class="text-xs font-bold text-slate-400 hover:text-white transition-colors cursor-pointer border-0 bg-transparent w-full text-left">Sign Out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
      
      <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8">
        <div class="flex items-center gap-4">
          <span class="text-xs font-black text-slate-400 uppercase tracking-widest">User Management</span>
        </div>
        <div class="flex items-center gap-4">
          <% if (success) { %> <span class="text-xs font-bold text-green-600 bg-green-50 px-3 py-1 rounded-full"><%= success %></span> <% } %>
          <% if (error) { %> <span class="text-xs font-bold text-red-600 bg-red-50 px-3 py-1 rounded-full"><%= error %></span> <% } %>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-8">
        
        <div class="mb-8">
          <h2 class="text-3xl font-black text-slate-900 uppercase">Manage Users</h2>
          <p class="text-slate-500 text-sm">Edit or delete user accounts.</p>
        </div>

        <section class="max-w-6xl mb-6">
          <form action="/admin/users" method="GET" class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm">
            <div class="flex flex-col gap-3 md:flex-row md:items-center">
              <div class="flex-1">
                <input
                  type="text"
                  name="query"
                  value="<%= searchQuery || '' %>"
                  placeholder="Search by name, email, phone, or type"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3 text-sm font-medium text-slate-800 outline-none transition focus:border-indigo-500 focus:bg-white"
                >
              </div>
              <div class="flex gap-2">
                <button type="submit" class="px-5 py-3 bg-slate-900 text-white rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-indigo-600 transition-colors">
                  Search
                </button>
                <% if (searchQuery) { %>
                  <a href="/admin/users" class="px-5 py-3 bg-slate-100 text-slate-700 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-slate-200 transition-colors">
                    Clear
                  </a>
                <% } %>
              </div>
            </div>
          </form>
        </section>

        <section class="max-w-6xl">
          <% if (users && users.length > 0) { %>
            <% if (searchQuery) { %>
              <div class="mb-4">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-500">
                  Search results for "<%= searchQuery %>"
                </p>
              </div>
            <% } %>
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-slate-900 text-white">
                    <th class="px-6 py-4 text-left text-xs font-black uppercase">Name</th>
                    <th class="px-6 py-4 text-left text-xs font-black uppercase">Email</th>
                    <th class="px-6 py-4 text-left text-xs font-black uppercase">Phone</th>
                    <th class="px-6 py-4 text-left text-xs font-black uppercase">Type</th>
                    <th class="px-6 py-4 text-left text-xs font-black uppercase">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach((user, index) => { %>
                    <tr class="<%= index % 2 === 0 ? 'bg-white' : 'bg-slate-50' %> border-b border-slate-200 hover:bg-slate-100 transition-colors">
                      <td class="px-6 py-4">
                        <p class="font-bold text-slate-900"><%= user.firstName %> <%= user.lastName %></p>
                      </td>
                      <td class="px-6 py-4">
                        <p class="text-sm text-slate-600"><%= user.email %></p>
                      </td>
                      <td class="px-6 py-4">
                        <p class="text-sm text-slate-600"><%= user.phoneNumber %></p>
                      </td>
                      <td class="px-6 py-4">
                        <span class="px-3 py-1 bg-indigo-100 text-indigo-600 rounded-full text-[10px] font-bold uppercase"><%= user.userType %></span>
                      </td>
                      <td class="px-6 py-4">
                        <div class="flex gap-2">
                          <a href="/admin/users/<%= user._id %>/edit" class="px-3 py-1 bg-blue-600 text-white rounded text-[10px] font-bold hover:bg-blue-700">Edit</a>
                          <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display: inline;">
                            <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded text-[10px] font-bold hover:bg-red-700" onclick="return confirm('Delete this user?')">Delete</button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="bg-white rounded-3xl p-20 text-center border-4 border-dashed border-slate-200">
              <p class="text-slate-400 font-black uppercase tracking-widest">
                <%= searchQuery ? 'No matching users found' : 'No users found' %>
              </p>
            </div>
          <% } %>
        </section>
      </div>

    </main>
  </div>
</body>
</html>
