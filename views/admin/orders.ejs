<%- include('../partials/head') %>
<body class="bg-slate-50 font-sans antialiased text-slate-900">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <h1 class="text-4xl font-black tracking-tight text-slate-900">ADMIN CONTROL</h1>
        <p class="text-slate-500 font-medium mt-1">Manage all system orders and product posters.</p>
      </div>
      <div class="flex items-center gap-2 px-4 py-2 bg-white rounded-2xl shadow-sm border border-slate-200">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        <span class="text-xs font-black uppercase tracking-widest text-slate-600">Live System Access</span>
      </div>
    </header>

    <section class="space-y-6">
      <% if (orders.length > 0) { %>
        <% orders.forEach(order => { %>
          <div class="group bg-white rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-xl hover:border-indigo-200 transition-all duration-300 overflow-hidden">
            <div class="flex flex-col lg:flex-row">
              
              <div class="lg:w-72 p-6 bg-slate-50 flex flex-col items-center justify-center border-r border-slate-100">
                <img src="/<%= order.items[0].productId.photo %>" class="w-32 h-32 object-contain drop-shadow-2xl group-hover:scale-110 transition-transform duration-500">
                
                <form action="/admin/update-product-poster" method="POST" enctype="multipart/form-data" class="mt-4 w-full">
                  <input type="hidden" name="productId" value="<%= order.items[0].productId._id %>">
                  <label class="block group/file relative">
                    <input type="file" name="poster" onchange="this.form.submit()" class="hidden">
                    <div class="cursor-pointer text-[10px] font-black uppercase tracking-tighter text-center py-2 px-4 rounded-xl bg-white border border-slate-200 text-slate-500 hover:bg-indigo-600 hover:text-white transition-all">
                      Replace Poster
                    </div>
                  </label>
                </form>
              </div>

              <div class="flex-1 p-8">
                <div class="flex justify-between items-start mb-6">
                  <div>
                    <span class="text-[10px] font-black text-indigo-600 uppercase tracking-[0.2em]">Order ID: #<%= order._id.toString().slice(-8) %></span>
                    <h2 class="text-xl font-bold text-slate-800 mt-1"><%= order.items[0].productId.productName %></h2>
                  </div>
                  <form action="/admin/delete-order/<%= order._id %>" method="POST" onsubmit="return confirm('ADMIN WARNING: Permanent delete?')">
                    <button class="p-3 text-slate-300 hover:text-red-600 hover:bg-red-50 rounded-2xl transition-all">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </form>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                  <div class="bg-slate-50 p-3 rounded-2xl">
                    <p class="text-[9px] font-black text-slate-400 uppercase">Customer</p>
                    <p class="text-xs font-bold truncate"><%= order.userId.firstName %> <%= order.userId.lastName %></p>
                  </div>
                  <div class="bg-slate-50 p-3 rounded-2xl">
                    <p class="text-[9px] font-black text-slate-400 uppercase">Payment</p>
                    <p class="text-xs font-bold text-green-600 uppercase"><%= order.paymentMethod %></p>
                  </div>
                  <div class="bg-slate-50 p-3 rounded-2xl">
                    <p class="text-[9px] font-black text-slate-400 uppercase">Total</p>
                    <p class="text-xs font-black">₹<%= order.totalPrice %></p>
                  </div>
                  <div class="bg-slate-50 p-3 rounded-2xl">
                    <p class="text-[9px] font-black text-slate-400 uppercase">Current Status</p>
                    <p class="text-xs font-black text-indigo-600 uppercase"><%= order.status.replace('_', ' ') %></p>
                  </div>
                </div>

                <form action="/admin/update-status/<%= order._id %>" method="POST" class="flex flex-wrap items-center gap-3">
                  <select name="status" class="flex-1 min-w-[150px] appearance-none bg-slate-100 border-none rounded-xl px-5 py-3 text-xs font-black uppercase tracking-widest text-slate-700 cursor-pointer focus:ring-2 focus:ring-indigo-500 transition-all">
                    <option value="pending" <%= order.status == 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="confirmed" <%= order.status == 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                    <option value="shipped" <%= order.status == 'shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="delivered" <%= order.status == 'delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="cancelled" <%= order.status == 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                  <button type="submit" class="px-8 py-3 bg-slate-900 text-white rounded-xl text-[10px] font-black uppercase tracking-[0.2em] hover:bg-indigo-600 shadow-lg active:scale-95 transition-all">
                    Apply Force Update
                  </button>
                  <a href="/orders/<%= order._id %>" class="px-6 py-3 border border-slate-200 text-slate-600 rounded-xl text-[10px] font-black uppercase tracking-[0.2em] hover:bg-slate-50 transition-all">View Full Log</a>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-20 bg-white rounded-[3rem] border-2 border-dashed border-slate-200">
          <p class="text-slate-400 font-bold">No orders found in the database.</p>
        </div>
      <% } %>
    </section>
  </main>
</body>