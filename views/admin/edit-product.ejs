<%- include('../partials/head') %>

<body class="bg-slate-100 font-sans antialiased">
  <div class="min-h-screen flex">
    <aside class="w-64 bg-slate-900 text-white hidden md:flex flex-col">
      <div class="p-6">
        <h1 class="text-2xl font-black tracking-tighter text-indigo-400">ADMIN PANEL</h1>
        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Full System Access</p>
      </div>
      <nav class="mt-6 flex-1 px-4 space-y-2">
        <a href="/admin/dashboard" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
          Dashboard
        </a>
        <a href="/admin/products" class="flex items-center gap-3 bg-indigo-600 px-4 py-3 rounded-xl text-sm font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-4m-8 0H4m8 0v-2m0 2v2" /></svg>
          Products
        </a>
        <a href="/admin/posts" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Posts
        </a>
        <a href="/admin/users" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          Users
        </a>
      </nav>
      <div class="p-6 border-t border-slate-800">
        <form action="/admin/logout" method="POST" style="display: inline;">
          <button type="submit" class="text-xs font-bold text-slate-400 hover:text-white transition-colors cursor-pointer border-0 bg-transparent w-full text-left">Sign Out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8">
        <div class="flex items-center gap-4">
          <span class="text-xs font-black text-slate-400 uppercase tracking-widest"><%= editing ? 'Edit Product' : 'Add Product' %></span>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-8">
        <div class="mb-8">
          <h2 class="text-3xl font-black text-slate-900 uppercase"><%= editing ? 'Edit Product' : 'Add Product' %></h2>
          <p class="text-slate-500 text-sm">Manage all product fields from the admin panel.</p>
        </div>

        <div class="max-w-5xl">
          <% if (errors.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
              <% errors.forEach(error => { %>
                <p class="text-xs text-red-600 font-bold mb-1"><%= error %></p>
              <% }) %>
            </div>
          <% } %>

          <div class="bg-white rounded-3xl shadow-md p-6 border border-slate-100">
            <form action="/admin/products/<%= editing ? `${product._id}/edit` : 'add' %>" method="POST" enctype="multipart/form-data">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Product Name</label>
                  <input type="text" name="productName" value="<%= formData.productName %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Host Owner</label>
                  <select name="hostId" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">No host assigned</option>
                    <% hostOptions.forEach(host => { %>
                      <option value="<%= host._id %>" <%= formData.hostId && formData.hostId.toString() === host._id.toString() ? 'selected' : '' %>>
                        <%= `${host.firstName || ''} ${host.lastName || ''}`.trim() || host.email %> <% if (host.email) { %>(<%= host.email %>)<% } %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Price</label>
                  <input type="number" name="price" value="<%= formData.price %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Stock</label>
                  <input type="number" name="stock" value="<%= formData.stock %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Location</label>
                  <select name="location" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="">Select location</option>
                    <% locationOptions.forEach(location => { %>
                      <option value="<%= location %>" <%= formData.location === location ? 'selected' : '' %>><%= location %></option>
                    <% }) %>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Tags</label>
                  <input type="text" name="key" value="<%= formData.key %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="tech, mobile, fashion">
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Description</label>
                  <textarea name="description" rows="4" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"><%= formData.description %></textarea>
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Available Sizes</label>
                  <div class="flex flex-wrap gap-3 rounded-2xl bg-slate-50 p-4 border border-slate-200">
                    <% sizeOptions.forEach(size => { %>
                      <label class="inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2 border border-slate-200">
                        <input type="checkbox" name="availableSizes" value="<%= size %>" <%= formData.availableSizes.includes(size) ? 'checked' : '' %>>
                        <span class="text-xs font-black uppercase tracking-widest text-slate-700"><%= size %></span>
                      </label>
                    <% }) %>
                  </div>
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">
                    Product Images <%= editing ? '(upload to replace existing images)' : '(required)' %>
                  </label>
                  <input type="file" name="photos" multiple accept="image/*" class="w-full px-4 py-3 border border-slate-200 rounded-xl bg-slate-50">
                </div>

                <% if (editing && product && product.photos && product.photos.length > 0) { %>
                  <div class="md:col-span-2">
                    <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-3">Current Images</p>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                      <% product.photos.forEach(photo => { %>
                        <img src="/<%= photo %>" alt="Product image" class="h-28 w-full rounded-2xl object-cover border border-slate-200">
                      <% }) %>
                    </div>
                  </div>
                <% } %>
              </div>

              <div class="mt-8 flex gap-3">
                <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-xl font-black text-xs uppercase tracking-widest hover:bg-blue-700 transition-all">
                  <%= editing ? 'Update Product' : 'Add Product' %>
                </button>
                <a href="/admin/products" class="flex-1 px-6 py-3 bg-slate-200 text-slate-700 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-slate-300 transition-all text-center">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
