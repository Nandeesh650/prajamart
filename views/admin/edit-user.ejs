<%- include('../partials/head') %>

<body class="bg-slate-100 font-sans antialiased">
  <div class="min-h-screen flex">
    
    <aside class="w-64 bg-slate-900 text-white hidden md:flex flex-col">
      <div class="p-6">
        <h1 class="text-2xl font-black tracking-tighter text-indigo-400">ADMIN PANEL</h1>
        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-1">Full System Access</p>
      </div>
      <nav class="mt-6 flex-1 px-4 space-y-2">
        <a href="/admin/dashboard" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
          Dashboard
        </a>
        <a href="/admin/posts" class="flex items-center gap-3 hover:bg-indigo-700 px-4 py-3 rounded-xl text-sm font-bold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
          Posts
        </a>
        <a href="/admin/users" class="flex items-center gap-3 bg-indigo-600 px-4 py-3 rounded-xl text-sm font-bold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-2a6 6 0 0112 0v2zm0 0h6v-2a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          Users
        </a>
      </nav>
      <div class="p-6 border-t border-slate-800">
        <form action="/admin/logout" method="POST" style="display: inline;">
          <button type="submit" class="text-xs font-bold text-slate-400 hover:text-white transition-colors cursor-pointer border-0 bg-transparent w-full text-left">Sign Out</button>
        </form>
      </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
      
      <header class="bg-white border-b border-slate-200 h-16 flex items-center justify-between px-8">
        <div class="flex items-center gap-4">
          <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Edit User</span>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-8">
        
        <div class="mb-8">
          <h2 class="text-3xl font-black text-slate-900 uppercase">Edit User</h2>
          <p class="text-slate-500 text-sm">Update user information and type.</p>
        </div>

        <div class="max-w-2xl">
          <% if(errors.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6">
              <% errors.forEach(error => { %>
                <p class="text-xs text-red-600 font-bold mb-1"><%= error %></p>
              <% }); %>
            </div>
          <% } %>

          <div class="bg-white rounded-xl shadow-md p-6 border border-slate-100">
            <form action="/admin/users/<%= editUser._id %>/edit" method="POST">
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">First Name</label>
                  <input type="text" name="firstName" value="<%= editUser.firstName %>" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                </div>
                <div>
                  <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Last Name</label>
                  <input type="text" name="lastName" value="<%= editUser.lastName %>" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
              </div>

              <div class="mb-6">
                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Email</label>
                <input type="email" name="email" value="<%= editUser.email %>" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
              </div>

              <div class="mb-6">
                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Phone Number</label>
                <input type="tel" name="phoneNumber" value="<%= editUser.phoneNumber %>" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
              </div>

              <div class="mb-6">
                <label class="block text-xs font-black text-slate-400 uppercase tracking-widest mb-2">User Type</label>
                <select name="userType" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                  <option value="guest" <%= editUser.userType === 'guest' ? 'selected' : '' %>>Guest</option>
                  <option value="host" <%= editUser.userType === 'host' ? 'selected' : '' %>>Host</option>
                  <option value="deliveryboy" <%= editUser.userType === 'deliveryboy' ? 'selected' : '' %>>Delivery Boy</option>
                </select>
              </div>

              <div class="flex gap-3">
                <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg font-black text-xs uppercase tracking-widest hover:bg-blue-700 transition-all">
                  Update User
                </button>
                <a href="/admin/users" class="flex-1 px-6 py-3 bg-slate-200 text-slate-700 rounded-lg font-black text-xs uppercase tracking-widest hover:bg-slate-300 transition-all text-center">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>

    </main>
  </div>
</body>
</html>
