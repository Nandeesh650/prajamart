<%- include('../partials/head') %>

<body class="bg-slate-100 font-sans antialiased">
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="bg-white rounded-xl shadow-lg border border-slate-100 p-8">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-black text-slate-900">ADMIN</h1>
          <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Secure Login</p>
        </div>

        <% if(errors.length > 0) { %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <% errors.forEach(error => { %>
              <p class="text-xs text-red-600 font-bold mb-1"><%= error %></p>
            <% }); %>
          </div>
        <% } %>

        <% if(error) { %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <p class="text-xs text-red-600 font-bold"><%= error %></p>
          </div>
        <% } %>

        <% if(success) { %>
          <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
            <p class="text-xs text-green-600 font-bold"><%= success %></p>
          </div>
        <% } %>

        <form action="/admin/login" method="POST">
          <div class="mb-4">
            <label for="email" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Email Address</label>
            <input type="email" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500" id="email" name="email" value="<%= oldInput.email %>" required>
          </div>

          <div class="mb-6">
            <label for="password" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Password</label>
            <input type="password" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500" id="password" name="password" required>
          </div>

          <button type="submit" class="w-full py-3 bg-red-600 text-white rounded-lg font-black text-xs uppercase tracking-widest hover:bg-red-700 transition-all">
            Login as Admin
          </button>
        </form>

        <hr class="my-6">

        <div class="text-center">
          <a href="/" class="text-xs font-bold text-slate-400 hover:text-slate-600 transition-colors">← Back to Home</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>

