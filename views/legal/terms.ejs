<%- include('../partials/head') %>

<style>
  body {
    background:
      radial-gradient(circle at top left, rgba(99, 102, 241, 0.10), transparent 30%),
      linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    min-height: 100vh;
  }

  .legal-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .legal-hero,
  .legal-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 30px 70px rgba(15, 23, 42, 0.08);
  }

  .legal-prose p,
  .legal-prose li {
    color: #475569;
    line-height: 1.8;
  }

  .legal-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
</style>
</head>

<body class="text-slate-900">
  <%- include('../partials/nav') %>

  <main class="legal-shell">
    <section class="legal-hero rounded-[2.5rem] p-8 md:p-12">
      <p class="text-[11px] font-black uppercase tracking-[0.35em] text-indigo-600"><%= terms.heroLabel %></p>
      <h1 class="mt-4 text-4xl md:text-6xl font-[900] tracking-tighter text-slate-950"><%= pageTitle %></h1>
      <p class="mt-4 text-sm font-semibold uppercase tracking-[0.22em] text-slate-400">Effective Date: <%= effectiveDate %></p>

      <div class="legal-prose mt-8 space-y-4 text-base">
        <% terms.intro.forEach((paragraph) => { %>
          <p><%= paragraph %></p>
        <% }) %>
      </div>
    </section>

    <section class="mt-8 grid gap-6">
      <% terms.sections.forEach((section) => { %>
        <article class="legal-card rounded-[2rem] p-7 md:p-9">
          <h2 class="text-2xl font-[850] tracking-tight text-slate-950"><%= section.title %></h2>

          <div class="legal-prose mt-4 space-y-4">
            <% section.paragraphs.forEach((paragraph) => { %>
              <p><%= paragraph %></p>
            <% }) %>

            <% if (section.bullets.length > 0) { %>
              <ul class="space-y-2">
                <% section.bullets.forEach((bullet) => { %>
                  <li><%= bullet %></li>
                <% }) %>
              </ul>
            <% } %>
          </div>
        </article>
      <% }) %>
    </section>

    <section class="legal-card mt-8 rounded-[2rem] p-7 md:p-9">
      <p class="text-[11px] font-black uppercase tracking-[0.3em] text-slate-400">Registration Checkbox Copy</p>
      <p class="mt-4 text-base text-slate-600"><%= terms.checkboxText %></p>
    </section>
  </main>
</body>
</html>
