<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-100">
    <%- include('../partials/nav') %>

    <main class="container mx-auto mt-8 max-w-2xl rounded-lg bg-white p-8 shadow-md">
      <h1 class="border-b pb-4 text-center text-3xl font-bold text-gray-800">Forgot Password</h1>
      <p class="mt-4 text-center text-gray-600">
        Enter your email address to generate a password reset link.
      </p>

      <form action="/forgot-password" method="POST" class="mx-auto mt-8 max-w-md">
        <% if (success) { %>
          <div class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">
            <%= success %>
          </div>
        <% } %>
        <% if (error) { %>
          <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= error %>
          </div>
        <% } %>
        <%- include('../partials/errors') %>

        <div class="mb-5">
          <label for="email" class="mb-1 block text-sm font-medium text-gray-700">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= oldInput.email %>"
            placeholder="your.email@example.com"
            class="w-full rounded-md border px-4 py-3 transition focus:border-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
        </div>

        <% if (resetLink) { %>
          <div class="mb-5 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-700">
            <p class="font-semibold">Local reset link</p>
            <a href="<%= resetLink %>" class="mt-2 block break-all font-medium underline"><%= resetLink %></a>
          </div>
        <% } %>

        <button type="submit" class="w-full rounded-md bg-red-500 py-3 font-medium text-white transition duration-300 hover:bg-red-600">
          Generate Reset Link
        </button>

        <p class="mt-6 text-center text-gray-600">
          Remembered your password? <a href="/login" class="text-red-500 hover:underline">Back to login</a>
        </p>
      </form>
    </main>
  </body>
</html>
