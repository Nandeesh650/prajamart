<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-gradient-to-br from-red-100 via-white to-red-50">

  <%- include('../partials/nav') %>

  <main class="min-h-[85vh] flex items-center justify-center px-6 py-10">
    
    <!-- Wide Container -->
    <div class="w-full max-w-4xl mx-auto">
      
      <!-- Premium Card -->
      <div class="bg-white/90 backdrop-blur-xl shadow-2xl rounded-[2rem] overflow-hidden border border-white/40">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-600 via-red-500 to-red-700 px-10 py-8 text-center">
          <h1 class="text-4xl font-bold text-white tracking-wide">
            Forgot Password
          </h1>
          <p class="text-red-100 mt-2 text-base">
            Generate a secure password reset link
          </p>
        </div>

        <!-- Form Section -->
        <div class="p-12">
          <div class="mx-auto max-w-2xl">
            
            <p class="mb-8 text-center text-gray-600 text-lg">
              Enter your email address to generate a password reset link
            </p>

            <form action="/forgot-password" method="POST" class="space-y-6">

              <% if (success) { %>
                <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700 shadow-sm">
                  <%= success %>
                </div>
              <% } %>

              <% if (error) { %>
                <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 shadow-sm">
                  <%= error %>
                </div>
              <% } %>

              <%- include('../partials/errors') %>

              <!-- Email -->
              <div>
                <label for="email" class="mb-2 block text-sm font-semibold text-gray-700">
                  Email Address
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="<%= oldInput.email %>"
                  placeholder="your.email@example.com"
                  class="w-full rounded-2xl border border-gray-200 bg-gray-50 px-5 py-4 shadow-sm transition focus:border-red-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
                  required
                />
              </div>

              <!-- Reset Link -->
              <% if (resetLink) { %>
                <div class="rounded-2xl border border-blue-200 bg-blue-50 px-5 py-4 text-sm text-blue-700 shadow-sm">
                  <p class="font-semibold">Local reset link</p>
                  <a
                    href="<%= resetLink %>"
                    class="mt-2 block break-all font-medium underline"
                  >
                    <%= resetLink %>
                  </a>
                </div>
              <% } %>

              <!-- Button -->
              <button
                type="submit"
                class="w-full rounded-lg bg-red-500 py-3 font-semibold text-white transition hover:bg-red-600"
              >
                Generate Reset Link
              </button>

              <!-- Login -->
              <p class="text-center text-gray-600">
                Remembered your password?
                <a href="/login" class="text-red-500 font-semibold hover:underline">
                  Back to login
                </a>
              </p>

            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
