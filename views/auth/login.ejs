<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* 1. Snow-Rain Layer (Topmost) */
        #snowCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 100; 
            pointer-events: none;
        }

        /* 2. Deep Obsidian Background */
        body {
            background: #050505;
            background-image: 
                radial-gradient(at 0% 0%, rgba(20, 30, 50, 0.6) 0, transparent 50%), 
                radial-gradient(at 100% 100%, rgba(30, 10, 30, 0.4) 0, transparent 50%);
            color: #ffffff;
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', system-ui, sans-serif;
            overflow-x: hidden;
        }

        /* 3. The Animated Login Card */
        .login-card {
            background: rgba(10, 10, 12, 0.8);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 2.5rem;
            position: relative;
            z-index: 10;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.9);
            /* Entrance Animation */
            animation: cardEntrance 1s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        @keyframes cardEntrance {
            from { opacity: 0; transform: translateY(30px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* 4. Hovering Input Styles */
        .input-group {
            position: relative;
            transition: transform 0.3s ease;
        }

        .input-group:hover {
            transform: translateX(5px); /* Subtle slide on hover */
        }

        .obsidian-input {
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
            border-radius: 1.25rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 1.25rem 1.5rem 1.25rem 3.5rem;
        }

        .obsidian-input:focus {
            background: rgba(255, 255, 255, 0.07) !important;
            border-color: #6366f1 !important; /* Indigo glow */
            box-shadow: 0 0 30px rgba(99, 102, 241, 0.2);
            outline: none;
        }

        /* Icon Animation */
        .input-group i {
            position: absolute;
            left: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            color: #475569;
            transition: all 0.3s ease;
        }

        .input-group:focus-within i {
            color: #6366f1;
            transform: translateY(-50%) scale(1.2);
        }

        /* 5. The Liquid Button Animation */
        .btn-action {
            background: #ffffff;
            color: #000000;
            font-weight: 800;
            border-radius: 1.25rem;
            position: relative;
            overflow: hidden;
            transition: all 0.4s ease;
            z-index: 1;
        }

        .btn-action::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.2), transparent);
            transition: 0.5s;
            z-index: -1;
        }

        .btn-action:hover {
            letter-spacing: 2px;
            color: #6366f1;
            box-shadow: 0 10px 40px rgba(99, 102, 241, 0.3);
            transform: translateY(-2px);
        }

        .btn-action:hover::before {
            left: 100%;
        }

        /* Link Hovers */
        .hover-link {
            position: relative;
            color: #94a3b8;
            transition: color 0.3s ease;
        }
        .hover-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -2px;
            left: 0;
            background-color: #6366f1;
            transition: width 0.3s ease;
        }
        .hover-link:hover { color: #ffffff; }
        .hover-link:hover::after { width: 100%; }

    </style>
</head>

<body class="flex flex-col">

    <canvas id="snowCanvas"></canvas>

    <%- include('../partials/nav') %>

    <main class="flex-grow flex items-center justify-center px-6 py-12">
        <div class="w-full max-w-2xl mx-auto">
            
            <div class="login-card p-10 md:p-16">
                
                <div class="text-center mb-12">
                    <h1 class="text-5xl font-black tracking-tighter text-white uppercase italic">Prajamart</h1>
                    <div class="h-[1px] w-12 bg-indigo-500 mx-auto mt-4 mb-2"></div>
                    <p class="text-indigo-400/60 text-[10px] font-bold tracking-[0.4em] uppercase">Access Terminal</p>
                </div>

                <form action="/login" method="POST" class="space-y-8">
                    
                    <div class="space-y-3">
                        <label class="text-[11px] font-black text-slate-500 uppercase tracking-[0.2em] ml-1">Identity</label>
                        <div class="input-group">
                            <i class="fas fa-shield-alt"></i>
                            <input type="email" name="email" required
                                placeholder="name@prajamart.com"
                                class="obsidian-input w-full outline-none"
                            />
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="flex justify-between items-center px-1">
                            <label class="text-[11px] font-black text-slate-500 uppercase tracking-[0.2em]">Secret Key</label>
                            <a href="/forgot-password" class="hover-link text-[10px]">Forgot?</a>
                        </div>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" required
                                placeholder="••••••••"
                                class="obsidian-input w-full outline-none"
                            />
                        </div>
                    </div>

                    <button type="submit" class="btn-action w-full py-5 text-sm tracking-widest flex items-center justify-center gap-3">
                        INITIALIZE SESSION
                        <i class="fas fa-arrow-right text-xs"></i>
                    </button>

                    <div class="pt-8 text-center">
                        <p class="text-slate-500 text-xs font-medium">
                            First time here? 
                            <a href="/signup" class="hover-link text-white ml-2">Register Identity</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script>
        const canvas = document.getElementById('snowCanvas');
        const ctx = canvas.getContext('2d');
        let width, height, particles = [];

        function init() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;
            particles = [];
            
            const count = 150;
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    size: Math.random() * 2 + 0.5,
                    speed: Math.random() * 1.5 + 0.8,
                    opacity: Math.random() * 0.4 + 0.1,
                    sway: Math.random() * 2
                });
            }
        }

        function animate() {
            ctx.clearRect(0, 0, width, height);
            
            particles.forEach(p => {
                ctx.fillStyle = `rgba(255, 255, 255, ${p.opacity})`;
                ctx.beginPath();
                ctx.arc(p.x + Math.sin(p.sway) * 2, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();

                p.y += p.speed;
                p.sway += 0.01;

                if (p.y > height) {
                    p.y = -10;
                    p.x = Math.random() * width;
                }
            });
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', init);
        init();
        animate();
    </script>
</body>
</html>