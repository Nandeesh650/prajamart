<%- include('../partials/head') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="min-h-screen bg-gradient-to-br from-red-100 via-white to-red-50">

  <%- include('../partials/nav') %>

  <main class="min-h-[85vh] flex items-center justify-center px-6 py-10">
    
    <!-- Increased width for laptop -->
    <div class="w-full max-w-4xl mx-auto">
      
      <!-- Premium Card -->
      <div class="bg-white/90 backdrop-blur-xl shadow-2xl rounded-[2rem] overflow-hidden border border-white/40">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-600 via-red-500 to-red-700 px-10 py-8 text-center">
          <h1 class="text-4xl font-bold text-white tracking-wide">
            Welcome Back
          </h1>
          <p class="text-red-100 mt-2 text-base">
            Sign in to continue to Prajamart
          </p>
        </div>

        <!-- Form Body -->
        <div class="p-12">
          <form action="/login" method="POST" class="max-w-2xl mx-auto space-y-8">

            <% if (success) { %>
              <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700 shadow-sm">
                <%= success %>
              </div>
            <% } %>

            <% if (error) { %>
              <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 shadow-sm">
                <%= error %>
              </div>
            <% } %>

            <%- include('../partials/errors') %>

            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-700 mb-3">
                Email Address
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                  <i class="fas fa-envelope text-lg"></i>
                </span>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="your.email@example.com"
                  value="<%= oldInput.email ? oldInput.email : '' %>"
                  class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
                  required
                />
              </div>
            </div>

            <!-- Password -->
            <div>
              <div class="flex justify-between items-center mb-3">
                <label for="password" class="block text-sm font-semibold text-gray-700">
                  Password
                </label>
                <a href="/forgot-password" class="text-sm text-red-500 hover:text-red-600 hover:underline">
                  Forgot password?
                </a>
              </div>

              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                  <i class="fas fa-lock text-lg"></i>
                </span>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
                  required
                />
              </div>
            </div>

            <!-- Button -->
            <button
              type="submit"
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-red-600 to-red-500 text-white font-bold text-lg shadow-xl hover:shadow-2xl hover:scale-[1.02] transition duration-300 flex items-center justify-center"
            >
              <span>Sign In</span>
              <i class="fas fa-arrow-right ml-3"></i>
            </button>

            <!-- Divider -->
            <div class="flex items-center">
              <div class="flex-1 border-t border-gray-200"></div>
              <span class="px-4 text-sm text-gray-400">OR</span>
              <div class="flex-1 border-t border-gray-200"></div>
            </div>

            <!-- Signup -->
            <p class="text-center text-gray-600 text-base">
              Don’t have an account?
              <a href="/signup" class="text-red-500 font-semibold hover:underline">
                Create Account
              </a>
            </p>

          </form>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
