<%- include('../partials/head') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    /* 1. Soft Gradient Background */
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
    }

    /* 2. Floating Background Shapes */
    .shape {
        position: absolute;
        z-index: -1;
        filter: blur(80px);
        border-radius: 50%;
        animation: float 10s infinite alternate;
    }
    .shape-1 { width: 300px; height: 300px; background: #a1c4fd; top: -100px; left: -100px; }
    .shape-2 { width: 400px; height: 400px; background: #c2e9fb; bottom: -150px; right: -100px; }

    @keyframes float {
        from { transform: translate(0, 0); }
        to { transform: translate(30px, 50px); }
    }

    /* 3. Glassmorphic Card */
    .signup-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 2rem;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        animation: slideUp 0.6s ease-out;
    }

    .signup-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 30px 60px rgba(0,0,0,0.08);
    }

    @keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* 4. Inputs Style */
    .clean-input {
        background: white;
        border: 2px solid transparent;
        border-radius: 1rem;
        transition: all 0.3s ease;
        box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .clean-input:focus {
        border-color: #a1c4fd;
        box-shadow: 0 0 15px rgba(161, 196, 253, 0.3);
        outline: none;
    }

    /* 5. Button Style */
    .btn-execute {
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 1rem;
        transition: all 0.3s ease;
        border: none;
        box-shadow: 0 10px 20px rgba(118, 75, 162, 0.2);
    }

    .btn-execute:hover {
        transform: scale(1.02);
        box-shadow: 0 15px 25px rgba(118, 75, 162, 0.3);
    }

    /* Radio Tabs */
    .user-type-option {
        transition: all 0.2s ease;
    }
    input[type="radio"]:checked + span {
        color: #667eea;
        font-weight: bold;
    }
</style>
</head>

<body class="flex flex-col relative">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>

    <%- include('../partials/nav') %>

    <main class="min-h-screen flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-4xl mx-auto">
            
            <div class="signup-card p-8 md:p-12">
                <!-- Brand Header -->
                <div class="text-center mb-10">
                    <h1 class="text-4xl font-bold text-gray-800 tracking-tight">Join <span class="text-indigo-600">Prajamart</span></h1>
                    <p class="text-gray-500 mt-2">Create your account to get started</p>
                </div>

                <!-- Messages -->
                <% if (success) { %>
                    <div class="mb-6 p-4 bg-green-100 text-green-700 rounded-xl text-sm border border-green-200">
                        <%= success %>
                    </div>
                <% } %>

                <% if (error || (errors && errors.length > 0)) { %>
                    <div class="mb-6 p-4 bg-red-100 text-red-700 rounded-xl text-sm border border-red-200">
                        <% if (error) { %> <p><%= error %></p> <% } %>
                        <% if (errors) { errors.forEach(m => { %> <p>• <%= m %></p> <% })} %>
                    </div>
                <% } %>

                <form action="/signup" method="POST" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">First Name</label>
                            <input type="text" name="firstName" placeholder="John" 
                                   value="<%= locals.oldInput ? oldInput.firstName : '' %>"
                                   class="clean-input w-full px-5 py-3 text-gray-700"
                                   pattern="[A-Za-z\s]+" required data-letters-only />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">Last Name</label>
                            <input type="text" name="lastName" placeholder="Doe" 
                                   value="<%= locals.oldInput ? oldInput.lastName : '' %>"
                                   class="clean-input w-full px-5 py-3 text-gray-700"
                                   pattern="[A-Za-z\s]+" data-letters-only />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">Email</label>
                            <input type="email" name="email" placeholder="john@example.com" 
                                   value="<%= locals.oldInput ? oldInput.email : '' %>"
                                   class="clean-input w-full px-5 py-3 text-gray-700" required />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">Phone</label>
                            <input type="tel" name="phoneNumber" placeholder="10 Digit Number" 
                                   value="<%= locals.oldInput ? oldInput.phoneNumber : '' %>"
                                   class="clean-input w-full px-5 py-3 text-gray-700"
                                   pattern="[0-9]{10}" maxlength="10" required data-phone-only />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">Password</label>
                            <input type="password" name="password" placeholder="••••••••" 
                                   class="clean-input w-full px-5 py-3 text-gray-700" required />
                        </div>
                        <div class="space-y-2">
                            <label class="text-xs font-semibold text-gray-400 uppercase ml-1">Confirm Password</label>
                            <input type="password" name="confirmPassword" placeholder="••••••••" 
                                   class="clean-input w-full px-5 py-3 text-gray-700" required />
                        </div>
                    </div>

                    <div class="bg-gray-50/50 p-6 rounded-2xl border border-gray-100">
                        <p class="text-xs font-bold text-gray-400 uppercase mb-4">Account Type</p>
                        <div class="flex flex-wrap gap-6">
                            <label class="flex items-center cursor-pointer user-type-option">
                                <input type="radio" name="userType" value="guest" class="w-4 h-4 text-indigo-600"
                                    <%= locals.oldInput && oldInput.userType === 'guest' || (!locals.oldInput) ? 'checked' : '' %>>
                                <span class="ml-2 text-sm text-gray-600">Guest</span>
                            </label>
                            <label class="flex items-center cursor-pointer user-type-option">
                                <input type="radio" name="userType" value="host" class="w-4 h-4 text-indigo-600"
                                    <%= locals.oldInput && oldInput.userType === 'host' ? 'checked' : '' %>>
                                <span class="ml-2 text-sm text-gray-600">Host</span>
                            </label>
                            <label class="flex items-center cursor-pointer user-type-option">
                                <input type="radio" name="userType" value="deliveryboy" class="w-4 h-4 text-indigo-600"
                                    <%= locals.oldInput && oldInput.userType === 'deliveryboy' ? 'checked' : '' %>>
                                <span class="ml-2 text-sm text-gray-600">Delivery Boy</span>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center px-1">
                        <input type="checkbox" name="terms" required class="rounded text-indigo-600">
                        <span class="ml-3 text-xs text-gray-500">I agree to the <a href="#" class="text-indigo-600 underline">Terms of Service</a></span>
                    </div>

                    <button type="submit" class="btn-execute w-full py-4 font-bold text-white uppercase tracking-wider">
                        Create Account
                    </button>

                    <p class="text-center text-gray-500 text-sm">
                        Already have an account? 
                        <a href="/login" class="text-indigo-600 font-bold hover:underline ml-1">Login</a>
                    </p>
                </form>
            </div>
        </div>
    </main>

    <script>
        // Data sanitization logic
        document.querySelectorAll('[data-letters-only]').forEach((input) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/[^A-Za-z\s]/g, '');
            });
        });

        const phoneInput = document.querySelector('[data-phone-only]');
        if (phoneInput) {
            phoneInput.addEventListener('input', () => {
                phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 10);
            });
        }
    </script>
</body>
</html>