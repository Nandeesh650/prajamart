<%- include('../partials/head') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="min-h-screen bg-gradient-to-br from-red-100 via-white to-red-50">

  <%- include('../partials/nav') %>

  <main class="min-h-[85vh] flex items-center justify-center px-6 py-10">
    
    <!-- Wide laptop container -->
    <div class="w-full max-w-5xl mx-auto">
      
      <!-- Premium Card -->
      <div class="bg-white/90 backdrop-blur-xl shadow-2xl rounded-[2rem] overflow-hidden border border-white/40">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-600 via-red-500 to-red-700 px-10 py-8 text-center">
          <h1 class="text-4xl font-bold text-white tracking-wide">
            Create Your Account
          </h1>
          <p class="text-red-100 mt-2 text-base">
            Join Prajamart and start your journey
          </p>
        </div>

        <!-- Form -->
        <div class="p-12">
          <form action="/signup" method="POST" class="max-w-4xl mx-auto space-y-6">

            <% if (success) { %>
              <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700 shadow-sm">
                <%= success %>
              </div>
            <% } %>

            <% if (error) { %>
              <div class="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 shadow-sm">
                <%= error %>
              </div>
            <% } %>

            <%- include('../partials/errors') %>

            <!-- Name Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  First Name
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-user"></i>
                  </span>
                  <input
                    type="text"
                    name="firstName"
                    placeholder="John"
                    value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                    required
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  Last Name
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-user"></i>
                  </span>
                  <input
                    type="text"
                    name="lastName"
                    placeholder="Doe"
                    value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                  />
                </div>
              </div>
            </div>

            <!-- Email + Phone -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  Email
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-envelope"></i>
                  </span>
                  <input
                    type="email"
                    name="email"
                    placeholder="your.email@example.com"
                    value="<%= oldInput.email ? oldInput.email : '' %>"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                    required
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  Phone Number
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-phone"></i>
                  </span>
                  <input
                    type="tel"
                    name="phoneNumber"
                    placeholder="9876543210"
                    maxlength="10"
                    value="<%= oldInput.phoneNumber ? oldInput.phoneNumber : '' %>"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- Password -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  Password
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-lock"></i>
                  </span>
                  <input
                    type="password"
                    name="password"
                    placeholder="Enter password"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                    required
                  />
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                  Confirm Password
                </label>
                <div class="relative">
                  <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                    <i class="fas fa-lock"></i>
                  </span>
                  <input
                    type="password"
                    name="confirmPassword"
                    placeholder="Confirm password"
                    class="w-full pl-12 pr-4 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:ring-2 focus:ring-red-500 focus:outline-none"
                    required
                  />
                </div>
              </div>
            </div>

            <!-- User Type -->
            <div class="p-6 bg-gray-50 rounded-2xl border border-gray-200">
              <p class="text-sm font-semibold text-gray-700 mb-4">
                Register as
              </p>

              <div class="flex flex-wrap gap-6">
                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="userType" value="guest"
                    class="text-red-500 focus:ring-red-500"
                    <%= oldInput.userType === 'guest' || !oldInput.userType ? 'checked' : '' %>>
                  <span class="ml-2">Guest</span>
                </label>

                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="userType" value="host"
                    class="text-red-500 focus:ring-red-500"
                    <%= oldInput.userType === 'host' ? 'checked' : '' %>>
                  <span class="ml-2">Host</span>
                </label>

                <label class="flex items-center cursor-pointer">
                  <input type="radio" name="userType" value="deliveryboy"
                    class="text-red-500 focus:ring-red-500"
                    <%= oldInput.userType === 'deliveryboy' ? 'checked' : '' %>>
                  <span class="ml-2">Delivery Boy</span>
                </label>
              </div>
            </div>

            <!-- Terms -->
            <div>
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" name="terms" required
                  class="text-red-500 focus:ring-red-500">
                <span class="ml-3 text-gray-700">
                  I agree to the
                  <a href="#" class="text-red-500 hover:underline">
                    terms and conditions
                  </a>
                </span>
              </label>
            </div>

            <!-- Button -->
            <button
              type="submit"
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-red-600 to-red-500 text-white font-bold text-lg shadow-xl hover:shadow-2xl hover:scale-[1.02] transition duration-300"
            >
              Register Now
            </button>

            <!-- Login -->
            <p class="text-center text-gray-600">
              Already have an account?
              <a href="/login" class="text-red-500 font-semibold hover:underline">
                Log in
              </a>
            </p>

          </form>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
