<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-gradient-to-br from-red-100 via-white to-red-50">

  <%- include('../partials/nav') %>

  <main class="min-h-[85vh] flex items-center justify-center px-6 py-10">
    
    <!-- Wide Container -->
    <div class="w-full max-w-4xl mx-auto">
      
      <!-- Premium Card -->
      <div class="bg-white/90 backdrop-blur-xl shadow-2xl rounded-[2rem] overflow-hidden border border-white/40">
        
        <!-- Header -->
        <div class="bg-gradient-to-r from-red-600 via-red-500 to-red-700 px-10 py-8 text-center">
          <h1 class="text-4xl font-bold text-white tracking-wide">
            Reset Password
          </h1>
          <p class="text-red-100 mt-2 text-base">
            Secure your account with a new password
          </p>
        </div>

        <!-- Content -->
        <div class="p-12">
          <div class="mx-auto max-w-2xl">

            <% if (success) { %>
              <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700 shadow-sm">
                <%= success %>
              </div>
            <% } %>

            <% if (error) { %>
              <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700 shadow-sm">
                <%= error %>
              </div>
            <% } %>

            <%- include('../partials/errors') %>

            <% if (!isTokenValid) { %>
              
              <!-- Invalid Token UI -->
              <div class="rounded-2xl border border-slate-200 bg-slate-50 px-6 py-5 text-center text-sm text-slate-700 shadow-sm">
                This reset link cannot be used anymore. Please request a new one.
              </div>

              <a
                href="/forgot-password"
                class="mt-6 inline-block w-full rounded-2xl bg-gradient-to-r from-red-600 to-red-500 py-4 text-center font-semibold text-white shadow-lg transition duration-300 hover:shadow-xl hover:scale-[1.01]"
              >
                Request New Link
              </a>

            <% } else { %>

              <!-- Instruction -->
              <p class="mb-8 text-center text-gray-600 text-lg">
                Enter your new password below
              </p>

              <!-- Form -->
              <form action="/reset-password" method="POST" class="space-y-6">
                <input type="hidden" name="token" value="<%= token %>">

                <!-- New Password -->
                <div>
                  <label for="password" class="mb-2 block text-sm font-semibold text-gray-700">
                    New Password
                  </label>
                  <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your new password"
                    class="w-full rounded-2xl border border-gray-200 bg-gray-50 px-5 py-4 shadow-sm transition focus:border-red-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
                    required
                  />
                </div>

                <!-- Confirm Password -->
                <div>
                  <label for="confirmPassword" class="mb-2 block text-sm font-semibold text-gray-700">
                    Confirm Password
                  </label>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    placeholder="Confirm your new password"
                    class="w-full rounded-2xl border border-gray-200 bg-gray-50 px-5 py-4 shadow-sm transition focus:border-red-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-red-500"
                    required
                  />
                </div>

                <!-- Button -->
               <button
                  type="submit"
                  class="w-full rounded-2xl bg-gradient-to-r from-red-600 to-red-500 py-4 text-lg font-bold text-white shadow-xl transition duration-300 hover:shadow-2xl hover:scale-[1.02]"
                >
                  Save New Password
              </button>
              </form>

            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>

</body>
</html>
