<%- include('../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root { --brand-indigo: #4f46e5; --brand-glow: rgba(79, 70, 229, 0.4); }
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #fcfcfd; overflow-x: hidden; }

  @keyframes ultraReveal {
    0% { opacity: 0; transform: translateY(40px); filter: blur(10px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .animate-reveal { opacity: 0; animation: ultraReveal 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }

  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .dropdown-menu {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    transform-origin: top;
    opacity: 0; transform: translateY(10px) scale(0.95); pointer-events: none;
  }
  .group.open .dropdown-menu { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }

  /* Premium Hover for the Button Container */
  .plus-glow-container { transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .product-card:hover .plus-glow-container {
    transform: rotate(360deg) scale(1.1);
    background-color: var(--brand-indigo);
    box-shadow: 0 0 30px var(--brand-glow);
  }

  /* GPS Loading State */
  .loc-loading { animation: pulse 1.5s infinite; opacity: 0.6; pointer-events: none; }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(0.95); } }
</style>

<body class="antialiased text-slate-900">
  <%- include('../partials/nav') %>

  <main class="max-w-[1536px] mx-auto px-6 py-12 lg:px-12">
    <div class="mb-16 text-center animate-reveal" style="animation-delay: 100ms;">
      <h1 class="text-7xl md:text-9xl font-[900] tracking-tighter text-slate-950">
        Praja<span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">Mart.</span>
      </h1>
    </div>

    <div class="animate-reveal max-w-6xl mx-auto mb-24 space-y-4" style="animation-delay: 200ms;">
      <form id="search-form" action="/products" method="GET" class="glass-card rounded-[3rem] p-3 shadow-2xl">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-[2fr_1.2fr_auto_auto]">
          
          <div class="relative flex items-center bg-slate-100/60 rounded-full px-8">
            <input type="text" name="query" value="<%= searchQuery || '' %>" placeholder="Search collection..." class="w-full bg-transparent py-5 outline-none font-bold text-slate-800">
          </div>
          
          <div class="relative group" id="location-dropdown-wrapper">
            <div class="relative flex items-center h-full bg-slate-100/60 rounded-full cursor-pointer px-8" id="dropdown-trigger">
              <span class="flex-grow text-slate-700 text-sm font-bold truncate" id="selected-display"><%= selectedLocation || 'All locations' %></span>
              <svg class="h-4 w-4 text-slate-400 group-[.open]:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-width="3" d="M19 9l-7 7-7-7" /></svg>
            </div>
            <input type="hidden" name="location" id="hidden-location-input" value="<%= selectedLocation || '' %>">
            <div class="dropdown-menu absolute top-[calc(100%+12px)] left-0 w-full z-[110]">
              <div class="glass-card rounded-[2.5rem] p-2 max-h-60 overflow-y-auto shadow-2xl">
                <div class="dropdown-item px-6 py-4 rounded-2xl text-sm font-bold text-slate-600 hover:bg-indigo-600 hover:text-white cursor-pointer" data-value="">All locations</div>
                <% locationOptions.forEach(function(opt) { %>
                  <div class="dropdown-item px-6 py-4 rounded-2xl text-sm font-bold text-slate-600 hover:bg-indigo-600 hover:text-white cursor-pointer" data-value="<%= opt %>"><%= opt %></div>
                <% }) %>
              </div>
            </div>
          </div>

          <button type="button" onclick="findNearMe()" id="gps-btn" class="h-16 w-16 flex items-center justify-center rounded-full bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white transition-all shadow-sm" title="Find Products Near Me">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
          </button>

          <button type="submit" class="rounded-full bg-slate-950 px-12 py-5 font-black text-xs uppercase tracking-widest text-white hover:bg-indigo-600 hover:scale-105 active:scale-95 transition-all">Explore</button>
        </div>
      </form>
      
      <% if (locals.hasLocation) { %>
        <div class="text-center">
          <a href="/products" class="text-[10px] font-black uppercase tracking-widest text-indigo-600 hover:underline">× Clear Distance Filter</a>
        </div>
      <% } %>
    </div>

    <div class="grid grid-cols-1 gap-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% if (registeredProducts && registeredProducts.length > 0) { %>
        <% registeredProducts.forEach((product, index) => { %>
          <div class="animate-reveal" style="animation-delay: <%= 300 + (index * 75) %>ms;">
            <div class="product-card group relative flex flex-col bg-white rounded-[3.5rem] p-5 shadow-sm hover:shadow-2xl hover:-translate-y-6 transition-all duration-700">
              
              <div class="relative aspect-[2/3] overflow-hidden rounded-[2.8rem] bg-slate-50 border border-slate-100/30">
                <img src="/<%= (product.photos && product.photos.length > 0) ? product.photos[0] : (product.photo || 'images/placeholder.jpg') %>" 
                     class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-110">
                
                <div class="absolute top-6 left-6 glass-card px-5 py-2 rounded-full text-[10px] font-black uppercase tracking-widest shadow-sm border border-white/40">
                  <%= product.location || 'GLOBAL' %>
                </div>
                
                <% if (product.dist) { %>
                   <div class="absolute bottom-6 right-6 glass-card bg-emerald-500/90 text-white px-4 py-1.5 rounded-full text-[10px] font-black shadow-lg">
                     <%= (product.dist / 1000).toFixed(1) %> km away
                   </div>
                <% } %>
              </div>

              <div class="pt-12 pb-6 px-4 flex flex-col flex-grow">
                <h2 class="font-[800] text-3xl text-slate-950 tracking-tighter truncate mb-14 group-hover:text-indigo-600 transition-colors">
                  <%= product.productName %>
                </h2>
                
                <div class="mt-auto flex items-center justify-between pt-8 border-t border-slate-100 relative">
                  <div class="flex flex-col">
                    <span class="text-slate-400 text-[10px] font-bold uppercase tracking-widest">Price</span>
                    <div class="flex items-baseline text-slate-950">
                      <span class="text-sm font-bold mr-0.5">₹</span>
                      <span class="text-4xl font-[900] tracking-tighter">
                        <%= Number(product.price).toLocaleString('en-IN') %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="plus-glow-container relative z-20 h-20 w-20 flex items-center justify-center bg-slate-950 rounded-[2.2rem] text-white">
                     <%- include('../partials/cart', { product: product }) %>
                  </div>
                </div>
              </div>

              <a href="/products/<%= product._id %>" class="absolute inset-0 z-10 rounded-[3.5rem]"></a>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-32 text-center" data-aos="fade-up">
            <h3 class="text-2xl font-black text-slate-300 uppercase tracking-[0.2em]">No Results Found</h3>
            <p class="text-slate-400 mt-2">Try adjusting your filters or location.</p>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    // --- DROPDOWN LOGIC ---
    const dropdownWrapper = document.getElementById('location-dropdown-wrapper');
    const trigger = document.getElementById('dropdown-trigger');
    const items = document.querySelectorAll('.dropdown-item');
    const display = document.getElementById('selected-display');
    const hiddenInput = document.getElementById('hidden-location-input');
    const searchForm = document.getElementById('search-form');

    trigger.addEventListener('click', (e) => { 
      e.stopPropagation(); 
      dropdownWrapper.classList.toggle('open'); 
    });

    items.forEach(item => {
      item.addEventListener('click', () => {
        const val = item.getAttribute('data-value');
        display.innerText = item.innerText;
        hiddenInput.value = val;
        dropdownWrapper.classList.remove('open');
        searchForm.submit();
      });
    });

    // --- GPS LOGIC ---
    function findNearMe() {
      const gpsBtn = document.getElementById('gps-btn');
      gpsBtn.classList.add('loc-loading');

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            window.location.href = `/products?lat=${lat}&lng=${lng}`;
          },
          (err) => {
            alert("Please allow location access to find nearby products.");
            gpsBtn.classList.remove('loc-loading');
          }
        );
      } else {
        alert("Your browser doesn't support GPS search.");
      }
    }

    window.addEventListener('click', () => dropdownWrapper.classList.remove('open'));
  </script>
</body>
</html>