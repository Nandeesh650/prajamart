<%- include('../partials/head') %>
</head>

<body class="bg-gray-100 min-h-screen">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <main class="px-6 py-10 bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">

    <!-- Heading -->
    <h1 class="text-4xl font-extrabold text-center mb-10 text-gray-800">
      🛍️ Welcome to Prajamart
    </h1>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

      <% if (registeredProducts && registeredProducts.length > 0) { %>

        <% registeredProducts.forEach(product => { %>

          <!-- Premium Product Card -->
          <div class="bg-white rounded-3xl shadow-md hover:shadow-2xl 
                      transition-all duration-300 hover:-translate-y-3 
                      group overflow-hidden">

            <!-- Product Image -->
            <div class="h-60 bg-white flex items-center justify-center p-6">
              <img 
                src="<%= product.photo %>"
                alt="<%= product.productName %>"
                class="h-full object-contain group-hover:scale-110 transition duration-500"
              >
            </div>

            <!-- Content -->
            <div class="p-5 text-center">

              <!-- Product Name -->
              <h2 class="text-lg font-semibold text-gray-800 tracking-wide truncate">
                <%= product.productName %>
              </h2>

              <!-- Price -->
              <p class="text-orange-500 text-2xl font-bold mt-2">
                ₹ <%= Number(product.price).toFixed(2) %>
              </p>

              <!-- Stars -->
              <div class="flex justify-center mt-2 text-yellow-400 text-lg">
                <% let stars = product.rating?.stars || product.rating || 0; %>
                <% for (let i = 1; i <= 5; i++) { %>
                  <span><%= i <= stars ? '★' : '☆' %></span>
                <% } %>
              </div>

              <!-- Reviews -->
              <p class="text-gray-400 text-sm mt-1">
                (<%= product.rating?.count || 0 %> reviews)
              </p>

              <!-- Buttons -->
              <div class="flex gap-3 mt-5">

                <!-- Add to Cart -->
                <div class="w-full">
                  <%- include('../partials/cart', { product: product }) %>
                </div>

                <!-- View -->
                <a href="/products/<%= product._id %>"
                   class="w-full text-center py-2.5 rounded-xl 
                          bg-gray-100 font-medium text-gray-700
                          hover:bg-gray-200 hover:shadow-md
                          transition duration-300">
                  View
                </a>

              </div>

            </div>

          </div>

        <% }) %>

      <% } else { %>

        <p class="col-span-4 text-center text-gray-500 text-lg">
          No products available 😔
        </p>

      <% } %>

    </div>

  </main>

</body>
</html>
