<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <%- include('../partials/sideposter') %>

  <main class="px-6 py-10 bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">

    <!-- HEADING -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-800 tracking-wide">
        Welcome to Prajamart
      </h1>
      <p class="text-gray-500 mt-2 text-lg">
        Explore our premium collection
      </p>
    </div>

    <!-- PRODUCT GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

      <% if (registeredProducts && registeredProducts.length > 0) { %>

        <% registeredProducts.forEach(product => { %>
          <a href="/products/<%= product._id %>" class="group block">

            <!-- PREMIUM CARD -->
            <div class="bg-white rounded-3xl shadow-md
                        hover:shadow-2xl hover:-translate-y-3
                        transition-all duration-300 overflow-hidden border border-gray-100">

              <!-- IMAGE -->
              <div class="relative overflow-hidden bg-white h-64">
                <img src="<%= product.photo %>"
                     alt="<%= product.productName %>"
                     class="w-full h-full object-contain
                            transition-transform duration-500
                            group-hover:scale-110">

                <!-- PREMIUM BADGE -->
                <span class="absolute top-3 left-3 bg-black text-white text-xs px-3 py-1 rounded-full shadow-md">
                  PREMIUM
                </span>

                <!-- DISCOUNT BADGE -->
                <span class="absolute top-3 right-3 bg-gradient-to-r from-red-500 to-pink-500 text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md">
                  25% OFF
                </span>
              </div>

              <!-- PRODUCT NAME -->
              <div class="p-5 text-center">
                <h2 class="font-semibold text-lg text-gray-800 tracking-wide
                           group-hover:text-black transition">
                  <%= product.productName %>
                </h2>
              </div>

            </div>
          </a>
        <% }) %>

      <% } else { %>

        <div class="col-span-4 text-center py-20">
          <p class="text-gray-500 text-xl">
            No products available 😔
          </p>
        </div>

      <% } %>

    </div>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
