<%- include('../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  body { 
    font-family: 'Plus Jakarta Sans', sans-serif; 
    background-color: #fcfcfd;
    overflow-x: hidden;
  }
  
  /* Glassmorphism */
  .glass-ui {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  /* Keyframes for Luxury Entrance */
  @keyframes revealCard {
    0% { opacity: 0; transform: translateY(60px) scale(0.95); filter: blur(10px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  .animate-card {
    opacity: 0;
    animation: revealCard 1s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  /* Shimmer effect for badges */
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .shimmer-badge::after {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    animation: shimmer 2s infinite;
  }
</style>
</head>

<body class="antialiased text-slate-900">
  <%- include('../partials/nav') %>
  <%- include('../partials/sideposter') %>

  <main class="max-w-[1440px] mx-auto px-6 py-16 lg:px-12">

    <div class="mb-20 animate-card" style="animation-delay: 50ms;">
      <div class="flex items-center gap-3 mb-4 group cursor-default">
        <span class="h-[2px] w-12 bg-indigo-600 transition-all duration-500 group-hover:w-20"></span>
        <span class="text-[11px] font-bold tracking-[0.3em] text-indigo-600 uppercase">Premium Selection</span>
      </div>
      <h1 class="text-6xl md:text-7xl font-[800] text-slate-950 tracking-tighter leading-[1.1] mb-6">
        Curated for <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 via-purple-500 to-pink-500 animate-gradient-x">Prajamart.</span>
      </h1>
      <p class="text-slate-500 text-lg md:text-xl max-w-xl font-medium leading-relaxed">
        Experience a new era of shopping with animations that respond to your touch and products that define quality.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-12">

      <% if (registeredProducts && registeredProducts.length > 0) { %>
        <% registeredProducts.forEach((product, index) => { %>
          <a href="/products/<%= product._id %>" 
             class="group block animate-card" 
             style="animation-delay: <%= 150 + (index * 80) %>ms;">

            <div class="relative h-full flex flex-col bg-white rounded-[2.8rem] p-4 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.05)] 
                        hover:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.12)] hover:-translate-y-6 
                        transition-all duration-700 ease-[cubic-bezier(0.15,0.85,0.35,1)]">

              <div class="relative aspect-[4/5] overflow-hidden rounded-[2.2rem] bg-zinc-100">
                <img src="<%= product.photo %>"
                     alt="<%= product.productName %>"
                     class="w-full h-full object-cover transition-transform duration-[2s] 
                            ease-[cubic-bezier(0.2,1,0.3,1)] group-hover:scale-125 group-hover:rotate-2">

                <div class="absolute inset-0 p-6 flex flex-col justify-between pointer-events-none">
                  <div class="flex justify-between items-start">
                    <span class="glass-ui shimmer-badge overflow-hidden text-[9px] font-black text-slate-900 px-4 py-2 rounded-full shadow-lg uppercase tracking-widest relative">
                      Premium
                    </span>
                  </div>
                  
                  <div class="self-center opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-500">
                     <span class="glass-ui px-6 py-2.5 rounded-2xl text-[11px] font-bold text-slate-800 shadow-xl border border-white/50 uppercase tracking-tighter">
                        Discover
                     </span>
                  </div>
                </div>
              </div>

              <div class="pt-10 pb-4 px-4 flex flex-col justify-between flex-grow">
                <div class="space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-indigo-500 animate-pulse"></span>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-[0.3em]">Signature Series</p>
                  </div>
                  <h2 class="font-extrabold text-2xl text-slate-900 group-hover:text-indigo-600 transition-colors duration-300 tracking-tight leading-none">
                    <%= product.productName %>
                  </h2>
                </div>

                <div class="mt-10 flex items-center justify-between pt-8 border-t border-slate-50">
                  <div class="flex flex-col">
                    <div class="flex items-baseline">
                      <span class="text-sm font-bold text-slate-900 mr-1">₹</span>
                      <span class="text-3xl font-black text-slate-950 tracking-tighter">
                        <%= product.price %>
                      </span>
                    </div>
                  </div>
                  
                  <div class="h-16 w-16 rounded-[1.8rem] bg-slate-950 text-white flex items-center justify-center 
                              group-hover:bg-indigo-600 group-hover:shadow-[0_20px_40px_rgba(79,70,229,0.4)] 
                              group-hover:rotate-[360deg] transition-all duration-1000 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                    </svg>
                  </div>
                </div>
              </div> 

            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-40 animate-pulse flex flex-col items-center justify-center text-center bg-white rounded-[4rem] border border-dashed border-slate-200">
          <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mb-6">
            <span class="text-5xl">🛍️</span>
          </div>
          <h3 class="text-3xl font-black text-slate-900 tracking-tighter">Preparing the Collection</h3>
          <p class="text-slate-500 mt-3 font-medium">New premium arrivals are being added right now.</p>
        </div>
      <% } %>

    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>