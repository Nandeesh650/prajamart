<%- include('../partials/head') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  /* Custom style for selected size chips */
  .size-chip-radio:checked + .size-chip-label {
    background-color: #ef4444; /* red-600 */
    color: white;
    border-color: #ef4444;
    transform: scale(1.05);
  }

  /* Smooth transition for the modal */
  #orderModal:not(.hidden) {
    display: flex;
  }
</style>
</head>

<body class="bg-white min-h-screen">

<%- include('../partials/nav') %>

<main class="max-w-7xl mx-auto px-8 py-10">

  <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">

    <!-- Product Image -->
    <div class="bg-white flex justify-center items-center h-[560px] p-10 border-b border-gray-100">
      <img src="/<%= product.photo %>"
           alt="<%= product.productName %>"
           class="max-h-[470px] object-contain hover:scale-105 transition duration-500">
    </div>

    <!-- Product Info -->
    <div class="p-10">
      <h1 class="text-4xl font-semibold text-gray-900 tracking-wide">
        <%= product.productName %>
      </h1>

      <div class="flex items-center gap-3 mt-5">
        <span class="bg-green-600 text-white px-4 py-1 rounded-md text-sm font-semibold shadow-sm">
          <%= product.rating?.stars || product.rating || 0 %> ★
        </span>
        <span class="text-gray-500 text-lg">
          <%= product.rating?.count || 0 %> Ratings & Reviews
        </span>
      </div>

      <div class="mt-6">
        <span class="text-5xl font-bold text-black">₹<%= product.price %></span>
        <span class="ml-4 text-gray-400 line-through text-2xl">₹<%= (product.price + (product.price * 0.25)).toFixed(0) %></span>
        <span class="ml-4 text-green-600 font-semibold text-xl">25% off</span>
      </div>

      <div class="mt-6 bg-gray-50 p-5 rounded-xl border border-gray-100">
        <p class="text-gray-700 font-medium text-lg">🚚 Free delivery by Tomorrow</p>
      </div>

      <div class="mt-8">
        <h2 class="text-2xl font-semibold mb-4 text-gray-900">Product Details</h2>
        <p class="text-gray-600 leading-8 text-lg"><%= product.description %></p>
      </div>

      <!-- Add to Cart & Order Buttons -->
      <div class="flex justify-center items-center gap-5 mt-10">
        <form action="/cart" method="POST">
          <input type="hidden" name="productId" value="<%= product._id %>">
          <button class="px-10 py-3 rounded-full bg-yellow-400 text-black font-semibold shadow-md hover:bg-yellow-500 transition-all duration-300">
            🛒 Add to Cart
          </button>
        </form>

        <% if (isLoggedIn) { %>
          <button onclick="toggleOrderModal(true)" class="px-10 py-3 rounded-full bg-red-600 text-white font-semibold shadow-md hover:bg-red-700 transition-all duration-300">
            🛍️ Order Now
          </button>
        <% } else { %>
          <a href="/login" class="px-10 py-3 rounded-full bg-red-600 text-white font-semibold shadow-md inline-block">🛍️ Order Now</a>
        <% } %>
      </div>

      <!-- Order Modal -->
      <div id="orderModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 overflow-y-auto py-8">
        <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4 my-auto max-h-[90vh] overflow-y-auto">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Place Order</h2>
            <button onclick="toggleOrderModal(false)" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
          </div>

          <form action="/orders/create" method="POST" class="space-y-6" id="orderFormDetail" onsubmit="return validateAndSubmitOrder(event)">
            <!-- Single item hidden fields -->
            <input type="hidden" name="items[0][productId]" value="<%= product._id %>">
            <input type="hidden" name="items[0][size]" id="itemSize">
            <input type="hidden" name="items[0][quantity]" id="itemQuantity">

            <!-- Size Selection -->
            <% if(product.availableSizes && product.availableSizes.length > 0) { %>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-3">Select Size</label>
              <div class="flex flex-wrap gap-3">
                <% product.availableSizes.forEach(size => { %>
                  <label class="relative cursor-pointer">
                    <input type="radio" name="size" value="<%= size %>" class="hidden size-chip-radio" <%= size === 'M' ? 'checked' : '' %>>
                    <span class="size-chip-label flex items-center justify-center w-12 h-12 border-2 border-gray-200 rounded-xl font-bold text-gray-600 transition-all duration-200 hover:border-red-400">
                      <%= size %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </div>
            <% } %>

            <!-- Quantity -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Quantity</label>
              <input type="number" id="quantityInput" name="quantityDisplay" min="1" max="10" value="1" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500">
            </div>

            <!-- Location Picker -->
            <%- include('../partials/order-location-picker') %>

            <!-- Notes -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Special Instructions</label>
              <textarea name="notes" placeholder="Any notes..." class="w-full px-4 py-2 border border-gray-300 rounded-lg" rows="2"></textarea>
            </div>

            <!-- Payment Method -->
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
              <label class="block text-sm font-bold text-gray-700 mb-3">💳 Payment Method</label>

              <label class="flex items-center mb-3 cursor-pointer">
                <input type="radio" name="paymentMethod" value="cod" checked class="w-4 h-4 text-red-600">
                <span class="ml-3 text-sm font-semibold text-gray-800">Cash on Delivery (COD)</span>
              </label>

              <label class="flex items-center cursor-pointer">
                <input type="radio" name="paymentMethod" value="upi" class="w-4 h-4 text-red-600">
                <span class="ml-3 text-sm font-semibold text-gray-800">Online UPI</span>
              </label>

              <div id="upiContainerDetail" class="mt-3 hidden">
                <input type="text" name="upiId" placeholder="Enter UPI ID" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              </div>
            </div>

            <!-- Total Amount -->
            <div class="bg-red-600 p-5 rounded-2xl shadow-lg">
              <div class="flex justify-between items-center text-white">
                <span class="font-bold uppercase text-xs opacity-80">Total Payable</span>
                <span class="text-3xl font-black">₹<span id="totalAmount"><%= product.price %></span></span>
              </div>
            </div>

            <!-- Buttons -->
            <div class="flex gap-3">
              <button type="button" onclick="toggleOrderModal(false)" class="flex-1 py-3 rounded-xl bg-gray-100 text-gray-800 font-bold">Cancel</button>
              <button type="submit" class="flex-1 py-3 rounded-xl bg-red-600 text-white font-bold shadow-lg">Confirm Order</button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/order-location-picker.js"></script>
<script>
  function toggleOrderModal(shouldOpen) {
    const modal = document.getElementById('orderModal');
    modal.classList.toggle('hidden', !shouldOpen);
    if (shouldOpen && window.refreshOrderLocationPickers) {
      setTimeout(() => window.refreshOrderLocationPickers(), 150);
    }
  }

  // Update total price dynamically
  const basePrice = <%= product.price %>;
  const quantityInput = document.getElementById('quantityInput');
  const totalAmount = document.getElementById('totalAmount');

  quantityInput.addEventListener('input', () => {
    const qty = parseInt(quantityInput.value) || 1;
    totalAmount.textContent = (basePrice * qty).toLocaleString('en-IN');
  });

  // Toggle UPI input field visibility
  document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
      document.getElementById('upiContainerDetail').classList.toggle('hidden', e.target.value !== 'upi');
    });
  });

  // Validate & submit order
  function validateAndSubmitOrder(event) {
    event.preventDefault();
    const form = document.getElementById('orderFormDetail');

    const size = form.querySelector('input[name="size"]:checked')?.value;
    const quantity = parseInt(quantityInput.value) || 1;

    if (!size) {
      alert('Please select a size.');
      return false;
    }

    // Set hidden inputs for backend
    document.getElementById('itemSize').value = size;
    document.getElementById('itemQuantity').value = quantity;

    // Location validation
    if (window.validateOrderLocation && !window.validateOrderLocation(form)) {
      return false;
    }

    form.submit();
  }
</script>

</body>
</html>
