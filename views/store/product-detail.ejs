<%- include('../partials/head') %>
  </head>
  <body>
      <%- include('../partials/nav') %>
      <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl">
          <h2 class="text-3xl text-red-500 font-bold text-center mb-6">
              Product details: <%= product.productName %>
          </h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="rounded-lg overflow-hidden">
                  <img src="<%= product.photo %>" alt="<%= product.productName %>" class="w-full h-96 object-cover">
              </div>
              
              <div class="space-y-6">
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Description</h3>
                      <p class="text-gray-600"><%= product.description %></p>
                  </div>
                  </div>
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Price</h3>
                      <p class="text-green-600 text-xl font-bold">$<%= product.price %> / night</p>
                  </div>
                  
                  <div class="border-b pb-4">
                      <h3 class="text-2xl font-semibold mb-2">Rating</h3>
                      <div class="flex items-center">
                          <span class="text-yellow-400 text-xl">★</span>
                          <span class="ml-2 text-lg"><%= product.rating && product.rating.stars !== undefined ? product.rating.stars : product.rating %> / 5</span>
                      </div>
                      <p class="text-gray-500 text-sm">(<%= product.rating && product.rating.count !== undefined ? product.rating.count : 0 %> reviews)</p>
                  </div>
                  <div class="mt-2">
                    <%- include('../partials/cart', {product: product}) %>
                  </div>
              </div>
          </div>
      </main>
  </body>
</html>
