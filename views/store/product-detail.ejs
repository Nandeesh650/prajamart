<%- include('../partials/head') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  /* --- 1. CLEAN WHITE HERO STAGE --- */
  .hero-viewer {
    position: relative;
    width: 100%;
    height: 95vh;
    background: #ffffff; /* Pure white background */
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: grab;
    overflow: hidden;
    touch-action: none;
  }

  .shoe-container {
    position: relative;
    width: min(95vw, 850px);
    height: min(90vh, 850px);
    z-index: 10;
  }

  .shoe-frame {
    position: absolute;
    width: 100%; height: 100%;
    object-fit: contain;
    opacity: 0;
    /* Cinematic 1.5s cross-fade for the 3-second process */
    transition: opacity 1.5s cubic-bezier(0.4, 0, 0.2, 1);
    /* Soft shadow for white background */
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.08));
    user-select: none;
    pointer-events: none;
  }

  .shoe-frame.active { 
    opacity: 1; 
    z-index: 20; 
  }

  /* Labels for White Background */
  .archive-label {
    color: #94a3b8; /* slate-400 */
    font-weight: 900;
  }

  .status-line {
    background: linear-gradient(to bottom, transparent, #000000);
    width: 1px;
    height: 64px;
    opacity: 0.2;
  }

  #statusText {
    color: #000000;
    opacity: 0.6;
    font-weight: 900;
  }

  /* --- 2. STICKY NAV --- */
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #f1f5f9;
    padding: 1.2rem 0;
    margin-bottom: 100px; /* 100px margin as requested */
  }

  /* --- 3. PRODUCT DETAILS --- */
  .product-title {
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 0.85;
    text-transform: uppercase;
  }

  .size-chip-radio:checked + .size-chip-label {
    background-color: #ef4444; /* red-600 */
    color: white;
    border-color: #ef4444;
    transform: scale(1.1);
  }

  .size-chip-label {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 2px solid #f1f5f9;
    border-radius: 16px;
    font-weight: 800;
    color: #475569;
    transition: all 0.3s ease;
  }
</style>

<body class="bg-white antialiased">
<%- include('../partials/nav') %>

<main>
  <section class="hero-viewer" id="viewer">
    <div class="absolute top-10 left-10 z-30">
      <span class="text-[10px] uppercase tracking-[0.6em] archive-label">Cinematic Archive</span>
    </div>
    
    <div class="shoe-container">
      <% if (product.photos && product.photos.length > 0) { %>
        <% product.photos.forEach((photo, index) => { %>
          <img src="/<%= photo %>" class="shoe-frame <%= index === 0 ? 'active' : '' %>">
        <% }) %>
      <% } else { %>
         <img src="/<%= product.photo %>" class="shoe-frame active">
      <% } %>
    </div>

    <div class="absolute bottom-12 flex flex-col items-center gap-4 z-30">
      <div class="status-line"></div>
      <p class="text-[9px] uppercase tracking-[0.4em]" id="statusText">
        Auto-Rotate Active
      </p>
    </div>
  </section>

  <nav class="sticky-nav">
    <div class="max-w-[1400px] mx-auto px-10 flex justify-between items-center">
      <div class="flex items-center gap-6">
        <h2 class="text-lg font-black tracking-tighter"><%= product.productName %></h2>
        <span class="h-4 w-[1px] bg-gray-200"></span>
        <span class="text-green-600 text-[10px] font-black uppercase tracking-widest">In Stock</span>
      </div>
      
      <div class="flex items-center gap-12">
        <div class="text-right">
          <span class="block text-3xl font-black tracking-tighter">₹<%= product.price %></span>
        </div>
        <button onclick="toggleOrderModal(true)" class="bg-black text-white px-10 py-4 rounded-full text-[10px] font-black uppercase tracking-[0.2em] hover:scale-105 transition-all">
          Secure Acquisition
        </button>
      </div>
    </div>
  </nav>

  <section class="max-w-[1000px] mx-auto px-10 pb-40">
    <h1 class="product-title mb-16"><%= product.productName %></h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
      <div class="text-2xl text-gray-500 leading-tight font-medium">
        <%= product.description %>
      </div>
      
      <div class="space-y-10">
        <div class="border-t border-gray-100 pt-6">
          <p class="text-[10px] font-black uppercase tracking-widest text-gray-300 mb-4">Customer Sentiment</p>
          <div class="flex items-center gap-2">
            <span class="text-4xl font-black"><%= product.rating || 4.5 %></span>
            <span class="text-yellow-500 text-2xl">★</span>
          </div>
        </div>
        
        <div class="flex gap-4">
          <form action="/cart" method="POST" class="flex-1">
            <input type="hidden" name="productId" value="<%= product._id %>">
            <button class="w-full py-6 bg-gray-100 text-black font-black uppercase tracking-widest text-[10px] rounded-2xl hover:bg-gray-200 transition-all">
              Add to Registry
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</main>

<div id="orderModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-md flex items-center justify-center z-[300] py-10">
  <div class="bg-white rounded-[3rem] p-12 max-w-lg w-full mx-4 shadow-2xl overflow-y-auto max-h-[90vh]">
    <div class="flex justify-between items-center mb-10">
      <h2 class="text-4xl font-black tracking-tighter">Checkout</h2>
      <button onclick="toggleOrderModal(false)" class="text-4xl font-light hover:rotate-90 transition-transform">&times;</button>
    </div>

    <form action="/orders/create" method="POST" class="space-y-10" id="orderFormDetail" onsubmit="return validateAndSubmitOrder(event)">
      <input type="hidden" name="items[0][productId]" value="<%= product._id %>">
      <input type="hidden" name="items[0][size]" id="itemSize">
      <input type="hidden" name="items[0][quantity]" id="itemQuantity">

      <% if(product.availableSizes && product.availableSizes.length > 0) { %>
      <div>
        <label class="block text-[10px] font-black uppercase tracking-[0.3em] text-gray-400 mb-6 text-center">Select Configuration</label>
        <div class="flex flex-wrap justify-center gap-4">
          <% product.availableSizes.forEach(size => { %>
            <label class="cursor-pointer">
              <input type="radio" name="size" value="<%= size %>" class="hidden size-chip-radio" <%= size === 'M' ? 'checked' : '' %>>
              <span class="size-chip-label"><%= size %></span>
            </label>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div>
        <label class="block text-[10px] font-black uppercase tracking-widest text-gray-400 mb-3">Quantity</label>
        <input type="number" id="quantityInput" min="1" max="10" value="1" class="w-full p-5 bg-gray-50 rounded-2xl font-black text-center border-none focus:ring-2 focus:ring-red-500">
      </div>

      <%- include('../partials/order-location-picker') %>

      <div class="bg-black p-8 rounded-[2rem] text-white flex justify-between items-center">
        <span class="text-[10px] font-black uppercase tracking-widest opacity-50">Grand Total</span>
        <span class="text-4xl font-black">₹<span id="totalAmount"><%= product.price %></span></span>
      </div>

      <button type="submit" class="w-full py-7 rounded-2xl bg-red-600 text-white font-black uppercase tracking-[0.3em] text-xs shadow-xl hover:bg-red-700 transition-all">
        Confirm Order
      </button>
    </form>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/order-location-picker.js"></script>
<script>
  const frames = document.querySelectorAll('.shoe-frame');
  const viewer = document.getElementById('viewer');
  const statusTxt = document.getElementById('statusText');
  let current = 0, isDragging = false, startX = 0, timer;

  function update(idx) {
    if (frames.length <= 1) return;
    frames.forEach(f => f.classList.remove('active'));
    current = (idx + frames.length) % frames.length;
    frames[current].classList.add('active');
  }

  function start() {
    statusTxt.innerText = "Auto-Rotate Active";
    // 3 Second Automatic Process
    timer = setInterval(() => update(current + 1), 3000); 
  }

  function stop() { 
    clearInterval(timer); 
    statusTxt.innerText = "Manual Control"; 
  }

  // Desktop Mouse Support
  viewer.addEventListener('mousedown', (e) => { isDragging = true; startX = e.pageX; stop(); });
  window.addEventListener('mouseup', () => { isDragging = false; setTimeout(start, 5000); });
  window.addEventListener('mousemove', (e) => {
    if(!isDragging) return;
    const dx = e.pageX - startX;
    if(Math.abs(dx) > 60) { update(current + (dx > 0 ? -1 : 1)); startX = e.pageX; }
  });

  // Mobile Touch Support
  viewer.addEventListener('touchstart', (e) => { isDragging = true; startX = e.touches[0].pageX; stop(); });
  window.addEventListener('touchend', () => { isDragging = false; setTimeout(start, 5000); });
  window.addEventListener('touchmove', (e) => {
    if(!isDragging) return;
    const dx = e.touches[0].pageX - startX;
    if(Math.abs(dx) > 40) { update(current + (dx > 0 ? -1 : 1)); startX = e.touches[0].pageX; }
  });

  function toggleOrderModal(open) {
    document.getElementById('orderModal').classList.toggle('hidden', !open);
    if(open && window.refreshOrderLocationPickers) setTimeout(window.refreshOrderLocationPickers, 200);
  }

  const basePrice = <%= product.price %>;
  const qIn = document.getElementById('quantityInput');
  qIn.addEventListener('input', () => {
    document.getElementById('totalAmount').textContent = (basePrice * (parseInt(qIn.value) || 1)).toLocaleString('en-IN');
  });

  function validateAndSubmitOrder(e) {
    e.preventDefault();
    const size = document.querySelector('input[name="size"]:checked')?.value;
    if(!size) return alert('Please select a size.');
    
    document.getElementById('itemSize').value = size;
    document.getElementById('itemQuantity').value = qIn.value;
    
    if(window.validateOrderLocation && !window.validateOrderLocation(document.getElementById('orderFormDetail'))) return false;
    document.getElementById('orderFormDetail').submit();
  }

  if(frames.length > 1) start();
</script>

</body>
</html>