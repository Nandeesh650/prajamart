<%- include('../partials/head') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #f1f1f1; }
  ::-webkit-scrollbar-thumb { background: #dc2626; border-radius: 10px; }
</style>
</head>

<body class="bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen font-sans">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-10">

    <div class="text-center mb-12">
      <h2 class="text-4xl font-extrabold text-red-700 tracking-tight">🛒 Your Shopping Cart</h2>
      <p class="text-gray-500 mt-2 text-lg italic">Ready to bring these home?</p>
    </div>

    <% if (cartProducts && cartProducts.length > 0) { %>

    <form action="/orders/create" method="POST" id="checkoutForm">

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <!-- Cart Items -->
        <div class="lg:col-span-2 space-y-6">
          <% cartProducts.forEach((product, index) => { %>
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 flex flex-col md:flex-row items-center gap-8 transition-transform hover:shadow-lg">

              <!-- Product Image -->
              <div class="w-40 h-40 bg-gray-50 rounded-2xl overflow-hidden flex-shrink-0 border">
                <img src="<%= product.photo %>" alt="<%= product.productName %>" class="w-full h-full object-contain p-2">
              </div>

              <!-- Product Info -->
              <div class="flex-grow w-full">
                <div class="flex justify-between items-start">
                  <h3 class="text-2xl font-bold text-gray-800"><%= product.productName %></h3>
                  <p class="text-2xl font-black text-red-600">₹<%= product.price %></p>
                </div>

                <div class="mt-6 flex flex-wrap items-end gap-6">

                  <!-- Quantity -->
                  <div class="flex flex-col gap-1">
                    <label class="text-xs font-bold text-gray-400 uppercase">Quantity</label>
                    <input type="number" name="items[<%= index %>][quantity]" value="1" min="1"
                      class="qty-input w-20 border-2 border-gray-100 rounded-xl px-3 py-2 text-center font-bold text-red-600 focus:border-red-500 outline-none transition"
                      data-price="<%= product.price %>" onchange="calculateGrandTotal()">
                  </div>

                  <!-- Size -->
                  <div class="flex flex-col gap-2 flex-grow">
                    <label class="text-xs font-bold text-gray-400 uppercase">Select Size <span class="text-red-500">*</span></label>
                    <div class="flex flex-wrap gap-2">
                      <% if (product.availableSizes && product.availableSizes.length > 0) { %>
                        <% product.availableSizes.forEach((size) => { %>
                          <label class="cursor-pointer group">
                            <input type="radio" name="items[<%= index %>][size]" value="<%= size %>" required class="peer hidden">
                            <div class="px-4 py-2 rounded-xl border-2 border-gray-100 text-sm font-bold text-gray-600 
                                        peer-checked:border-red-600 peer-checked:bg-red-50 peer-checked:text-red-700 
                                        group-hover:border-red-300 transition-all">
                              <%= size %>
                            </div>
                          </label>
                        <% }) %>
                      <% } else { %>
                        <input type="hidden" name="items[<%= index %>][size]" value="Standard">
                        <span class="text-gray-400 text-sm italic">One Size Fits All</span>
                      <% } %>
                    </div>
                  </div>

                  <input type="hidden" name="items[<%= index %>][productId]" value="<%= product._id %>">
                </div>

                <!-- Remove Item -->
                <div class="mt-6 pt-4 border-t border-gray-50 flex justify-between items-center">
                  <div class="flex items-center text-yellow-500 font-bold">
                    ★ <span class="ml-1 text-gray-700"><%= product.rating || '4.5' %></span>
                  </div>
                  <form action="/cart/delete/<%= product._id %>" method="POST">
                    <button type="submit" class="text-sm font-semibold text-gray-400 hover:text-red-600 transition">Remove Item</button>
                  </form>
                </div>

              </div>
            </div>
          <% }) %>
        </div>

        <!-- Summary -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100 sticky top-10">
            <h3 class="text-2xl font-bold text-gray-800 mb-6">Summary</h3>

            <div class="space-y-4 mb-8">
              <div class="flex justify-between text-gray-500 font-medium">
                <span>Subtotal</span>
                <span id="display-subtotal">₹0</span>
              </div>
              <div class="flex justify-between text-gray-500 font-medium">
                <span>Shipping</span>
                <span class="text-green-600 font-bold">FREE</span>
              </div>
              <div class="border-t pt-4 flex justify-between text-3xl font-black text-gray-800">
                <span>Total</span>
                <span id="display-total">₹0</span>
              </div>
            </div>

            <div class="space-y-6">
              <p class="text-xs font-bold text-gray-400 uppercase">Payment Method</p>
              <label class="flex items-center p-4 border-2 border-gray-100 rounded-2xl cursor-pointer hover:bg-red-50 hover:border-red-100 transition group">
                <input type="radio" name="paymentMethod" value="cod" checked class="w-5 h-5 text-red-600">
                <span class="ml-3 font-bold text-gray-700 group-hover:text-red-700">Cash on Delivery</span>
              </label>
            </div>

            <%- include('../partials/order-location-picker') %>

            <button type="submit" class="w-full bg-red-700 text-white py-4 rounded-2xl font-black text-lg shadow-lg hover:bg-red-800 transition-all">
              PLACE ORDER NOW
            </button>
          </div>
        </div>

      </div>
    </form>

    <% } else { %>
      <div class="bg-white rounded-3xl p-20 text-center shadow-sm border border-gray-100">
        <div class="text-6xl mb-6">💨</div>
        <h3 class="text-3xl font-bold text-gray-800">Your cart is feeling light!</h3>
        <a href="/" class="bg-red-700 text-white px-10 py-4 rounded-2xl font-bold mt-8 inline-block">Back to Store</a>
      </div>
    <% } %>

  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/order-location-picker.js"></script>
  <script>
    function calculateGrandTotal() {
      const inputs = document.querySelectorAll('.qty-input');
      let grandTotal = 0;
      inputs.forEach(input => {
        const price = parseFloat(input.dataset.price);
        const qty = parseInt(input.value) || 1;
        grandTotal += (price * qty);
      });
      document.getElementById('display-subtotal').innerText = '₹' + grandTotal.toLocaleString();
      document.getElementById('display-total').innerText = '₹' + grandTotal.toLocaleString();
    }

    window.onload = calculateGrandTotal;
  </script>
</body>
</html>
