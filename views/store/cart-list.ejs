<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">

  <!-- Navbar -->
  <%- include('../partials/nav') %>

  <main class="px-6 py-10 bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">

    <!-- HEADING -->
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold text-red-700 tracking-wide">
        🛒 Your Shopping Cart
      </h2>
      <p class="text-gray-500 mt-2 text-lg">
        Review your selected items
      </p>
    </div>

    <% if (cartProducts && cartProducts.length > 0) { %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- LEFT: PRODUCTS -->
        <div class="lg:col-span-2 space-y-8">

          <% cartProducts.forEach(product => { %>

            <!-- PREMIUM CART CARD -->
            <div class="flex items-center gap-6 bg-white rounded-3xl p-8
                        shadow-md hover:shadow-2xl hover:-translate-y-1
                        transition-all duration-300
                        max-w-3xl mx-auto min-h-[280px]">

              <!-- IMAGE -->
              <div class="w-48 h-48 bg-white rounded-2xl overflow-hidden
                          flex items-center justify-center shrink-0
                         ">
                <img 
                  src="<%= product.photo %>" 
                  alt="<%= product.productName %>"
                  class="w-full h-full object-contain"
                >
              </div>

              <!-- DETAILS -->
              <div class="flex-1 space-y-4">

                <h3 class="text-2xl font-semibold text-gray-800">
                  <%= product.productName %>
                </h3>

                <!-- Price + Qty -->
                <div class="flex items-center justify-between">

                  <p class="text-red-700 font-bold text-2xl">
                    ₹ <%= product.price %>
                  </p>

                  <div class="flex items-center gap-2">
                    <label class="text-gray-600 text-base">Qty:</label>
                    <input 
                      type="number"
                      min="1"
                      value="1"
                      class="qty w-20 border border-gray-300 rounded-lg px-2 py-2 text-center 
                             outline-none focus:ring-2 text-red-700"
                      data-price="<%= product.price %>"
                      onchange="updateTotal()"
                    >
                  </div>

                </div>

                <!-- Rating -->
                <div class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg"
                       viewBox="0 0 24 24"
                       fill="currentColor"
                       class="w-6 h-6text-red-700 mr-1">
                    <path fill-rule="evenodd"
                      d="M10.788 3.21c.448-1.077 1.976-1.077 
                      2.424 0l2.082 5.007 5.404.433c1.164.093 
                      1.636 1.545.749 2.305l-4.117 3.527 
                      1.257 5.273c.271 1.136-.964 2.033-1.96 
                      1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29 
                      -1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76 
                      -.415-2.212.749-2.305l5.404-.433 
                      2.082-5.006z"
                      clip-rule="evenodd" />
                  </svg>

                  <span class="text-gray-700 text-lg">
                    <%= product.rating && product.rating.stars !== undefined 
                        ? product.rating.stars 
                        : product.rating %>
                  </span>
                </div>

                <!-- Actions -->
                <div class="flex gap-6 text-base pt-3">
                  <a href="/products/<%= product._id %>" 
                     class="text-blue-600 hover:underline">
                    View Details
                  </a>

                  <form action="/cart/delete/<%= product._id %>" method="POST">
                    <button class="text-red-500 hover:underline">
                      Remove
                    </button>
                  </form>
                </div>

              </div>
            </div>

          <% }) %>

        </div>

        <!-- RIGHT: ORDER SUMMARY -->
        <div class="bg-white rounded-3xl p-8 shadow-lg h-fit sticky top-10">

          <h3 class="text-2xl font-bold mb-6 text-gray-800">
            Order Summary
          </h3>

          <div class="flex justify-between mb-3 text-gray-600">
            <span>Items</span>
            <span id="totalItems">0</span>
          </div>

          <div class="flex justify-between mb-3 text-gray-600">
            <span>Subtotal</span>
            <span id="subtotal">₹ 0</span>
          </div>

          <div class="flex justify-between mb-4 text-gray-600">
            <span>Delivery</span>
            <span class="text-green-500 font-medium">Free</span>
          </div>

          <hr class="my-4">

          <div class="flex justify-between text-xl font-bold text-gray-800 mb-6">
            <span>Total</span>
            <span id="grandTotal">₹ 0</span>
          </div>

          <!-- PAYMENT METHOD SECTION -->
          <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
            <h4 class="text-lg font-semibold text-gray-800 mb-4">
              💳 Payment Method
            </h4>
            
            <!-- Cash on Delivery (Default) -->
            <label class="flex items-start mb-4 cursor-pointer hover:bg-white p-2 rounded transition">
              <input 
                type="radio" 
                name="paymentMethod" 
                value="cod"
                checked
                class="mt-1 w-4 h-4 text-green-600 cursor-pointer"
              >
              <div class="ml-3">
                <p class="font-semibold text-gray-800">💵 Cash on Delivery (COD)</p>
                <p class="text-sm text-gray-600">Pay when you receive your order</p>
              </div>
            </label>

            <!-- UPI -->
            <label class="flex items-start mb-4 cursor-pointer hover:bg-white p-2 rounded transition">
              <input 
                type="radio" 
                name="paymentMethod" 
                value="upi"
                class="mt-1 w-4 h-4 text-blue-600 cursor-pointer"
              >
              <div class="ml-3">
                <p class="font-semibold text-gray-800">📱 UPI</p>
                <p class="text-sm text-gray-600">Pay instantly via Google Pay, PhonePe, or Paytm</p>
              </div>
            </label>

            <!-- UPI ID Input (Hidden by default) -->
            <div id="upiContainer" class="mb-4 pl-7 hidden">
              <input 
                type="text"
                name="upiId"
                placeholder="Enter UPI ID (e.g., name@bank)"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
            </div>

            <!-- Debit Card -->
            <label class="flex items-start mb-4 cursor-pointer hover:bg-white p-2 rounded transition">
              <input 
                type="radio" 
                name="paymentMethod" 
                value="debit_card"
                class="mt-1 w-4 h-4 text-purple-600 cursor-pointer"
              >
              <div class="ml-3">
                <p class="font-semibold text-gray-800">🏧 Debit Card</p>
                <p class="text-sm text-gray-600">Use your debit card securely</p>
              </div>
            </label>

            <!-- Debit Card Details (Hidden by default) -->
            <div id="cardContainer" class="mb-4 pl-7 hidden space-y-3">
              <input 
                type="text"
                name="cardNumber"
                placeholder="Card Number (16 digits)"
                maxlength="16"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500"
              >
              <input 
                type="text"
                name="cardHolder"
                placeholder="Cardholder Name"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500"
              >
              <input 
                type="text"
                name="expiryDate"
                placeholder="MM/YY"
                maxlength="5"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-purple-500"
              >
            </div>
          </div>

          <form action="/orders/create" method="POST" id="checkoutForm">
          <button type="submit"
            class="w-full bg-red-700 text-white py-3 rounded-xl font-semibold
                  shadow-md hover:bg-white hover:text-red-700
                  hover:shadow-xl hover:scale-105 transition duration-300">
             Proceed to Checkout
          </button>
        </form>


        </div>

      </div>

    <% } else { %>

      <!-- EMPTY CART -->
      <div class="text-center py-20">
        <h3 class="text-3xl font-semibold text-gray-600">
          🛒 Your cart is empty
        </h3>

        <p class="text-gray-400 mt-3">
          Add something amazing to get started!
        </p>

        <a href="/"
           class="inline-block mt-6 bg-gradient-to-r from-orange-500 to-red-500 
                  text-white px-6 py-3 rounded-xl shadow-md hover:scale-105 transition">
          🛍️ Shop Now
        </a>
      </div>

    <% } %>

  </main>

  <script>
    function updateTotal() {
      let qtyInputs = document.querySelectorAll(".qty");
      let total = 0;
      let totalQty = 0;

      qtyInputs.forEach(input => {
        let price = Number(input.dataset.price);
        let qty = Number(input.value);

        if (qty < 1) {
          input.value = 1;
          qty = 1;
        }

        total += price * qty;
        totalQty += qty;
      });

      document.getElementById("subtotal").innerText = "₹ " + total;
      document.getElementById("grandTotal").innerText = "₹ " + total;
      document.getElementById("totalItems").innerText = totalQty;
    }

    window.onload = updateTotal;

    // Payment Method Selection Handler
    const paymentRadios = document.querySelectorAll('input[name="paymentMethod"]');
    const upiContainer = document.getElementById('upiContainer');
    const cardContainer = document.getElementById('cardContainer');

    function handlePaymentMethodChange() {
      const selectedMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
      
      // Hide all containers first
      upiContainer.classList.add('hidden');
      cardContainer.classList.add('hidden');

      // Show relevant container
      if (selectedMethod === 'upi') {
        upiContainer.classList.remove('hidden');
      } else if (selectedMethod === 'debit_card') {
        cardContainer.classList.remove('hidden');
      }
    }

    // Add event listeners to radio buttons
    paymentRadios.forEach(radio => {
      radio.addEventListener('change', handlePaymentMethodChange);
    });
  </script>

</body>
</html>
