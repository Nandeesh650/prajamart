<%- include('../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
  :root { 
    --luxury-indigo: #4f46e5; 
    --glass-white: rgba(255, 255, 255, 0.8);
  }
  
  body { 
    font-family: 'Plus Jakarta Sans', sans-serif; 
    background-color: #fcfcfd; 
    color: #0f172a;
  }

  /* Luxury Row Animation */
  .order-row { 
    background: var(--glass-white);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(0,0,0,0.03);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .order-row:hover { 
    background: #ffffff;
    transform: translateX(10px);
    border-color: var(--luxury-indigo);
    box-shadow: 0 30px 60px -15px rgba(0,0,0,0.05);
  }

  /* Progress Line Micro-Details */
  .tracker-line { height: 2px; background: #f1f5f9; position: relative; width: 100%; border-radius: 2px; }
  .tracker-fill { 
    height: 100%; 
    background: var(--luxury-indigo); 
    box-shadow: 0 0 12px rgba(79, 70, 229, 0.3);
    transition: width 1.2s cubic-bezier(0.19, 1, 0.22, 1); 
  }

  /* Buttons */
  .btn-luxury {
    padding: 12px 24px;
    border-radius: 14px;
    font-[800] uppercase text-[10px] tracking-[0.2em] transition-all duration-300;
  }
  .btn-primary { background: #000; color: #fff; }
  .btn-primary:hover { background: var(--luxury-indigo); transform: translateY(-2px); }
  
  .status-tag {
    font-[900] uppercase text-[9px] tracking-[0.3em] px-4 py-1.5 rounded-full bg-indigo-50 text-indigo-600;
  }
</style>

<body class="antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-[1500px] mx-auto px-6 py-20">

    <div class="mb-20 flex flex-col md:flex-row justify-between items-end gap-6" data-aos="fade-right">
      <div>
        <span class="text-indigo-600 font-black uppercase tracking-[0.5em] text-[10px] mb-4 block">Acquisition History</span>
        <h1 class="text-6xl font-[900] text-slate-950 tracking-tighter">Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">Archives.</span></h1>
      </div>
      <div class="text-right">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Active Ledger</p>
        <p class="text-3xl font-[900] text-slate-950 tracking-tighter">Items Count: <%= orders.length %></p>
      </div>
    </div>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-8">
        <% orders.forEach((order, index) => { %>
          <div class="order-row rounded-[2.5rem] p-10 overflow-hidden" data-aos="fade-left" data-aos-delay="<%= index * 100 %>">
            
            <div class="flex flex-col lg:flex-row items-center gap-12">
              
              <div class="w-full lg:w-48 shrink-0">
                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-2">ID Reference</p>
                <p class="text-2xl font-[900] text-slate-950 tracking-tighter">#<%= order._id.toString().slice(-8).toUpperCase() %></p>
                <p class="text-[11px] font-bold text-slate-500 mt-2"><%= new Date(order.orderDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
              </div>

              <div class="flex-grow w-full px-4">
                <div class="flex justify-between items-center mb-4">
                   <span class="status-tag"><%= order.status.replace(/_/g, " ") %></span>
                   <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">
                     <%= order.status === 'delivered' ? 'Completed' : 'Live Movement' %>
                   </span>
                </div>
                <div class="tracker-line">
                  <div class="tracker-fill" style="width: <%= order.status === 'pending' ? '15' : order.status === 'confirmed' ? '40' : order.status === 'shipped' ? '65' : order.status === 'ready_to_deliver' ? '85' : '100' %>%;"></div>
                </div>
                <div class="flex justify-between mt-4">
                  <% ['Pending', 'Confirmed', 'Shipped', 'Ready', 'Delivered'].forEach(step => { %>
                    <span class="text-[8px] font-black text-slate-300 uppercase tracking-tighter"><%= step %></span>
                  <% }) %>
                </div>
              </div>

              <div class="flex -space-x-8 shrink-0">
                <% if (order.items && order.items.length > 0) { %>
                  <% order.items.slice(0, 3).forEach(item => { %>
                    <div class="w-20 h-24 rounded-2xl border-[6px] border-white bg-slate-50 overflow-hidden shadow-xl transform hover:-translate-y-4 transition-all cursor-pointer">
                      <% 
                        let itemPhoto = '/images/no-image.png';
                        if (item.productId) {
                          if (item.productId.photos && item.productId.photos.length > 0) {
                            itemPhoto = '/' + item.productId.photos[0];
                          } else if (item.productId.photo) {
                            itemPhoto = item.productId.photo;
                          }
                        }
                      %>
                      <img src="<%= itemPhoto %>" class="w-full h-full object-cover">
                    </div>
                  <% }) %>
                  <% if (order.items.length > 3) { %>
                    <div class="w-20 h-24 rounded-2xl border-[6px] border-white bg-slate-950 flex items-center justify-center text-[10px] text-white font-black z-10">
                      +<%= order.items.length - 3 %>
                    </div>
                  <% } %>
                <% } %>
              </div>

              <div class="w-full lg:w-fit flex lg:flex-col items-center lg:items-end justify-between gap-6 shrink-0">
                <div class="text-right">
                  <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Total Assets</p>
                  <p class="text-4xl font-[900] text-slate-950 tracking-tighter">₹<%= Number(order.totalPrice).toLocaleString('en-IN') %></p>
                </div>
                
                <div class="flex gap-3">
                  <a href="/orders/<%= order._id %>" class="btn-luxury btn-primary">Details</a>
                  
                  <% if (['shipped', 'ready_to_deliver'].includes(order.status)) { %>
                    <a href="/orders/<%= order._id %>/tracking" class="btn-luxury bg-indigo-100 text-indigo-600 hover:bg-indigo-600 hover:text-white">Track</a>
                  <% } %>
                  
                  <% if (['pending', 'confirmed'].includes(order.status)) { %>
                    <form action="/orders/<%= order._id %>/cancel" method="POST">
                      <button class="w-10 h-10 flex items-center justify-center rounded-xl border border-slate-100 text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>

            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="py-40 text-center bg-white rounded-[4rem] border border-slate-100" data-aos="zoom-in">
        <div class="text-7xl mb-8">🧭</div>
        <h3 class="text-4xl font-[900] text-slate-950 tracking-tighter mb-4">No archives found.</h3>
        <p class="text-slate-400 font-bold uppercase tracking-widest text-[11px] mb-12">Your collection journey begins with your first selection.</p>
        <a href="/products" class="btn-luxury btn-primary inline-block">Explore Collection</a>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({ duration: 1000, once: true, offset: 50 });
  </script>
</body>
</html>