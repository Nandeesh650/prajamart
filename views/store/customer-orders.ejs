<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="px-6 py-10 bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">
    
    <!-- HEADING -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-800 tracking-wide">
        My Orders
      </h1>
      <p class="text-gray-500 mt-2 text-lg">
        Track your orders and manage purchases
      </p>
    </div>

    <!-- MESSAGES -->
    <div class="max-w-6xl mx-auto mb-6">
      <% if (success) { %>
        <div class="p-4 rounded-lg bg-green-100 text-green-800 border border-green-300">
          <%= success %>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="p-4 rounded-lg bg-red-100 text-red-800 border border-red-300">
          <%= error %>
        </div>
      <% } %>
    </div>

    <!-- ORDERS LIST -->
    <div class="max-w-6xl mx-auto">
      <% if (orders && orders.length > 0) { %>
        
        <div class="space-y-6">
          <% orders.forEach(order => { %>
            <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6 border-l-4 border-red-500">
              
              <!-- Order Header -->
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-xl font-bold text-gray-800">
                    <%= order.productId.productName %>
                  </h3>
                  <p class="text-sm text-gray-600 mt-1">
                    Order ID: <%= order._id %>
                  </p>
                </div>
                <span class="px-4 py-2 rounded-full text-sm font-semibold
                  <% if (order.status === 'pending') { %>
                    bg-yellow-100 text-yellow-800
                  <% } else if (order.status === 'confirmed') { %>
                    bg-blue-100 text-blue-800
                  <% } else if (order.status === 'ready_to_deliver') { %>
                    bg-orange-100 text-orange-800
                  <% } else if (order.status === 'out_for_delivery' || order.status === 'shipped') { %>
                    bg-purple-100 text-purple-800
                  <% } else if (order.status === 'delivered') { %>
                    bg-green-100 text-green-800
                  <% } else if (order.status === 'return_requested') { %>
                    bg-amber-100 text-amber-800
                  <% } else if (order.status === 'returned') { %>
                    bg-slate-200 text-slate-800
                  <% } else if (order.status === 'cancelled') { %>
                    bg-red-100 text-red-800
                  <% } %>
                ">
                  <%= order.status === 'ready_to_deliver' ? 'READY TO DELIVER' : order.status === 'out_for_delivery' ? 'OUT FOR DELIVERY' : order.status === 'shipped' ? 'SHIPPED' : order.status === 'return_requested' ? 'RETURN REQUESTED' : order.status === 'returned' ? 'RETURNED' : order.status.toUpperCase() %>
                </span>
              </div>

              <!-- Order Details -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Quantity</p>
                  <p class="text-lg font-bold text-gray-800"><%= order.quantity %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Total Price</p>
                  <p class="text-lg font-bold text-red-600">₹<%= order.totalPrice %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Host</p>
                  <p class="text-lg font-bold text-gray-800"><%= order.hostId.firstName %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Order Date</p>
                  <p class="text-lg font-bold text-gray-800">
                    <%= new Date(order.orderDate).toLocaleDateString() %>
                  </p>
                </div>
              </div>

              <!-- Shipping Address -->
              <div class="mb-4 pb-4 border-b border-gray-200 grid gap-4 md:grid-cols-3">
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Shipping Address</p>
                  <p class="text-gray-700"><%= order.shippingAddress %></p>
                  <p class="mt-2 text-xs text-gray-500 uppercase font-semibold">Mapped Place</p>
                  <p class="text-sm text-gray-600"><%= order.deliveryLocation?.placeName || order.deliveryLocation?.city || 'Not mapped yet' %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Host Phone</p>
                  <p class="text-gray-700"><%= order.hostId.phoneNumber || 'Not available' %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Delivery Boy</p>
                  <p class="text-gray-700">
                    <%= order.deliveryBoyId ? `${order.deliveryBoyId.firstName} ${order.deliveryBoyId.lastName}` : 'Waiting for delivery acceptance' %>
                  </p>
                  <p class="text-sm text-gray-500"><%= order.deliveryBoyId?.phoneNumber || '' %></p>
                </div>
              </div>

              <% if ((order.status === 'shipped' || order.status === 'out_for_delivery') && order.deliveryOtp) { %>
                <div class="mb-4 pb-4 border-b border-gray-200 rounded-lg bg-orange-50 p-4">
                  <p class="text-xs text-orange-500 uppercase font-semibold">Delivery OTP</p>
                  <p class="mt-2 text-sm text-gray-700">Share this OTP only when your order is delivered.</p>
                  <p class="mt-2 text-2xl font-black tracking-[0.35em] text-orange-700"><%= order.deliveryOtp %></p>
                </div>
              <% } %>

              <% if (order.status === 'return_requested' || order.status === 'returned') { %>
                <div class="mb-4 pb-4 border-b border-gray-200 rounded-lg bg-amber-50 p-4">
                  <p class="text-xs text-amber-600 uppercase font-semibold">Return Status</p>
                  <p class="mt-2 text-sm text-gray-700">
                    <%= order.status === 'return_requested'
                      ? 'Your return request has been sent to the host. They can now mark the product as returned.'
                      : 'This product has been marked as returned.' %>
                  </p>
                  <% if (order.returnRequestedAt) { %>
                    <p class="mt-2 text-xs text-gray-500">Requested on <%= new Date(order.returnRequestedAt).toLocaleString() %></p>
                  <% } %>
                  <% if (order.returnedAt) { %>
                    <p class="mt-1 text-xs text-gray-500">Returned on <%= new Date(order.returnedAt).toLocaleString() %></p>
                  <% } %>
                </div>
              <% } %>

              <!-- Payment Information -->
              <div class="mb-4 pb-4 border-b border-gray-200 bg-blue-50 p-3 rounded-lg">
                <p class="text-xs text-gray-500 uppercase font-semibold mb-2">💳 Payment Method</p>
                <div class="flex justify-between items-center">
                  <div>
                    <% if (order.paymentMethod === 'cod') { %>
                      <p class="font-semibold text-gray-800">💵 Cash on Delivery (COD)</p>
                      <p class="text-sm text-gray-600">Pay when you receive your order</p>
                    <% } else if (order.paymentMethod === 'upi') { %>
                      <p class="font-semibold text-gray-800">📱 UPI</p>
                      <p class="text-sm text-gray-600">UPI ID: <span class="font-mono"><%= order.upiId %></span></p>
                    <% } else if (order.paymentMethod === 'debit_card') { %>
                      <p class="font-semibold text-gray-800">🏧 Debit Card</p>
                      <p class="text-sm text-gray-600">Card: <span class="font-mono"><%= order.cardDetails.cardNumber %></span></p>
                    <% } %>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-semibold
                    <% if (order.paymentStatus === 'completed') { %>
                      bg-green-200 text-green-800
                    <% } else if (order.paymentStatus === 'failed') { %>
                      bg-red-200 text-red-800
                    <% } else { %>
                      bg-yellow-200 text-yellow-800
                    <% } %>
                  ">
                    <%= order.paymentStatus.toUpperCase() %>
                  </span>
                </div>
              </div>

              <!-- User Rating -->
              <% if (order.status === 'delivered' && order.userRating && order.userRating.stars > 0) { %>
                <div class="mb-4 pb-4 border-b border-gray-200 bg-yellow-50 p-3 rounded-lg">
                  <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Your Rating</p>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-2xl">
                      <% for (let i = 0; i < 5; i++) { %>
                        <% if (i < order.userRating.stars) { %>
                          ⭐
                        <% } else { %>
                          ☆
                        <% } %>
                      <% } %>
                    </span>
                    <span class="font-semibold text-gray-800"><%= order.userRating.stars %>/5</span>
                  </div>
                  <% if (order.userRating.comment) { %>
                    <p class="text-sm text-gray-700 italic">"<%= order.userRating.comment %>"</p>
                  <% } %>
                </div>
              <% } %>

              <!-- Actions -->
              <div class="flex gap-3">
                <a href="/orders/<%= order._id %>" class="px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition font-medium">
                  View Details
                </a>
                <% if (order.deliveryBoyId || order.status === 'shipped' || order.status === 'out_for_delivery' || order.status === 'delivered') { %>
                  <a href="/orders/<%= order._id %>/tracking" class="px-4 py-2 rounded-lg bg-emerald-500 text-white hover:bg-emerald-600 transition font-medium">
                    Track Order
                  </a>
                <% } %>
                <% if (order.status === 'delivered') { %>
                  <form action="/orders/<%= order._id %>/return" method="POST" style="display: inline;">
                    <button type="submit" class="px-4 py-2 rounded-lg bg-amber-500 text-white hover:bg-amber-600 transition font-medium"
                      onclick="return confirm('Do you want to request a return for this product?')">
                      Return Product
                    </button>
                  </form>
                <% } %>
                <% if (order.status === 'cancelled'){ %>
                <form action="/host/orders/<%= order._id %>/delete" method="POST" style="display: inline;">
                  <button type="submit" class="px-4 py-2 rounded-lg bg-red-500 text-white hover:bg-red-600 transition font-medium" onclick="return confirm('Are you sure you want to delete this order? This action cannot be undone.');">
                    Delete Order
                  </button>
                </form>
                <% } %>
                <% if (order.status === 'pending' || order.status === 'confirmed' || order.status === 'ready_to_deliver') { %>
                  <form action="/orders/<%= order._id %>/cancel" method="POST" style="display: inline;">
                    <button type="submit" class="px-4 py-2 rounded-lg bg-red-500 text-white hover:bg-red-600 transition font-medium"
                      onclick="return confirm('Are you sure you want to cancel this order?')">
                      Cancel Order
                    </button>
                  </form>
                <% } %>
              </div>

            </div>
          <% }) %>
        </div>

      <% } else { %>

        <div class="text-center py-20">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto text-gray-400 mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.821 4.915h15.412a2.25 2.25 0 012.189 2.664l-1.236 7.415H5.25M9 12.75a.75.75 0 100-1.5.75.75 0 000 1.5zm12 0a.75.75 0 100-1.5.75.75 0 000 1.5z" />
          </svg>
          <p class="text-gray-500 text-xl">
            You haven't placed any orders yet
          </p>
          <a href="/products" class="mt-4 inline-block px-6 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition font-medium">
            Continue Shopping
          </a>
        </div>

      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
