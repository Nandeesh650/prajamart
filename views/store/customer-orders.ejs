<%- include('../partials/head') %>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
  :root { --primary-red: #ef4444; --brand-indigo: #4f46e5; }

  body { animation: fadeInPage 0.8s ease-in-out; background-color: #fcfcfd; }
  @keyframes fadeInPage { from { opacity: 0; } to { opacity: 1; } }

  .order-card {
    transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
    border: 1px solid #f1f5f9;
  }

  .order-card:hover {
    transform: translateY(-12px) scale(1.005);
    border-color: var(--brand-indigo);
    box-shadow: 0 50px 100px -20px rgba(79, 70, 229, 0.1);
  }

  /* INCREASED IMAGE CONTAINER */
  .img-container {
    background-color: #f8fafc;
    transition: all 0.5s ease;
    /* Increased base width for large screens */
    flex: 0 0 500px; 
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Switched to cover for that "Premium Tall" look */
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .order-card:hover .product-img {
    transform: scale(1.1);
  }

  .status-badge {
    backdrop-filter: blur(12px);
    background: rgba(15, 23, 42, 0.8);
  }

  .btn-premium {
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .btn-premium:hover { transform: translateY(-3px); }
</style>

<body class="antialiased text-slate-900">
  <%- include('../partials/nav') %>

  <main class="max-w-[1440px] mx-auto px-6 py-20 lg:px-12">
    
    <header class="mb-20 flex flex-col md:flex-row md:items-end justify-between border-b border-slate-100 pb-12 gap-8" data-aos="fade-down">
      <div>
        <h1 class="text-6xl md:text-7xl font-[900] text-slate-950 tracking-tighter uppercase">Your <span class="text-indigo-600">Orders.</span></h1>
        <p class="text-slate-400 font-bold mt-4 text-sm uppercase tracking-[0.2em]">History & Real-time Tracking</p>
      </div>
      <div class="flex items-center gap-4" data-aos="fade-left" data-aos-delay="200">
        <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Total Archive</span>
        <div class="h-16 w-16 rounded-[1.5rem] bg-slate-950 flex items-center justify-center text-white text-2xl font-black">
          <%= orders.length %>
        </div>
      </div>
    </header>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-20">
        <% orders.forEach((order, index) => { %>
          <div class="order-card bg-white rounded-[3.5rem] flex flex-col lg:flex-row overflow-hidden shadow-sm" 
               data-aos="fade-up" 
               data-aos-delay="<%= index * 100 %>">
            
            <div class="img-container relative h-[500px] lg:h-[600px] border-b lg:border-b-0 lg:border-r border-slate-50">
              <img src="<%= order.productId.photo %>" class="product-img" alt="Product">
              
              <div class="absolute top-10 left-10">
                <span class="status-badge text-white px-6 py-2.5 rounded-full font-black uppercase text-[10px] tracking-[0.2em] inline-block shadow-2xl">
                  <%= order.status.replace(/_/g, ' ') %>
                </span>
              </div>
            </div>

            <div class="flex-grow p-12 lg:p-16 flex flex-col justify-between">
              
              <div class="flex flex-col xl:flex-row justify-between items-start gap-8">
                <div class="max-w-xl">
                  <h2 class="text-5xl font-[900] text-slate-950 leading-tight mb-4 tracking-tighter uppercase"><%= order.productId.productName %></h2>
                  <div class="flex flex-wrap gap-5 text-[10px] font-black text-slate-300 uppercase tracking-widest">
                    <span class="bg-slate-50 px-3 py-1 rounded">#<%= order._id.toString().slice(-8).toUpperCase() %></span>
                    <span class="flex items-center gap-2">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <%= new Date(order.orderDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </span>
                  </div>
                </div>
                <div class="text-left xl:text-right">
                  <p class="text-5xl font-[900] text-indigo-600 tracking-tighter">₹<%= order.totalPrice.toLocaleString('en-IN') %></p>
                  <p class="text-[10px] font-black text-slate-200 uppercase tracking-widest mt-2">Grand Total Paid</p>
                </div>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-10 my-12 py-10 border-y border-slate-50">
                <div>
                  <p class="text-[10px] font-black text-slate-300 uppercase mb-3 tracking-widest">Size/Type</p>
                  <p class="text-lg font-black text-slate-950"><%= order.size || 'STANDARD' %></p>
                </div>
                <div>
                  <p class="text-[10px] font-black text-slate-300 uppercase mb-3 tracking-widest">Quantity</p>
                  <p class="text-lg font-black text-slate-950"><%= order.quantity %> Units</p>
                </div>
                <div class="col-span-2">
                  <p class="text-[10px] font-black text-slate-300 uppercase mb-3 tracking-widest">Delivery Address</p>
                  <p class="text-sm font-bold text-slate-500 leading-relaxed"><%= order.shippingAddress %></p>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-10 pt-6">
                
                <div class="flex items-center gap-6">
                  <% if (['shipped', 'out_for_delivery'].includes(order.status) && order.deliveryOtp) { %>
                    <div class="flex flex-col">
                        <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-2">Secure OTP</span>
                        <div class="bg-slate-950 text-indigo-400 px-8 py-4 rounded-[1.5rem] shadow-2xl">
                          <span class="text-3xl font-black tracking-[0.4em]"><%= order.deliveryOtp %></span>
                        </div>
                    </div>
                  <% } %>

                  <div class="flex items-center gap-3 px-6 py-3 rounded-full bg-slate-50 border border-slate-100">
                    <span class="w-2.5 h-2.5 rounded-full <%= order.paymentStatus === 'completed' ? 'bg-emerald-500' : 'bg-amber-400 animate-pulse' %>"></span>
                    <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest"><%= order.paymentStatus %></span>
                  </div>
                </div>

                <div class="flex items-center gap-5">
                  <% if (['pending', 'confirmed'].includes(order.status)) { %>
                    <form action="/orders/<%= order._id %>/cancel" method="POST">
                      <button class="text-[10px] font-black text-slate-300 hover:text-rose-600 transition-all uppercase tracking-widest px-6" onclick="return confirm('Cancel this order?')">Cancel</button>
                    </form>
                  <% } %>
                  
                  <a href="/orders/<%= order._id %>" class="btn-premium h-20 px-12 rounded-[2rem] bg-white border-2 border-slate-950 text-slate-950 font-black text-xs uppercase tracking-widest flex items-center hover:bg-slate-50">Details</a>
                  
                  <% if (order.deliveryBoyId || ['shipped', 'delivered', 'out_for_delivery'].includes(order.status)) { %>
                    <a href="/orders/<%= order._id %>/tracking" class="btn-premium h-20 px-12 rounded-[2rem] bg-indigo-600 text-white font-black text-xs uppercase tracking-widest flex items-center shadow-2xl shadow-indigo-200">Track Order</a>
                  <% } %>
                </div>

              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } else { %>
      <div class="text-center py-48 bg-slate-50/50 border-4 border-dashed border-slate-100 rounded-[5rem]" data-aos="zoom-in">
        <h2 class="text-6xl font-[900] text-slate-200 uppercase tracking-tighter mb-10">Empty History</h2>
        <a href="/products" class="px-14 py-6 bg-slate-950 text-white font-black rounded-3xl hover:bg-indigo-600 transition-all inline-block shadow-2xl shadow-indigo-100 text-xs uppercase tracking-widest">Start Shopping</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({ duration: 1200, once: true, easing: 'ease-out-quint' });
  </script>
</body>
</html>