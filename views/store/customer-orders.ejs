<%- include('../partials/head') %>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
  :root {
    --primary-red: #ef4444;
  }

  /* Smooth reveal for the whole page */
  body {
    animation: fadeInPage 0.8s ease-in-out;
  }

  @keyframes fadeInPage {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Magnetic Card Effect */
  .order-card {
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    border: 1px solid #f3f4f6;
  }

  .order-card:hover {
    transform: translateY(-10px) scale(1.01);
    border-color: var(--primary-red);
    box-shadow: 0 40px 80px -20px rgba(0,0,0,0.05);
  }

  /* Image Pulse on Hover */
  .img-container {
    background-color: #ffffff;
    transition: all 0.5s ease;
  }

  .order-card:hover .product-img {
    transform: scale(1.1);
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 2.5rem;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* Shimmer effect for status badges */
  .status-badge {
    position: relative;
    overflow: hidden;
  }

  .status-badge::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
    transform: rotate(45deg);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    0% { transform: translateX(-100%) rotate(45deg); }
    100% { transform: translateX(100%) rotate(45deg); }
  }

  /* Button Bounce */
  .btn-premium {
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .btn-premium:hover {
    transform: scale(1.05);
  }
  .btn-premium:active {
    transform: scale(0.95);
  }
</style>
</head>

<body class="bg-white min-h-screen font-sans antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-5xl mx-auto px-6 py-20">
    
    <header class="mb-16 flex flex-col md:flex-row md:items-end justify-between border-b border-gray-100 pb-10 gap-6" data-aos="fade-down">
      <div>
        <h1 class="text-5xl font-black text-gray-900 tracking-tighter">Your Orders</h1>
        <p class="text-gray-400 font-medium mt-3 text-lg">Manage history and tracking info</p>
      </div>
      <div class="flex items-center gap-3" data-aos="fade-left" data-aos-delay="200">
        <span class="text-xs font-bold text-gray-300 uppercase tracking-widest">Total Purchases</span>
        <div class="h-12 w-12 rounded-2xl border-2 border-gray-900 flex items-center justify-center text-gray-900 font-black">
          <%= orders.length %>
        </div>
      </div>
    </header>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-12">
        <% orders.forEach((order, index) => { %>
          <div class="order-card bg-white rounded-[2.5rem] flex flex-col lg:flex-row overflow-hidden" 
               data-aos="fade-up" 
               data-aos-delay="<%= index * 100 %>">
            
            <div class="w-full lg:w-[400px] h-96 img-container relative border-b lg:border-b-0 lg:border-r border-gray-50">
              <img src="<%= order.productId.photo %>" class="product-img" alt="Product">
              
              <div class="absolute top-8 left-8">
                <span class="status-badge bg-gray-900 text-white px-5 py-2 rounded-xl font-black uppercase text-[10px] tracking-widest inline-block">
                  <%= order.status.replace(/_/g, ' ') %>
                </span>
              </div>
            </div>

            <div class="flex-grow p-10 flex flex-col justify-between">
              
              <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                <div class="max-w-md">
                  <h2 class="text-4xl font-black text-gray-900 leading-[0.9] mb-4 tracking-tighter uppercase"><%= order.productId.productName %></h2>
                  <div class="flex flex-wrap gap-4 text-[10px] font-bold text-gray-300 uppercase tracking-widest">
                    <span>ID: #<%= order._id.toString().slice(-6).toUpperCase() %></span>
                    <span class="text-gray-100">|</span>
                    <span>Ordered: <%= new Date(order.orderDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric' }) %></span>
                  </div>
                </div>
                <div class="text-left md:text-right">
                  <p class="text-4xl font-black text-red-600 tracking-tighter">₹<%= order.totalPrice.toLocaleString() %></p>
                  <p class="text-[10px] font-bold text-gray-200 uppercase tracking-widest mt-1">Total Amount</p>
                </div>
              </div>

              <div class="grid grid-cols-2 md:grid-cols-4 gap-8 my-10 py-8 border-y border-gray-50">
                <div class="transition-all hover:translate-x-1">
                  <p class="text-[10px] font-black text-gray-300 uppercase mb-2">Size</p>
                  <p class="text-sm font-black text-gray-900"><%= order.size || 'STANDARD' %></p>
                </div>
                <div class="transition-all hover:translate-x-1">
                  <p class="text-[10px] font-black text-gray-300 uppercase mb-2">Qty</p>
                  <p class="text-sm font-black text-gray-900"><%= order.quantity %> Units</p>
                </div>
                <div class="col-span-2 transition-all hover:translate-x-1">
                  <p class="text-[10px] font-black text-gray-300 uppercase mb-2">Address</p>
                  <p class="text-sm font-bold text-gray-500 truncate"><%= order.shippingAddress %></p>
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-8 pt-4">
                
                <div class="flex items-center gap-5">
                  <% if ((order.status === 'shipped' || order.status === 'out_for_delivery') && order.deliveryOtp) { %>
                    <div class="flex items-center gap-3 bg-red-600 text-white px-6 py-3 rounded-2xl shadow-xl shadow-red-100 animate-pulse">
                      <span class="text-[10px] font-black opacity-70">OTP</span>
                      <span class="text-2xl font-black tracking-[0.3em]"><%= order.deliveryOtp %></span>
                    </div>
                  <% } %>

                  <div class="flex items-center gap-2 px-5 py-2.5 rounded-full border border-gray-100 hover:bg-gray-50 transition-colors">
                    <span class="w-2 h-2 rounded-full <%= order.paymentStatus === 'completed' ? 'bg-emerald-500' : 'bg-amber-400 animate-bounce' %>"></span>
                    <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest"><%= order.paymentStatus %></span>
                  </div>
                </div>

                <div class="flex items-center gap-4">
                  <% if (['pending', 'confirmed'].includes(order.status)) { %>
                    <form action="/orders/<%= order._id %>/cancel" method="POST">
                      <button class="text-xs font-black text-gray-300 hover:text-red-600 transition-all uppercase tracking-widest px-4" onclick="return confirm('Cancel Order?')">Cancel</button>
                    </form>
                  <% } %>
                  
                  <a href="/orders/<%= order._id %>" class="btn-premium h-16 px-10 rounded-2xl bg-white border-2 border-gray-900 text-gray-900 font-black text-sm flex items-center shadow-sm">Details</a>
                  
                  <% if (order.deliveryBoyId || ['shipped', 'delivered'].includes(order.status)) { %>
                    <a href="/orders/<%= order._id %>/tracking" class="btn-premium h-16 px-10 rounded-2xl bg-red-600 text-white font-black text-sm flex items-center shadow-lg shadow-red-100">Track Now</a>
                  <% } %>
                </div>

              </div>
            </div>
          </div>
        <% }) %>
      </div>

    <% } else { %>
      <div class="text-center py-40 bg-white border border-dashed border-gray-100 rounded-[4rem]" data-aos="zoom-in">
        <h2 class="text-5xl font-black text-gray-100 uppercase tracking-tighter italic mb-8">No Orders</h2>
        <a href="/products" class="px-12 py-5 bg-gray-900 text-white font-black rounded-2xl hover:bg-red-600 transition-all inline-block shadow-2xl">Shop Collection</a>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    // Initialize animations with smooth duration
    AOS.init({
      duration: 1000,
      once: true,
      easing: 'ease-out-back'
    });
  </script>
</body>
</html>