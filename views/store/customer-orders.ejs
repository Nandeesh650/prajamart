<%- include('../partials/head') %>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
  body { background: #f8fafc; }

  .order-card { transition: all 0.4s ease; }
  .order-card:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.08); }

  .btn-hover { transition: all 0.3s ease; }
  .btn-hover:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.1); }

  .progress-bar { height: 6px; border-radius: 3px; background-color: #e5e7eb; overflow: hidden; margin-top: 8px; }
  .progress-bar-fill { height: 100%; transition: width 0.4s ease; background-color: #3b82f6; }
</style>

<body class="min-h-screen bg-gray-50 text-gray-900">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-12">

    <!-- Heading -->
    <div class="mb-12">
      <h1 class="text-5xl font-black text-gray-900">Your Orders</h1>
      <p class="text-gray-400 mt-2">Order history & live tracking</p>
    </div>

    <% if (orders && orders.length > 0) { %>
      <div class="space-y-10">
        <% orders.forEach(order => { %>
          <div class="order-card bg-white rounded-3xl p-8 shadow-md" data-aos="fade-up">

            <!-- Top Info -->
            <div class="flex flex-wrap justify-between items-center mb-6 border-b pb-6">
              <div>
                <p class="text-sm text-gray-400">Order ID</p>
                <p class="font-bold text-lg">#<%= order._id.toString().slice(-8).toUpperCase() %></p>
              </div>

              <div>
                <p class="text-sm text-gray-400">Date</p>
                <p class="font-bold"><%= new Date(order.orderDate).toLocaleDateString('en-IN') %></p>
              </div>

              <div>
                <p class="text-sm text-gray-400">Status</p>
                <p class="font-bold text-indigo-600 uppercase"><%= order.status.replace(/_/g, " ") %></p>
              </div>

              <div>
                <p class="text-sm text-gray-400">Total</p>
                <p class="text-2xl font-black text-red-600">₹<%= Number(order.totalPrice).toLocaleString('en-IN') %></p>
              </div>
            </div>

            <!-- Progress Tracker -->
            <div class="mb-6">
              <div class="flex items-center justify-between text-xs font-bold text-gray-500 uppercase mb-1">
                <span>Pending</span>
                <span>Confirmed</span>
                <span>Shipped</span>
                <span>Ready To Deliver</span>
                <span>Delivered</span>
              </div>
              <div class="progress-bar">
                <div class="progress-bar-fill"
                  style="width: <%= order.status === 'pending' ? 25 : order.status === 'confirmed' ? 50 : order.status === 'shipped' ? 75 : order.status === 'ready_to_deliver' ? 85 : 100 %>%;"></div>
              </div>
            </div>

            <!-- Items -->
            <div class="space-y-6">
              <% if (order.items && order.items.length > 0) { %>
                <% order.items.forEach(item => { %>
                  <div class="flex flex-col md:flex-row gap-6 border rounded-2xl p-5">

                    <!-- Product Image -->
                    <div class="w-full md:w-40 h-40 bg-gray-100 rounded-2xl overflow-hidden">
                      <img src="<%= item.productId?.photo || '/images/no-image.png' %>" alt="Product"
                        class="w-full h-full object-cover">
                    </div>

                    <!-- Product Details -->
                    <div class="flex-1">
                      <h2 class="text-2xl font-bold text-gray-900 mb-3"><%= item.productId?.productName || 'Product Not Found' %></h2>

                      <div class="grid grid-cols-2 gap-4 text-sm">
                        <div>
                          <p class="text-gray-400">Size</p>
                          <p class="font-bold"><%= item.size || 'N/A' %></p>
                        </div>
                        <div>
                          <p class="text-gray-400">Quantity</p>
                          <p class="font-bold"><%= item.quantity || 1 %></p>
                        </div>
                        <div>
                          <p class="text-gray-400">Price</p>
                          <p class="font-bold">₹<%= Number(item.price || 0).toLocaleString('en-IN') %></p>
                        </div>
                        <div>
                          <p class="text-gray-400">Subtotal</p>
                          <p class="font-bold text-indigo-600">₹<%= Number(item.subtotal || 0).toLocaleString('en-IN') %></p>
                        </div>
                      </div>

                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="text-center text-gray-400 py-6">No items provided for this order.</p>
              <% } %>
            </div>

            <!-- Buttons -->
            <div class="mt-8 flex flex-wrap gap-4 justify-end">
              <% if (['pending', 'confirmed'].includes(order.status)) { %>
                <form action="/orders/<%= order._id %>/cancel" method="POST">
                  <button type="submit" class="px-6 py-3 rounded-xl bg-red-100 text-red-600 font-bold btn-hover"
                    onclick="return confirm('Cancel this order?')">Cancel Order</button>
                </form>
              <% } %>
              <a href="/orders/<%= order._id %>" class="px-6 py-3 rounded-xl bg-gray-900 text-white font-bold btn-hover">View Details</a>
              <% if (order.status === 'ready_to_deliver') { %>
                <a href="/orders/<%= order._id %>/tracking" class="px-6 py-3 rounded-xl bg-indigo-600 text-white font-bold btn-hover">Track Order</a>
              <% } %>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-32">
        <h2 class="text-4xl font-black text-gray-300">No Orders Yet</h2>
        <a href="/products" class="inline-block mt-6 px-8 py-4 bg-red-600 text-white rounded-2xl font-bold btn-hover">
          Start Shopping
        </a>
      </div>
    <% } %>

  </main>

  <%- include('../partials/footer') %>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({ duration: 1000, once: true });
  </script>
</body>
</html>
