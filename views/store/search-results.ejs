<%- include('../partials/head') %>
  <!-- AOS CSS -->
  <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
</head>

<body class="bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">

  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-32">

    <!-- Heading -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-gray-800 mb-2">
         Search Results
      </h1>
      <% if (searchQuery) { %>
        <p class="text-gray-500 text-lg">
          Showing premium matches for "<span class="font-semibold text-gray-700"><%= searchQuery %></span>"
        </p>
      <% } else { %>
        <p class="text-gray-500 text-lg">
          Start searching for products
        </p>
      <% } %>
    </div>

    <form action="/search" method="GET" class="max-w-5xl mx-auto mb-10 bg-white/80 rounded-3xl shadow-lg p-5 md:p-6">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr_auto]">
        <input
          type="text"
          name="query"
          value="<%= searchQuery || '' %>"
          placeholder="Search product name or keyword"
          class="w-full rounded-2xl border border-gray-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
        >
        <select
          name="location"
          class="w-full rounded-2xl border border-gray-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-red-500"
        >
          <option value="">All locations</option>
          <% locationOptions.forEach(function(locationOption) { %>
            <option value="<%= locationOption %>" <%= selectedLocation === locationOption ? 'selected' : '' %>>
              <%= locationOption %>
            </option>
          <% }) %>
        </select>
        <button
          type="submit"
          class="rounded-2xl bg-gradient-to-r from-orange-400 to-red-500 px-6 py-3 font-semibold text-white transition duration-300 hover:shadow-lg"
        >
          Search
        </button>
      </div>
    </form>

    <% if (searchResults && searchResults.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">

        <% searchResults.forEach(product => { %>

          <div data-aos="fade-up" data-aos-delay="100" 
               class="group bg-white/50 backdrop-blur-lg border border-white/30 rounded-2xl 
                      shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 overflow-hidden">

            <!-- Product Image -->
            <div class="h-60 flex items-center justify-center p-4">
              <% if (product.photo) { %>
                <img src="/<%= product.photo %>" 
                     alt="<%= product.productName %>" 
                     class="h-full object-contain transition-transform duration-700 group-hover:scale-110 group-hover:-rotate-1">
              <% } else { %>
                <div class="w-full h-full bg-gray-200 flex items-center justify-center">
                  <span class="text-gray-400">No Image</span>
                </div>
              <% } %>
            </div>

            <!-- Content -->
            <div class="p-5 text-center">
              <h2 class="text-lg font-semibold text-gray-800 truncate">
                <%= product.productName %>
              </h2>

              <p class="mt-1 text-sm text-gray-500">
                <%= product.location || 'Location not set' %>
              </p>

              <!-- Price -->
              <p class="mt-2 text-2xl font-bold bg-gradient-to-r from-orange-400 to-red-500 
                        bg-clip-text text-transparent">
                ₹ <%= Number(product.price).toFixed(2) %>
              </p>

              <!-- Rating -->
              <% let stars = product.rating?.stars || 0; %>
              <div class="flex justify-center mt-2 text-yellow-400 text-lg">
                <% for (let i=1; i<=5; i++) { %>
                  <span><%= i <= stars ? '★' : '☆' %></span>
                <% } %>
              </div>
              <p class="text-gray-400 text-sm mt-1">
                (<%= product.rating?.count || 0 %> reviews)
              </p>

              <!-- Buttons -->
              <div class="flex gap-3 mt-5">

                <!-- Add to Cart -->
                <% if (isLoggedIn && user && user.userType === 'guest') { %>
                  <form action="/cart" method="POST" class="flex-1">
                    <input type="hidden" name="id" value="<%= product._id %>">
                    <button type="submit" 
                      class="w-full bg-gradient-to-r from-orange-400 to-red-500 text-white 
                             py-2.5 rounded-xl font-semibold shadow-md 
                             hover:shadow-lg hover:scale-105 transition-all duration-300">
                      Add to Cart
                    </button>
                  </form>
                <% } %>

                <!-- View Details -->
                <a href="/products/<%= product._id %>" 
                   class="flex-1 text-center py-2.5 rounded-xl bg-gray-100 font-medium 
                          text-gray-700 hover:bg-gray-200 hover:shadow-md transition-all duration-300">
                  View
                </a>

              </div>
            </div>

          </div>

        <% }); %>

      </div>
    <% } else if (searchQuery || selectedLocation) { %>

      <!-- No Results -->
      <div class="text-center py-16">
        <h2 class="text-2xl font-semibold text-gray-700 mb-3">
          No Premium Products Found
        </h2>
        <p class="text-gray-500 mb-6">
          Try different keywords to find what you’re looking for
        </p>
        <a href="/products" 
           class="inline-block bg-gradient-to-r from-orange-400 to-red-500 text-white 
                  px-6 py-3 rounded-xl shadow-md hover:shadow-lg hover:scale-105 transition">
          Browse All Products
        </a>
      </div>

    <% } %>

  </main>

  <!-- AOS JS -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>
    AOS.init({
      duration: 800,
      easing: 'ease-in-out',
      once: true,
    });
  </script>

</body>
</html>
