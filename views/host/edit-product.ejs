<%- include('../partials/head') %>
</head>
<body class="min-h-screen bg-gradient-to-br from-red-100 via-white to-red-50">

  <%- include('../partials/nav') %>

  <main class="max-w-5xl mx-auto px-4 py-10">
    <div class="relative overflow-hidden rounded-[2rem] bg-white/90 backdrop-blur-lg shadow-2xl border border-red-100">
      
      <!-- Top Gradient Banner -->
      <div class="bg-gradient-to-r from-red-600 via-red-500 to-red-700 px-8 py-8">
        <h1 class="text-4xl font-bold text-white tracking-wide">
          <%= editing ? "Edit Product" : "Register Product" %>
        </h1>
        <p class="text-red-100 mt-2 text-sm">
          Add your product details with a premium seller experience
        </p>
      </div>

      <!-- Form Section -->
      <div class="p-8 md:p-10">
        <form
          action="/host/<%= editing ? 'edit-product' : 'add-product' %>"
          method="POST"
          enctype="multipart/form-data"
          class="grid grid-cols-1 md:grid-cols-2 gap-6"
        >
          <input type="hidden" name="id" value="<%= editing ? product._id : '' %>" />

          <!-- Product Name -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Product Name
            </label>
            <input
              type="text"
              name="productName"
              value="<%= editing ? product.productName : '' %>"
              placeholder="Enter product name"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
            />
          </div>

          <!-- Search Key -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Search Key
            </label>
            <input
              type="text"
              name="key"
              value="<%= editing ? product.key : '' %>"
              placeholder="electronics, shoes, furniture"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
            />
          </div>

          <!-- Location -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Location
            </label>
            <select
              name="location"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
            >
              <option value="">Select location</option>
              <% locationOptions.forEach(function(locationOption) { %>
                <option
                  value="<%= locationOption %>"
                  <%= editing && product && product.location === locationOption ? 'selected' : '' %>
                >
                  <%= locationOption %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Price -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Price
            </label>
            <input
              type="text"
              name="price"
              value="<%= editing ? product.price : '' %>"
              placeholder="₹ Enter product price"
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
            />
          </div>

          <!-- Upload Image -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Product Image
            </label>
            <div class="border-2 border-dashed border-red-200 rounded-2xl p-6 bg-red-50 hover:bg-red-100 transition duration-300">
              <input
                type="file"
                name="photo"
                accept="image/jpg, image/jpeg, image/png"
                class="w-full cursor-pointer"
              />
            </div>
          </div>

          <!-- Description -->
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Description
            </label>
            <textarea
              name="description"
              rows="6"
              placeholder="Write a premium product description..."
              class="w-full px-5 py-4 rounded-2xl border border-gray-200 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none shadow-sm transition duration-300"
            ><%= editing ? product.description : '' %></textarea>
          </div>

          <!-- Button -->
          <div class="md:col-span-2">
            <button
              type="submit"
              class="w-full py-4 rounded-2xl bg-gradient-to-r from-red-600 to-red-500 text-white font-bold text-lg shadow-xl hover:shadow-2xl hover:scale-[1.01] transition duration-300"
            >
              <%= editing ? "Update Product" : "Add Product" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

</body>
</html>
