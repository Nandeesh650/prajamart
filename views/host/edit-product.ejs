<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-6 text-center text-gray-800"><%= editing ? "Edit" : "Register"%> Your Product on Prajamart</h1>
      <form action="/host/<%= editing ? "edit-product" : "add-product"%>" method="POST" enctype="multipart/form-data" class="max-w-md mx-auto">
        <input type="hidden" name="id" value="<%= editing ? product._id : ''%>" />
        <input
          type="text"
          name="productName"
          value="<%= editing ? product.productName : ''%>"
          placeholder="Enter your Product Name"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="text"
          name="key"
          value="<%= editing ? product.key : ''%>"
          placeholder="Enter search key and Name of the Product (e.g. electronics, furniture)"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <input
          type="text"
          name="price"
          value="<%= editing ? product.price : ''%>"
          placeholder="Product Price"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <div class="mb-4">
          <label class="block text-gray-700 font-semibold mb-2">Rating Stars (0-5)</label>
          <input
            type="number"
            name="rating_stars"
            min="0"
            max="5"
            step="0.1"
            value="<%= editing && product.rating ? product.rating.stars : ''%>"
            placeholder="Enter rating stars"
            class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        </div>
        <div class="mb-4">
          <label class="block text-gray-700 font-semibold mb-2">Rating Count</label>
          <input
            type="number"
            name="rating_count"
            min="0"
            value="<%= editing && product.rating ? product.rating.count : ''%>"
            placeholder="Enter number of ratings"
            class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        </div>
        <input
          type="file"
          name="photo"
          accept="image/jpg, image/jpeg, image/png"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"/>
        <textarea
          name="description"
          placeholder="Describe your product"
          class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"><%= editing ? product.description : ''%></textarea>
        <input type="submit" value="<%= editing ? "Update Product" : "Add Product"%>" class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300" />
      </form>
    </main>
  </body>
</html>
