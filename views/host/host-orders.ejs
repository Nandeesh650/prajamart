<%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="px-6 py-10 bg-gradient-to-br from-gray-100 via-white to-gray-200 min-h-screen">
    
    <!-- HEADING -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-gray-800 tracking-wide">
        Incoming Orders
      </h1>
      <p class="text-gray-500 mt-2 text-lg">
        Manage and process customer orders
      </p>
    </div>

    <!-- MESSAGES -->
    <div class="max-w-6xl mx-auto mb-6">
      <% if (success) { %>
        <div class="p-4 rounded-lg bg-green-100 text-green-800 border border-green-300">
          <%= success %>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="p-4 rounded-lg bg-red-100 text-red-800 border border-red-300">
          <%= error %>
        </div>
      <% } %>
    </div>

    <!-- ORDERS LIST -->
    <div class="max-w-6xl mx-auto">
      <% if (orders && orders.length > 0) { %>
        
        <div class="space-y-6">
          <% orders.forEach(order => { %>
            <div class="bg-white rounded-xl shadow-md hover:shadow-lg transition-shadow p-6 border-l-4 border-green-500">
              
              <!-- Order Header -->
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-xl font-bold text-gray-800">
                    <%= order.productId.productName %>
                  </h3>
                  <p class="text-sm text-gray-600 mt-1">
                    Order ID: <%= order._id %>
                  </p>
                </div>
                <span class="px-4 py-2 rounded-full text-sm font-semibold
                  <% if (order.status === 'pending') { %>
                    bg-yellow-100 text-yellow-800
                  <% } else if (order.status === 'confirmed') { %>
                    bg-blue-100 text-blue-800
                  <% } else if (order.status === 'shipped') { %>
                    bg-purple-100 text-purple-800
                  <% } else if (order.status === 'delivered') { %>
                    bg-green-100 text-green-800
                  <% } else if (order.status === 'cancelled') { %>
                    bg-red-100 text-red-800
                  <% } %>
                ">
                  <%= order.status.toUpperCase() %>
                </span>
              </div>

              <!-- Order Details -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Quantity</p>
                  <p class="text-lg font-bold text-gray-800"><%= order.quantity %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Total Price</p>
                  <p class="text-lg font-bold text-green-600">₹<%= order.totalPrice %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Customer</p>
                  <p class="text-lg font-bold text-gray-800"><%= order.userId.firstName %></p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase font-semibold">Order Date</p>
                  <p class="text-lg font-bold text-gray-800">
                    <%= new Date(order.orderDate).toLocaleDateString() %>
                  </p>
                </div>
              </div>

              <!-- Customer Info -->
              <div class="mb-4 pb-4 border-b border-gray-200">
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-semibold">Customer Email</p>
                    <p class="text-gray-700"><%= order.userId.email %></p>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 uppercase font-semibold">Shipping Address</p>
                    <p class="text-gray-700"><%= order.shippingAddress %></p>
                  </div>
                </div>
              </div>

              <!-- Payment Information -->
              <div class="mb-4 pb-4 border-b border-gray-200 bg-blue-50 p-3 rounded-lg">
                <p class="text-xs text-gray-500 uppercase font-semibold mb-2">💳 Payment Method</p>
                <div class="flex justify-between items-center">
                  <div>
                    <% if (order.paymentMethod === 'cod') { %>
                      <p class="font-semibold text-gray-800">💵 Cash on Delivery (COD)</p>
                      <p class="text-sm text-gray-600">Customer will pay on delivery</p>
                    <% } else if (order.paymentMethod === 'upi') { %>
                      <p class="font-semibold text-gray-800">📱 UPI</p>
                      <p class="text-sm text-gray-600">Payment made via UPI</p>
                    <% } else if (order.paymentMethod === 'debit_card') { %>
                      <p class="font-semibold text-gray-800">🏧 Debit Card</p>
                      <p class="text-sm text-gray-600">Payment made via Debit Card</p>
                    <% } %>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-semibold
                    <% if (order.paymentStatus === 'completed') { %>
                      bg-green-200 text-green-800
                    <% } else if (order.paymentStatus === 'failed') { %>
                      bg-red-200 text-red-800
                    <% } else { %>
                      bg-yellow-200 text-yellow-800
                    <% } %>
                  ">
                    <%= order.paymentStatus.toUpperCase() %>
                  </span>
                </div>
              </div>

              <!-- Status Update -->
              <div class="mb-4">
                <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Update Order Status</p>
                <form action="/host/orders/<%= order._id %>/status" method="POST" class="flex gap-2">
                  <select name="status" class="flex-1 px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-green-500">
                    <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                    <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Shipped</option>
                    <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                    <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  </select>
                  <button type="submit" class="px-4 py-2 rounded-lg bg-green-500 text-white hover:bg-green-600 transition font-medium">
                    Update
                  </button>
                </form>
              </div>

              <!-- Customer Rating -->
              <% if (order.userRating && order.userRating.stars > 0) { %>
                <div class="mb-4 pb-4 border-b border-gray-200 bg-yellow-50 p-3 rounded-lg">
                  <p class="text-xs text-gray-500 uppercase font-semibold mb-2">Customer Rating ⭐</p>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-2xl">
                      <% for (let i = 0; i < 5; i++) { %>
                        <% if (i < order.userRating.stars) { %>
                          ⭐
                        <% } else { %>
                          ☆
                        <% } %>
                      <% } %>
                    </span>
                    <span class="font-semibold text-gray-800"><%= order.userRating.stars %>/5</span>
                  </div>
                  <% if (order.userRating.comment) { %>
                    <p class="text-sm text-gray-700 italic bg-white p-2 rounded">"<%= order.userRating.comment %>"</p>
                  <% } %>
                </div>
              <% } %>

              <!-- Notes -->
              <% if (order.notes) { %>
                <div class="pb-4 border-b border-gray-200">
                  <p class="text-xs text-gray-500 uppercase font-semibold">Customer Notes</p>
                  <p class="text-gray-700"><%= order.notes %></p>
                </div>
              <% } %>

              <!-- Actions -->
              <div class="flex gap-3">
                <a href="/orders/<%= order._id %>" class="px-4 py-2 rounded-lg bg-blue-500 text-white hover:bg-blue-600 transition font-medium">
                  View Details
                </a>
                <form action="/host/orders/<%= order._id %>/delete" method="POST" style="display: inline;">
                  <button type="submit" class="px-4 py-2 rounded-lg bg-red-500 text-white hover:bg-red-600 transition font-medium" onclick="return confirm('Are you sure you want to delete this order? This action cannot be undone.');">
                    Delete Order
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        </div>

      <% } else { %>

        <div class="text-center py-20">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16 mx-auto text-gray-400 mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .984.595 1.83 1.45 2.112m5.451-5.112m0 0A2.251 2.251 0 0013.81 2H9.19C8.358 2 7.5 2.75 7.5 3.972c0 .368.099.716.273 1.025m8.854 0H7.25" />
          </svg>
          <p class="text-gray-500 text-xl">
            No orders received yet
          </p>
          <a href="/host/host-product-list" class="mt-4 inline-block px-6 py-2 rounded-lg bg-green-600 text-white hover:bg-green-700 transition font-medium">
            Back to Products
          </a>
        </div>

      <% } %>
    </div>

  </main>

  <%- include('../partials/footer') %>
</body>
</html>
