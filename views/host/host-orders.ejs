<%- include('../partials/head') %>
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
  .order-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid rgba(0,0,0,0.05); }
  .order-card:hover { transform: translateY(-5px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
  @keyframes status-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
  .pulse-status { animation: status-blink 2s infinite ease-in-out; }
</style>
</head>
<body>
<%- include('../partials/nav') %>

<main class="px-6 py-10 bg-gradient-to-br from-slate-100 via-white to-slate-200 min-h-screen">
  
  <div class="text-center mb-12" data-aos="fade-down">
    <h1 class="text-5xl font-extrabold text-slate-900 tracking-tight">Incoming <span class="text-green-600">Orders</span></h1>
    <p class="text-slate-500 mt-3 text-lg font-medium">Manage multi-item orders and real-time processing</p>
  </div>

  <div class="max-w-6xl mx-auto mb-6">
    <% if (success) { %>
      <div class="p-4 rounded-2xl bg-green-100 text-green-800 border border-green-200 shadow-sm mb-4" data-aos="fade-right">✅ <%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="p-4 rounded-2xl bg-red-100 text-red-800 border border-red-200 shadow-sm mb-4" data-aos="fade-right">⚠️ <%= error %></div>
    <% } %>
  </div>

  <div class="max-w-6xl mx-auto">
    <% if (orders && orders.length > 0) { %>
      <div class="space-y-8">
        <% orders.forEach((order, index) => { %>
          <div class="order-card bg-white rounded-3xl shadow-sm p-8 border-l-[6px] 
            <%= order.status === 'cancelled' ? 'border-red-500' : 'border-green-500' %>" 
            data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
            
            <div class="flex justify-between items-start mb-6">
              <div>
                <h3 class="text-2xl font-black text-slate-800 tracking-tight">Order #<%= order._id.toString().slice(-6).toUpperCase() %></h3>
                <p class="text-xs font-bold text-slate-400 mt-1 uppercase tracking-widest">ID: <%= order._id %></p>
              </div>
              
              <span class="px-5 py-2 rounded-xl text-xs font-black tracking-widest uppercase pulse-status
                <% if (order.status === 'pending') { %> bg-yellow-100 text-yellow-700 border border-yellow-200 
                <% } else if (order.status === 'confirmed') { %> bg-blue-100 text-blue-700 border border-blue-200
                <% } else if (order.status === 'ready_to_deliver') { %> bg-orange-100 text-orange-700 border border-orange-200
                <% } else if (order.status === 'delivered') { %> bg-green-100 text-green-700 border border-green-200
                <% } else if (order.status === 'cancelled') { %> bg-red-100 text-red-700 border border-red-200
                <% } else { %> bg-slate-100 text-slate-600 <% } %>">
                <%= order.status.replace(/_/g, ' ') %>
              </span>
            </div>

            <div class="space-y-3 mb-6">
              <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest px-1">Items Summary</p>
              <% order.items.forEach(item => { %>
                <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100">
                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center shadow-sm text-lg">📦</div>
                    <div>
                      <p class="font-bold text-slate-800"><%= item.productId ? item.productId.productName : 'Product Removed' %></p>
                      <p class="text-xs text-slate-500">Size: <%= item.size || 'N/A' %> | Qty: <%= item.quantity %></p>
                    </div>
                  </div>
                  <div class="text-right">
                    <p class="font-bold text-slate-800">₹<%= item.subtotal %></p>
                  </div>
                </div>
              <% }) %>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6 p-5 bg-slate-50 rounded-2xl border border-slate-100">
              <div>
                <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest">Total Bill</p>
                <p class="text-xl font-black text-green-600">₹<%= order.totalPrice %></p>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest">Customer</p>
                <p class="text-lg font-bold text-slate-800"><%= order.userId ? order.userId.firstName : 'Guest' %></p>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest">Date</p>
                <p class="text-lg font-bold text-slate-800"><%= new Date(order.orderDate).toLocaleDateString() %></p>
              </div>
              <div>
                <p class="text-[10px] text-slate-400 uppercase font-black tracking-widest">Payment</p>
                <p class="text-lg font-bold text-blue-600 uppercase text-sm"><%= order.paymentMethod %></p>
              </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex flex-wrap gap-4 items-center">
              <% if (order.status !== 'cancelled' && order.status !== 'delivered' && order.status !== 'returned') { %>
                <form action="/host/orders/<%= order._id %>/status" method="POST" class="flex gap-2 flex-grow max-w-md">
                  <select name="status" class="flex-1 px-4 py-2 rounded-xl border border-slate-200 bg-white text-sm font-bold text-slate-700 focus:ring-2 focus:ring-green-500 outline-none">
                    <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="confirmed" <%= order.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                    <option value="ready_to_deliver" <%= order.status === 'ready_to_deliver' ? 'selected' : '' %>>Ready for Pickup</option>
                  </select>
                  <button type="submit" class="px-6 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-green-600 transition-colors">Update</button>
                </form>
              <% } %>

              <div class="flex gap-3 ml-auto">
                <a href="/orders/<%= order._id %>" class="px-4 py-2 text-xs font-bold uppercase tracking-widest text-slate-600 hover:text-indigo-600 transition-colors">Details</a>
                <form action="/host/orders/<%= order._id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this order?')">
                  <button class="px-4 py-2 text-xs font-bold uppercase tracking-widest text-red-500 hover:bg-red-50 rounded-xl transition-colors">Delete</button>
                </form>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-20 bg-white rounded-3xl shadow-sm border border-slate-100">
        <p class="text-slate-400 text-xl font-bold">No orders found.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>AOS.init({ duration: 800, once: true });</script>
</body>
</html>