<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-br from-gray-50 via-white to-gray-100 min-h-screen">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-6 py-10">

    <!-- Page Header -->
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-bold text-gray-900 tracking-tight">
        Your Products
      </h1>
      <p class="text-gray-500 mt-2 text-lg">
        Manage and update your premium collection
      </p>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% registeredProducts.forEach(function(product) { %>

        <div class="group relative bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-3">

          <!-- Product Image -->
          <div class="relative overflow-hidden h-72">
            <img
              src="/<%= product.photo %>"
              alt="<%= product.productName %>"
              class="w-full h-full object-cover transition duration-700 group-hover:scale-110"
            >

            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent"></div>

            <!-- Price -->
            <div class="absolute top-4 right-4 bg-white px-4 py-2 rounded-2xl shadow-lg">
              <span class="text-red-600 text-xl font-bold">
                ₹<%= product.price %>
              </span>
            </div>

            <!-- Rating -->
            <div class="absolute bottom-4 left-4 bg-white px-4 py-2 rounded-2xl shadow-lg flex items-center gap-2">
              <span class="text-yellow-500">⭐</span>
              <span class="font-semibold text-gray-700">
                <%= product.rating && product.rating.stars !== undefined
                  ? product.rating.stars
                  : product.rating %>
              </span>
            </div>
          </div>

          <!-- Product Info -->
          <div class="p-6">
            <h2 class="text-2xl font-semibold text-gray-900 mb-2">
              <%= product.productName %>
            </h2>

            <p class="text-gray-500 text-sm mb-6">
              Premium quality product for your customers
            </p>

            <!-- Buttons -->
            <div class="flex gap-3">
              <a
                href="/host/edit-product/<%= product._id %>?editing=true"
                class="flex-1 text-center py-3 rounded-2xl bg-gray-900 text-white font-semibold hover:bg-black hover:scale-105 transition duration-300"
              >
                Edit
              </a>

              <form
                action="/host/delete-product/<%= product._id %>"
                method="POST"
                class="flex-1"
              >
                <button
                  type="submit"
                  class="w-full py-3 rounded-2xl bg-red-600 text-white font-semibold hover:bg-red-700 hover:scale-105 transition duration-300"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>

      <% }) %>
    </div>

  </main>
</body>
</html>
