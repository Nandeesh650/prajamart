<%- include('../partials/head') %>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<style>
  :root { --brand-indigo: #4f46e5; --brand-glow: rgba(79, 70, 229, 0.4); }
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #fcfcfd; overflow-x: hidden; }

  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  /* Image Container Specifics */
  .img-container {
    transition: all 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .product-card:hover .img-container {
    transform: scale(1.02);
  }
</style>

<body class="antialiased text-slate-900">
  <%- include('../partials/nav') %>

  <main class="max-w-[1536px] mx-auto px-6 py-20 lg:px-12">

    <div class="mb-20 text-center" data-aos="fade-down">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="h-[2px] w-8 bg-indigo-600"></span>
        <p class="text-indigo-600 font-black uppercase tracking-[0.3em] text-[10px]">Merchant Panel</p>
      </div>
      <h1 class="text-6xl md:text-8xl font-[900] text-slate-950 tracking-tighter leading-none mb-4">
        Inventory <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-500">Archive.</span>
      </h1>
      <p class="text-slate-500 font-bold uppercase tracking-widest text-xs">
        Curate and update your premium collection
      </p>
    </div>

    <section class="max-w-5xl mx-auto mb-10" data-aos="fade-up">
      <form action="/host/host-product-list" method="GET" class="glass-card rounded-[2.5rem] border border-white/50 p-4 shadow-xl">
        <div class="flex flex-col gap-3 md:flex-row md:items-center">
          <div class="flex-1">
            <input
              type="text"
              name="query"
              value="<%= searchQuery || '' %>"
              placeholder="Search your products by name, tag, location, or description"
              class="w-full rounded-2xl bg-white px-6 py-4 text-sm font-bold text-slate-800 outline-none"
            >
          </div>
          <div class="flex gap-2">
            <button type="submit" class="rounded-2xl bg-slate-950 px-6 py-4 text-[10px] font-black uppercase tracking-widest text-white transition-colors hover:bg-indigo-600">
              Search
            </button>
            <% if (searchQuery) { %>
              <a href="/host/host-product-list" class="rounded-2xl bg-slate-100 px-6 py-4 text-[10px] font-black uppercase tracking-widest text-slate-700 transition-colors hover:bg-slate-200">
                Clear
              </a>
            <% } %>
          </div>
        </div>
      </form>
    </section>

    <div class="grid grid-cols-1 gap-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      <% if (registeredProducts && registeredProducts.length > 0) { %>
        <% if (searchQuery) { %>
          <div class="col-span-full mb-2">
            <p class="text-center text-[10px] font-black uppercase tracking-widest text-slate-500">
              Search results for "<%= searchQuery %>"
            </p>
          </div>
        <% } %>
        <% registeredProducts.forEach(function(product, index) { %>
          
          <div data-aos="fade-up" data-aos-delay="<%= 300 + (index * 75) %>">
            <div class="product-card group relative flex flex-col bg-white rounded-[3.5rem] p-6 shadow-sm hover:shadow-2xl hover:-translate-y-6 transition-all duration-700">

              <div class="img-container relative aspect-[2/3] overflow-hidden rounded-[2.8rem] bg-slate-50 border border-slate-100/30 shadow-inner">
                <img
                  src="/<%= (product.photos && product.photos.length > 0) ? product.photos[0] : (product.photo || 'images/placeholder.jpg') %>"
                  alt="<%= product.productName %>"
                  class="w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-110"
                >

                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 to-transparent opacity-60"></div>

                <div class="absolute top-6 right-6 glass-card px-5 py-2.5 rounded-full shadow-lg border border-white/50">
                  <span class="text-indigo-600 text-2xl font-[900] tracking-tighter">
                    ₹<%= product.price.toLocaleString('en-IN') %>
                  </span>
                </div>

                <div class="absolute bottom-6 left-6 glass-card px-4 py-2 rounded-xl shadow-lg flex items-center gap-2 border border-white/50">
                  <span class="text-yellow-500 text-xs">⭐</span>
                  <span class="font-bold text-slate-800 text-xs">
                    <%= product.rating && product.rating.stars !== undefined ? product.rating.stars : (product.rating || '5.0') %>
                  </span>
                </div>
              </div>

              <div class="pt-12 pb-6 px-4 flex flex-col flex-grow">
                <h2 class="font-[800] text-3xl text-slate-950 tracking-tighter mb-14 leading-tight group-hover:text-indigo-600 transition-colors">
                  <%= product.productName %>
                </h2>

                <div class="mt-auto flex flex-col sm:flex-row gap-4 pt-8 border-t border-slate-100">
                  <a
                    href="/host/edit-product/<%= product._id %>?editing=true"
                    class="flex-1 text-center py-4 rounded-2xl bg-slate-950 text-white font-black text-[10px] uppercase tracking-widest hover:bg-indigo-600 active:scale-95 transition-all shadow-xl shadow-indigo-100"
                  >
                    Edit Asset
                  </a>

                  <form
                    action="/host/delete-product/<%= product._id %>"
                    method="POST"
                    class="flex-1"
                  >
                    <button
                      type="submit"
                      class="w-full py-4 rounded-2xl bg-white text-rose-600 font-black text-[10px] uppercase tracking-widest border border-rose-100 hover:bg-rose-600 hover:text-white transition-all active:scale-95 shadow-sm"
                      onclick="return confirm('Archive this item?')"
                    >
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>

        <% }) %>
      <% } else { %>
        <div class="col-span-full py-32 text-center" data-aos="fade-up">
            <h3 class="text-2xl font-black text-slate-300 uppercase tracking-widest">
              <%= searchQuery ? 'No Matching Products' : 'Inventory Manifest Empty' %>
            </h3>
            <p class="text-slate-400 mt-2">
              <%= searchQuery ? 'Try another search for your products.' : 'Begin deployment to see items here.' %>
            </p>
        </div>
      <% } %>
    </div>

  </main>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script>
    AOS.init({ 
      duration: 1200, 
      once: true, 
      easing: 'ease-out-quint' 
    });
  </script>
  <%- include('../partials/footer') %>
</body>
</html>
